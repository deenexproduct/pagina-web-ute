---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ecosistema from '../sections/Ecosistema.astro';
import UnidadesDeNegocio from '../sections/UnidadesDeNegocio.astro';
import Contacto from '../sections/Contacto.astro';
---

<BaseLayout
  title="Ecosistema"
  description="QUEM Central integra distintas unidades operativas y comerciales: distribución B2B, retail, franquicias, corners, logística especializada, tecnología y fraccionamiento."
>
  <header class="page-hero">
    <div class="container-content">
      <p class="eyebrow">Ecosistema QUEM Central</p>
      <h1>Un ecosistema diseñado para escalar alimentos congelados</h1>
      <p class="page-hero__lede">
        QUEM Central integra distintas unidades operativas y comerciales para llevar productos congelados a
        múltiples canales: negocios gastronómicos, comercios, consumidores finales, eventos, franquicias y corners.
      </p>
      <p class="page-hero__lede">
        Cada unidad cumple un rol dentro de una misma visión: construir una red eficiente, flexible y escalable
        para el mercado de alimentos congelados.
      </p>
    </div>
  </header>

  <Ecosistema showHead={false} />
  <UnidadesDeNegocio />
  <Contacto showHead={true} />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 6vw, 6rem) clamp(2rem, 4vw, 4rem);
    background: linear-gradient(180deg, var(--color-surface-subtle), var(--color-bg));
  }
  .page-hero h1 {
    font-size: var(--font-size-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tightest);
    line-height: 1.06;
    margin-block: var(--space-3) var(--space-4);
    max-width: 22ch;
  }
  .page-hero__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
    margin-block-end: var(--space-3);
  }
</style>
