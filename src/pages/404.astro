---
/**
 * 404 — Fase 1.
 *
 * Los atajos apuntan a los 5 anclas del spec. Los anteriores
 * (#quem-central, #corner-quem, #productos, #franquicias) ya no existen
 * en la home, así que llevaban al tope de la página en silencio.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV_PRIMARY, contactLink } from '../config/site';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const COPY = {
  es: {
    eyebrow: 'Error 404',
    titulo: 'Esa página',
    tituloEm: 'se congeló',
    lede: 'El enlace que abriste no existe o se movió. Acá tenés un par de caminos para seguir.',
    volver: 'Volver al inicio',
    atajos: 'Atajos de navegación',
    metaTitle: 'Página no encontrada',
    metaDesc: 'La página que buscás no existe. Volvé al inicio o escribinos.',
  },
  en: {
    eyebrow: 'Error 404',
    titulo: 'That page',
    tituloEm: 'went cold',
    lede: 'The link you opened does not exist or has moved. Here are a couple of ways forward.',
    volver: 'Back to home',
    atajos: 'Shortcuts',
    metaTitle: 'Page not found',
    metaDesc: 'The page you are looking for does not exist. Head back home or get in touch.',
  },
} as const;

const c = COPY[lang];
---

<BaseLayout title={c.metaTitle} description={c.metaDesc} noindex={true}>
  <section class="nf section-y" aria-labelledby="nf-title">
    <div class="nf__bg" aria-hidden="true"></div>

    <div class="container-content nf__inner">
      <p class="nf__eyebrow">
        <span class="nf__eyebrow-dot" aria-hidden="true"></span>
        {c.eyebrow}
      </p>

      <h1 id="nf-title" class="nf__title">
        {c.titulo}
        <em>{c.tituloEm}</em>.
      </h1>

      <p class="nf__lede">{c.lede}</p>

      <div class="nf__actions">
        <a class="btn btn-primary nf__cta-main" href={localizedPath('/', lang)}>
          {c.volver}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path
              d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn-outline" href={contactLink(undefined, lang)}>{t('cta.contacto')}</a>
      </div>

      <ul class="nf__shortcuts" aria-label={c.atajos}>
        {
          NAV_PRIMARY.map((item) => (
            <li>
              <a href={localizedPath(item.href.replace('/#', '/#'), lang)}>
                {t(`nav.${item.key}`)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    min-height: clamp(560px, 70vh, 760px);
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* Fondo tokenizado. Antes tenía oklch() literales del hue azul/verde
     que se abandonó en el rebrand — quedaban fuera de la paleta oliva. */
  .nf__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        45% 55% at 80% 10%,
        oklch(from var(--color-brand-500) l c h / 0.16) 0%,
        transparent 60%
      ),
      radial-gradient(
        40% 50% at 10% 90%,
        oklch(from var(--color-accent-500) l c h / 0.14) 0%,
        transparent 60%
      ),
      linear-gradient(180deg, var(--color-brand-tint) 0%, var(--color-bg) 100%);
  }
  .nf__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      oklch(from var(--color-brand-700) l c h / 0.07) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black 30%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black 30%, transparent 90%);
  }

  .nf__inner {
    display: grid;
    gap: var(--space-4);
    text-align: center;
    justify-items: center;
    max-width: 56ch;
  }

  .nf__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.85rem;
    background: oklch(from var(--color-brand-500) l c h / 0.08);
    color: var(--color-text-brand);
    border: 1px solid oklch(from var(--color-brand-500) l c h / 0.15);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
  }
  .nf__eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent-500);
    box-shadow: 0 0 0 4px oklch(from var(--color-accent-500) l c h / 0.2);
  }

  .nf__title {
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    line-height: 1;
    letter-spacing: var(--tracking-tightest);
    font-weight: var(--weight-extrabold);
    color: var(--color-text-primary);
    text-wrap: balance;
  }
  .nf__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nf__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
    max-width: 44ch;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-block-start: var(--space-3);
  }
  .nf__cta-main {
    padding-inline: 1.4rem;
    padding-block: 0.95rem;
    font-size: var(--font-size-sm);
    box-shadow: var(--shadow-glow-brand);
  }

  .nf__shortcuts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    justify-content: center;
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-5);
    border-top: 1px solid var(--color-border-subtle);
    width: 100%;
    max-width: 48ch;
  }
  .nf__shortcuts a {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-medium);
    border-bottom: 1.5px solid transparent;
    padding-block: 0.35rem;
    transition:
      color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .nf__shortcuts a:hover {
    color: var(--color-text-brand);
    border-color: var(--color-brand-500);
  }
</style>
