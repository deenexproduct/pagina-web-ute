---
import BaseLayout from '../layouts/BaseLayout.astro';
import UnidadesDeNegocio from '../sections/UnidadesDeNegocio.astro';
import FranquiciasExpansion from '../sections/FranquiciasExpansion.astro';
import Contacto from '../sections/Contacto.astro';
---

<BaseLayout
  title="Unidades de negocio"
  description="Distribución B2B, franquicias, Corner QUEM, logística, retail B2C, tecnología, fraccionamiento, desarrolladora comercial y representación de marcas. Las líneas operativas de QUEM Central."
>
  <header class="page-hero">
    <div class="container-content">
      <p class="eyebrow">Unidades de negocio</p>
      <h1>Una compañía organizada por unidades comerciales</h1>
      <p class="page-hero__lede">
        QUEM Central opera sobre distintas líneas comerciales que permiten abastecer, distribuir, representar
        y escalar productos congelados en múltiples canales.
      </p>
    </div>
  </header>

  <UnidadesDeNegocio showHead={false} />
  <FranquiciasExpansion />
  <Contacto />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 6vw, 6rem) clamp(2rem, 4vw, 4rem);
    background: linear-gradient(180deg, var(--color-surface-subtle), var(--color-bg));
  }
  .page-hero h1 {
    font-size: var(--font-size-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tightest);
    line-height: 1.06;
    margin-block: var(--space-3) var(--space-4);
    max-width: 24ch;
  }
  .page-hero__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
  }
</style>
