---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoriasProducto from '../sections/CategoriasProducto.astro';
import PlataformaApp from '../sections/PlataformaApp.astro';
import Contacto from '../sections/Contacto.astro';
---

<BaseLayout
  title="Productos"
  description="Explorá las principales líneas de alimentos congelados de QUEM Central: empanadas, hamburguesas, pizzas, postres, frutas, Franui y más. Comprá online desde el catálogo digital."
>
  <header class="page-hero">
    <div class="container-content">
      <p class="eyebrow">Categorías de productos</p>
      <h1>Explorá nuestras principales líneas de alimentos congelados</h1>
      <p class="page-hero__lede">
        Categorías curadas para operaciones gastronómicas, comercios y compradores B2B. Cada categoría linkea
        directo a la app, donde podés ver disponibilidad y comprar online.
      </p>
    </div>
  </header>

  <CategoriasProducto showHead={false} />
  <PlataformaApp />
  <Contacto showHead={true} defaultTipo="Compra B2B" />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 6vw, 6rem) clamp(2rem, 4vw, 4rem);
    background: linear-gradient(180deg, var(--color-surface-subtle), var(--color-bg));
  }
  .page-hero h1 {
    font-size: var(--font-size-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tightest);
    line-height: 1.06;
    margin-block: var(--space-3) var(--space-4);
    max-width: 24ch;
  }
  .page-hero__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
  }
</style>
