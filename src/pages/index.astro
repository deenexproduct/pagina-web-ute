---
/**
 * Landing page única de QUEM Central.
 *
 * Modo single-page: el header nav (definido en `src/config/site.ts`)
 * usa anchors a los `id` de cada `<section>`. El scroll-spy en
 * `components/layout/Header.astro` ilumina el item visible.
 *
 * Orden: respeta el brief original (12 puntos).
 * Corner QÜEM: teaser compacto en home → detalle en /corner-quem.
 *
 * IDs canónicos (NO renombrar sin actualizar NAV_PRIMARY):
 *   #quem-central · #ecosistema · #corner-quem
 *   #productos · #franquicias · #prensa · #contacto
 */
import BaseLayout from '../layouts/BaseLayout.astro';

/* Secciones principales (orden brief) */
import HeroCorporativo from '../sections/HeroCorporativo.astro';
import ProofStrip from '../sections/ProofStrip.astro';
import QueEsQuemCentral from '../sections/QueEsQuemCentral.astro';
import Ecosistema from '../sections/Ecosistema.astro';

/* Corner QÜEM — teaser home, detalle en /corner-quem */
import CornerTeaser from '../sections/corner/CornerTeaser.astro';

import CategoriasProducto from '../sections/CategoriasProducto.astro';
import PlataformaApp from '../sections/PlataformaApp.astro';
import FranquiciasExpansion from '../sections/FranquiciasExpansion.astro';
import QuemEnNumeros from '../sections/QuemEnNumeros.astro';
import EquipoDirectivo from '../sections/EquipoDirectivo.astro';
import PrensaList from '../sections/prensa/PrensaList.astro';
import Contacto from '../sections/Contacto.astro';
---

<BaseLayout>
  <span id="top" class="sr-only" aria-hidden="true"></span>

  <HeroCorporativo />
  <ProofStrip />
  <QueEsQuemCentral />
  <Ecosistema />

  <!-- Corner QÜEM: teaser compacto en home. El id="corner-quem" vive en CornerTeaser. -->
  <CornerTeaser />

  <CategoriasProducto />
  <PlataformaApp />
  <FranquiciasExpansion />
  <QuemEnNumeros />
  <EquipoDirectivo />

  <!-- Prensa: PrensaList tiene su propia section con id="prensa" y showHead=true -->
  <PrensaList />

  <Contacto />
</BaseLayout>
