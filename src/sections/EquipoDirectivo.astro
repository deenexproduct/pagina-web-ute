---
import { TEAM } from '../config/site';

interface Props {
  showHead?: boolean;
}
const { showHead = true } = Astro.props;

/**
 * Equipo directivo v2 — copy lede comprimido, cards mantenidas.
 * Roles tag por orden de listado en config (Liderazgo / Operación / Expansión).
 */
const initials = (name: string): string =>
  name.split(' ').slice(0, 2).map((n) => n.charAt(0)).join('').toUpperCase();

const memberRoles = ['Liderazgo', 'Operación', 'Expansión'] as const;
---

<section class="team section-y" aria-labelledby="team-title">
  <div class="container-content">
    {showHead && (
      <header class="team__head">
        <p class="eyebrow" data-reveal style="--reveal-y: 16px;">Equipo directivo</p>
        <h2 id="team-title" class="team__title" data-reveal style="--reveal-delay: 100ms;">
          El equipo detrás de <em>Qüem Central</em>.
        </h2>
        <p class="team__lede" data-reveal style="--reveal-delay: 200ms;">
          Experiencia en operación, desarrollo comercial y crecimiento de unidades.
        </p>
      </header>
    )}

    <ul class="team__grid" role="list" data-reveal-stagger>
      {TEAM.map((m, i) => (
        <li class="team-card" data-reveal>
          <div class="team-card__avatar" aria-hidden="true">
            {m.photo ? (
              <img src={m.photo} alt={`Retrato de ${m.name}`} loading="lazy" decoding="async" />
            ) : (
              <>
                <span class="team-card__initials">{initials(m.name)}</span>
                <span class="team-card__avatar-dot" aria-hidden="true"></span>
              </>
            )}
          </div>
          <div class="team-card__body">
            <span class="team-card__role">{memberRoles[i] ?? 'Equipo'}</span>
            <h3>{m.name}</h3>
            <p class="team-card__title">{m.title}</p>
            {m.org && <p class="team-card__org">{m.org}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team__head { display: grid; gap: var(--space-3); margin-block-end: var(--space-7); max-width: 56ch; }
  .team__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
  }
  .team__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .team__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
  }

  .team__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .team-card {
    position: relative;
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    display: grid;
    gap: var(--space-4);
    overflow: hidden;
    transition: transform var(--dur-fast), border-color var(--dur-fast), box-shadow var(--dur-normal);
  }
  .team-card::before {
    content: '';
    position: absolute;
    inset: -40% -40% auto auto;
    width: 70%;
    height: 70%;
    background: radial-gradient(circle, oklch(58% 0.155 254 / 0.10) 0%, transparent 70%);
    pointer-events: none;
    transition: background var(--dur-normal);
  }
  .team-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-brand-300);
    box-shadow: var(--shadow-card);
  }
  .team-card:hover::before {
    background: radial-gradient(circle, oklch(58% 0.155 254 / 0.16) 0%, transparent 70%);
  }

  .team-card__avatar {
    position: relative;
    width: 5rem;
    height: 5rem;
    border-radius: var(--radius-pill);
    background:
      radial-gradient(circle at 30% 30%, oklch(85% 0.06 252 / 0.9) 0%, transparent 60%),
      linear-gradient(135deg, var(--color-brand-200) 0%, var(--color-brand-400) 100%);
    color: var(--color-brand-900);
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 2px solid oklch(100% 0 0 / 0.4);
    box-shadow:
      inset 0 -2px 8px oklch(42% 0.190 252 / 0.18),
      0 6px 20px oklch(42% 0.190 252 / 0.20);
  }
  .team-card__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .team-card__initials {
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: var(--font-size-xl);
    letter-spacing: -0.04em;
    color: var(--color-brand-900);
    text-shadow: 0 1px 0 oklch(100% 0 0 / 0.5);
  }
  .team-card__avatar-dot {
    position: absolute;
    bottom: 6px;
    right: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent-500);
    border: 2px solid var(--color-bg-elevated);
  }

  .team-card__body { display: grid; gap: 0.25rem; position: relative; }
  .team-card__role {
    display: inline-block;
    width: max-content;
    padding: 0.2rem 0.55rem;
    background: var(--color-brand-50);
    color: var(--color-brand-700);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-2xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    margin-block-end: var(--space-2);
  }
  .team-card__body h3 {
    font-size: var(--font-size-lg);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }
  .team-card__title { color: var(--color-text-primary); font-size: var(--font-size-sm); font-weight: var(--weight-medium); }
  .team-card__org {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    margin-block-start: 0.15rem;
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
  }
</style>
