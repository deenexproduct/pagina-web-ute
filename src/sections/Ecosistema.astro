---
import { link } from '../config/site';

interface Props {
  showHead?: boolean;
}
const { showHead = true } = Astro.props;

/**
 * Ecosistema v2 — bento asimétrico, copy comprimido.
 * Hero card: Distribución B2B (2x2 con gradient brand + badge).
 * Tall: Corner QÜEM (1x2, accent).
 * Wide: Logística (2x1).
 * Resto: cards 1x1 chicas.
 */
/*
 * Cards del bento. Los que tienen `href` se renderizan como <a> clickable
 * (Corner Qüem → /corner-quem). El resto son <article> informativos.
 */
const cards = [
  { title: 'Distribución B2B', desc: 'Abastecimiento para gastronomía, comercios y eventos.', tone: 'brand-hero', icon: 'b2b', size: 'hero', features: ['Catálogo premium', 'Pedidos online B2B', 'Entrega en zona'] },
  { title: 'Corner Qüem', desc: 'Productos Qüem dentro de espacios existentes.', tone: 'accent', icon: 'corner', size: 'tall', href: '/corner-quem' },
  { title: 'Logística especializada', desc: 'Última milla AMBA + PBA.', tone: 'brand', icon: 'truck', size: 'wide' },
  { title: 'Franquicias', desc: 'Modelo replicable bajo marca.', tone: 'brand', icon: 'building', size: 'normal' },
  { title: 'Tecnología', desc: 'App, catálogo y pedidos B2B.', tone: 'brand', icon: 'app', size: 'normal' },
  { title: 'Retail B2C', desc: 'Tiendas y venta directa.', tone: 'neutral', icon: 'store', size: 'normal' },
  { title: 'Fraccionamiento', desc: 'Presentaciones por canal.', tone: 'neutral', icon: 'package', size: 'normal' },
] as const;
---

<section class="eco section-y" id="ecosistema" aria-labelledby="eco-title">
  <div class="container-content">
    {showHead && (
      <header class="eco__head">
        <p class="eyebrow" data-reveal style="--reveal-y: 14px;">Ecosistema</p>
        <h2 id="eco-title" class="eco__title" data-reveal style="--reveal-delay: 100ms;">
          Todos los canales, <em>una sola empresa.</em>
        </h2>
        <p class="eco__lede" data-reveal style="--reveal-delay: 200ms;">
          Distribución, retail, logística y tecnología coordinados desde una operación central.
        </p>
      </header>
    )}

    <div class="eco__bento" data-reveal-stagger>
      {cards.map((c) => {
        const Tag = 'href' in c && c.href ? 'a' : 'article';
        return (
        <Tag
          class:list={['eco-card', `eco-card--${c.tone}`, `eco-card--${c.size}`, 'href' in c && c.href && 'eco-card--link']}
          data-reveal
          {...('href' in c && c.href ? { href: link(c.href) } : {})}
        >
          <div class="eco-card__icon" aria-hidden="true">
            {c.icon === 'b2b' && (
              <svg viewBox="0 0 28 28" fill="none"><rect x="3" y="6" width="22" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 11h22M9 16h4M9 19h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            )}
            {c.icon === 'corner' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M4 22V8l9-3 11 4v13" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 22v-7h6v7M19 22v-4h2v4" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'truck' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M3 20V9h14v11M17 13h5l3 4v3h-8" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="8" cy="22" r="2.4" stroke="currentColor" stroke-width="1.6"/><circle cx="21" cy="22" r="2.4" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'building' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M5 23V6h12v17M17 23V11h6v12M5 23h18" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 10h2M8 13h2M8 16h2M12 10h2M12 13h2M12 16h2M20 14h2M20 17h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            )}
            {c.icon === 'app' && (
              <svg viewBox="0 0 28 28" fill="none"><rect x="8" y="3" width="12" height="22" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M12 7h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="14" cy="21" r="0.8" fill="currentColor"/></svg>
            )}
            {c.icon === 'store' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M4 11h20l-2-6H6l-2 6Z" stroke="currentColor" stroke-width="1.6"/><path d="M5 11v12h18V11" stroke="currentColor" stroke-width="1.6"/><path d="M10 23v-6h8v6" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'package' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M14 4 4 9v10l10 5 10-5V9l-10-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m4 9 10 5 10-5M14 14v10M9 6.5l10 5" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
          </div>

          <h3 class="eco-card__title">{c.title}</h3>
          <p class="eco-card__desc">{c.desc}</p>

          {'features' in c && c.features && (
            <ul class="eco-card__features" aria-label="Incluye">
              {(c.features as readonly string[]).map((f) => (
                <li>
                  <span class="eco-card__feat-dot" aria-hidden="true"></span>
                  {f}
                </li>
              ))}
            </ul>
          )}

        </Tag>
        );
      })}
    </div>

  </div>
</section>

<style>
  .eco {
    position: relative;
    background:
      radial-gradient(75% 55% at 50% 0%, oklch(from var(--color-brand-500) l c h / 0.08) 0%, transparent 65%),
      linear-gradient(180deg, var(--color-surface-subtle) 0%, var(--color-brand-100) 55%, var(--color-surface-subtle) 100%);
  }
  .eco__head {
    display: grid; gap: var(--space-3); margin-block-end: var(--space-7);
    max-width: 56ch;
  }
  .eco__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
  }
  .eco__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
  }
  .eco__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
  }

  .eco__bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 640px) { .eco__bento { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) {
    .eco__bento {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: minmax(180px, auto);
      grid-auto-flow: dense;
    }
    .eco-card--hero { grid-column: span 2; grid-row: span 2; }
    .eco-card--tall { grid-column: span 1; grid-row: span 2; }
    .eco-card--wide { grid-column: span 2; grid-row: span 1; }
  }

  .eco-card {
    position: relative;
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-2);
    transition:
      transform var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-normal) var(--ease-out-expo);
  }
  /* Stripe arriba — solo en cards destacados (hero + accent), no en normales */
  .eco-card::before {
    content: '';
    position: absolute; inset: 0 0 auto 0;
    height: 0;
    background: transparent;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    transition: height var(--dur-normal) var(--ease-out-expo);
  }
  .eco-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-card); border-color: var(--color-brand-300); }

  /* Stripe visible solo en destacados */
  .eco-card--brand-hero::before,
  .eco-card--accent::before { height: 3px; }
  .eco-card--brand-hero::before { background: var(--gradient-brand); }
  .eco-card--accent::before { background: linear-gradient(90deg, var(--color-accent-500), var(--color-accent-400)); }
  .eco-card--brand-hero:hover::before,
  .eco-card--accent:hover::before { height: 4px; }
  /* Hero card de Distribución B2B — fondo claro brand-tint, sin oscuro */
  .eco-card--brand-hero {
    background:
      radial-gradient(60% 80% at 100% 0%, oklch(from var(--color-brand-500) l c h / 0.10) 0%, transparent 60%),
      linear-gradient(180deg, var(--color-brand-50) 0%, var(--color-bg-elevated) 70%);
    color: var(--color-text-primary);
    border-color: oklch(from var(--color-brand-500) l c h / 0.25);
  }
  .eco-card--brand-hero::before {
    background: var(--gradient-brand);
    height: 4px;
  }
  .eco-card--brand-hero .eco-card__title {
    color: var(--color-text-primary);
    font-size: var(--font-size-2xl);
  }
  .eco-card--brand-hero .eco-card__desc {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
  }
  .eco-card--brand-hero .eco-card__icon {
    background: oklch(from var(--color-brand-500) l c h / 0.10);
    color: var(--color-brand-700);
    border-color: oklch(from var(--color-brand-500) l c h / 0.20);
  }

  .eco-card--accent {
    background: linear-gradient(180deg, oklch(from var(--color-accent-500) l c h / 0.06), var(--color-bg-elevated));
  }

  .eco-card__icon {
    width: 2.75rem; height: 2.75rem;
    border-radius: 0.7rem;
    display: grid; place-items: center;
    background: var(--color-surface-subtle);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-subtle);
    transition: transform var(--dur-fast), background var(--dur-fast), color var(--dur-fast);
  }
  .eco-card:hover .eco-card__icon { transform: scale(1.08); }
  .eco-card__icon svg { width: 1.5rem; height: 1.5rem; }
  .eco-card--brand .eco-card__icon { background: var(--color-brand-50); color: var(--color-brand-600); border-color: var(--color-brand-100); }
  .eco-card--accent .eco-card__icon { background: var(--color-accent-50); color: var(--color-accent-700); border-color: oklch(from var(--color-accent-500) l c h / 0.15); }

  .eco-card__title {
    font-size: var(--font-size-md);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin-block-start: var(--space-2);
  }
  .eco-card__desc {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--leading-snug);
  }

  /* EC2: Feature micro-list — only shown on hero card */
  .eco-card__features {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .eco-card__features li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }
  .eco-card__feat-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-brand-500);
    flex-shrink: 0;
  }

  /* EC3: Corner Qüem tall card — compact padding */
  .eco-card--tall { padding: var(--space-4); }

  /* Reset link styles para cards clickables (Corner Qüem → /corner-quem) */
  a.eco-card { color: inherit; text-decoration: none; cursor: pointer; }
  .eco-card--link::after {
    content: '↗';
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    transition: transform var(--dur-fast), color var(--dur-fast);
    z-index: 1;
  }
  .eco-card--link:hover::after {
    transform: translate(2px, -2px);
    color: var(--color-text-brand);
  }
</style>
