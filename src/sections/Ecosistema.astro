---
interface Props {
  showHead?: boolean;
}
const { showHead = true } = Astro.props;

const cards = [
  { title: 'Distribución B2B', desc: 'Abastecimiento para restaurantes, comercios, cafeterías, hoteles, eventos y operadores gastronómicos.', tone: 'brand', icon: 'b2b' },
  { title: 'Retail B2C', desc: 'Tiendas y canales de venta directa al consumidor final.', tone: 'neutral', icon: 'store' },
  { title: 'Franquicias', desc: 'Modelo de expansión comercial para operar unidades QUEM bajo una estructura definida.', tone: 'brand', icon: 'building' },
  { title: 'Corner QUEM', desc: 'Formato comercial flexible para insertar productos QUEM en puntos estratégicos de venta.', tone: 'accent', icon: 'corner' },
  { title: 'Logística especializada', desc: 'Distribución de alimentos congelados de última milla con foco en AMBA y Provincia de Buenos Aires.', tone: 'neutral', icon: 'truck' },
  { title: 'Tecnología / App', desc: 'Catálogo digital para facilitar la compra, ordenar pedidos y conectar la operación comercial con el canal online.', tone: 'brand', icon: 'app' },
  { title: 'Fraccionamiento', desc: 'Capacidad operativa para adaptar productos y presentaciones a distintas necesidades comerciales.', tone: 'neutral', icon: 'package' },
  { title: 'Representación comercial', desc: 'Potencial unidad para representar marcas de alimentos congelados en eventos y puntos de expendio.', tone: 'neutral', icon: 'handshake' },
] as const;
---

<section class="eco section-y" id="ecosistema" aria-labelledby="eco-title">
  <div class="container-content">
    {showHead && (
      <header class="eco__head">
        <p class="eyebrow">02 · Ecosistema</p>
        <h2 id="eco-title" class="eco__title">
          Un ecosistema diseñado para <em>escalar alimentos congelados</em>
        </h2>
        <p class="eco__lede">
          QUEM Central integra distintas unidades operativas y comerciales para llevar productos congelados a múltiples canales:
          negocios gastronómicos, comercios, consumidores finales, eventos, franquicias y corners.
        </p>
      </header>
    )}

    <ul class="eco__grid" role="list">
      {cards.map((c) => (
        <li class:list={['eco-card', `eco-card--${c.tone}`]}>
          <div class="eco-card__icon" aria-hidden="true">
            {c.icon === 'b2b' && (
              <svg viewBox="0 0 28 28" fill="none"><rect x="3" y="6" width="22" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 11h22M9 16h4M9 19h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            )}
            {c.icon === 'store' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M4 11h20l-2-6H6l-2 6Z" stroke="currentColor" stroke-width="1.6"/><path d="M5 11v12h18V11" stroke="currentColor" stroke-width="1.6"/><path d="M10 23v-6h8v6" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'building' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M5 23V6h12v17M17 23V11h6v12M5 23h18" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 10h2M8 13h2M8 16h2M12 10h2M12 13h2M12 16h2M20 14h2M20 17h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            )}
            {c.icon === 'corner' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M4 22V8l9-3 11 4v13" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 22v-7h6v7M19 22v-4h2v4" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'truck' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M3 20V9h14v11M17 13h5l3 4v3h-8" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="8" cy="22" r="2.4" stroke="currentColor" stroke-width="1.6"/><circle cx="21" cy="22" r="2.4" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'app' && (
              <svg viewBox="0 0 28 28" fill="none"><rect x="8" y="3" width="12" height="22" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M12 7h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="14" cy="21" r="0.8" fill="currentColor"/></svg>
            )}
            {c.icon === 'package' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M14 4 4 9v10l10 5 10-5V9l-10-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m4 9 10 5 10-5M14 14v10M9 6.5l10 5" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'handshake' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="m4 16 4-5 6 5-3 3-7-3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 16 9 21l3 2 4-4M14 16l5-5 5 5-4 5-3-2-3-3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            )}
          </div>
          <h3>{c.title}</h3>
          <p>{c.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .eco__head {
    display: grid;
    gap: var(--space-3);
    margin-block-end: var(--space-7);
    max-width: 60ch;
  }
  .eco__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.05;
    margin-block-end: var(--space-2);
  }
  .eco__title em {
    font-style: normal;
    background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-700));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .eco__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-relaxed);
  }

  .eco__grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .eco-card {
    position: relative;
    padding: var(--space-5);
    border-radius: var(--radius-xl);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
    transition: transform var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard),
                box-shadow var(--dur-fast) var(--ease-standard);
  }
  .eco-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--color-neutral-300);
    transition: background var(--dur-normal) var(--ease-out-expo);
  }
  .eco-card--brand::before { background: linear-gradient(90deg, var(--color-brand-500), var(--color-brand-400)); }
  .eco-card--accent::before { background: linear-gradient(90deg, var(--color-accent-500), var(--color-accent-400)); }

  .eco-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-strong);
  }
  .eco-card:hover::before { height: 4px; }

  .eco-card__icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.7rem;
    display: grid;
    place-items: center;
    margin-block-end: var(--space-4);
    background: var(--color-surface-subtle);
    color: var(--color-text-secondary);
    transition: background var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard);
  }
  .eco-card__icon svg { width: 1.5rem; height: 1.5rem; }
  .eco-card--brand .eco-card__icon { background: var(--color-brand-50); color: var(--color-brand-600); }
  .eco-card--accent .eco-card__icon { background: var(--color-accent-50); color: var(--color-accent-700); }

  .eco-card h3 {
    font-size: var(--font-size-md);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-2);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }
  .eco-card p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--leading-relaxed);
  }
</style>
