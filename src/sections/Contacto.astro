const c = COPY[lang];

/**
 * Strings que consume el `<script>` de cliente. Se serializan abajo.
 * El microcopy de error se mantiene humano y accionable, como estaba.
 */
const CLIENT_COPY = {
  es: {
    errNombre: 'Contanos cómo te llamás.',
    errInteres: 'Elegí una opción para que llegue al equipo correcto.',
    errEmail: 'Necesitamos un email válido para responderte.',
    errMensaje: 'Contanos brevemente qué necesitás.',
    errGeneric: 'Revisá este campo.',
    statusReview: 'Revisá los campos marcados.',
