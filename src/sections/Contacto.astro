    statusNetwork:
      'No pudimos enviar la consulta: parece que se cortó la conexión. Probá de nuevo.',
    statusTimeout: 'El envío tardó demasiado. Probá de nuevo en un momento.',
    statusServer: 'No pudimos enviar la consulta. Tus datos siguen acá: probá de nuevo.',
    mailSubject: 'Consulta web QUEM',
    mailFrom: 'QUEM · Formulario web',
    mailNombre: 'Nombre',
    mailEmpresa: 'Empresa',
    mailInteres: 'Interés',
    mailTelefono: 'Teléfono',
    mailEmail: 'Email',
    mailMensaje: 'Mensaje',
    mailVacio: '-',
  },
  en: {
    errNombre: 'Tell us your name.',
    errInteres: 'Pick an option so it reaches the right team.',
    errEmail: 'We need a valid email to get back to you.',
    errMensaje: 'Tell us briefly what you need.',
    errGeneric: 'Please check this field.',
    statusReview: 'Please check the highlighted fields.',
    statusSending: 'Sending your enquiry…',
    statusNetwork: "We couldn't send it — the connection seems to have dropped. Please try again.",
    statusTimeout: 'Sending took too long. Please try again in a moment.',
    statusServer: "We couldn't send your enquiry. Your details are still here — please try again.",
    mailSubject: 'QUEM website enquiry',
    mailFrom: 'QUEM · Website form',
    mailNombre: 'Name',
    mailEmpresa: 'Company',
    mailInteres: 'Interest',
    mailTelefono: 'Phone',
    mailEmail: 'Email',
    mailMensaje: 'Message',
    mailVacio: '-',
  },
} as const;

/* ------------------------------------------------------- intereses (6) --- */

/**
 * Override EN de las 6 opciones. `es` va vacío: el español canónico vive
 * en site.ts y no se duplica (misma convención que Opciones.astro).
 */
interface InteresCopy {
  label: string;
  desc: string;
}

const INTERESES_I18N: Record<Lang, Partial<Record<InteresValue, InteresCopy>>> = {
  es: {},
  en: {
    mayorista: {
      label: 'Wholesale',
      desc: 'Cold-chain supply for restaurants, caterers and retailers.',
    },
    franquicia: {
      label: 'Franchises',
      desc: 'Open your own store with the identity and backing of the group.',
    },
    corner: {
      label: 'Corners',
      desc: 'Turnkey frozen retail inside the space you already run.',
    },
    'smart-market': {
      label: 'Smart Market',
      desc: 'Unattended retail for offices, buildings and high-traffic spaces.',
    },
    inversion: {
      label: 'Investment',
      desc: 'Join the growth of the group as an investor.',
    },
    otro: {
      label: 'Other',
      desc: 'Press, suppliers and anything that does not fit above.',
    },
  },
};

interface Opcion {
  value: InteresValue;
  label: string;
  desc: string;
  icon: string;
}

const opciones: Opcion[] = INTERESES.map((i) => {
  const override = INTERESES_I18N[lang][i.value];
  return {
    value: i.value,
    icon: i.icon,
    label: override?.label ?? i.label,
    desc: override?.desc ?? i.desc,
  };
});

/* Mismo lenguaje visual que Opciones.astro: íconos declarativos, SVG local. */
const ICON_PATHS: Record<string, string> = {
  truck:
    '<path d="M2.5 16.5V5.5h11v11"/><path d="M13.5 9.5h4l4 4v3h-2.6"/><path d="M8.2 16.5h2.6"/><circle cx="6" cy="17.9" r="1.9"/><circle cx="17" cy="17.9" r="1.9"/>',
  building:
    '<path d="M2 21h20"/><path d="M4 21V6.2L11.5 3v18"/><path d="M11.5 21V10l8 3.2V21"/><path d="M7 9h1.5M7 12.5h1.5M7 16h1.5M14.5 16h1.5"/>',
  corner:
    '<path d="M3 8V3h5"/><path d="M21 16v5h-5"/><rect x="7" y="7.5" width="10" height="9" rx="1.6"/><path d="M7 12h10M12 7.5v9"/>',
  smart:
    '<rect x="3" y="3" width="11" height="18" rx="2.2"/><path d="M3 9.6h11"/><path d="M10.6 6.1v1.6M10.6 12.9v1.6"/><path d="M17.2 9.4a4.6 4.6 0 0 1 0 5.2"/><path d="M20 7.3a8.2 8.2 0 0 1 0 9.4"/>',
  chart:
    '<path d="M3 20.5h18"/><rect x="4.6" y="12" width="3.6" height="6.4" rx="1.1"/><rect x="10.2" y="7.4" width="3.6" height="11" rx="1.1"/><rect x="15.8" y="10" width="3.6" height="8.4" rx="1.1"/>',
  dots: '<circle cx="12" cy="12" r="9"/><circle cx="8.3" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="15.7" cy="12" r="1" fill="currentColor" stroke="none"/>',
};

const ICON_FALLBACK = '<circle cx="12" cy="12" r="8.4"/><path d="M9 12h6"/>';

/* -------------------------------------------------------- transporte ----- */

const backendOk = hasFormBackend();
const waOk = hasWhatsapp();
const waHref = whatsappLink(c.whatsappMsg, lang);

/**
 * Payload de config para el cliente.
 *
 * `routing` es `routeEmail()` resuelto en build para los 6 intereses: el
 * interés se elige en el browser, así que el mapa tiene que viajar. Mientras
 * los mails de INTERESES estén vacíos, todos caen a EMAILS.contacto — el
 * cableado ya queda hecho y el swap es en site.ts, no acá.
 */
const routing: Record<string, string> = Object.fromEntries(
  INTERESES.map((i): [string, string] => [i.value, routeEmail(i.value)]),
);

const labelsForMail: Record<string, string> = Object.fromEntries(
  opciones.map((o): [string, string] => [o.value, o.label]),
);

const clientConfig = {
  lang,
  endpoint: FORM_ENDPOINT,
  accessKey: FORM_ACCESS_KEY,
  hasBackend: backendOk,
  fallbackEmail: EMAILS.contacto,
  routing,
  labels: labelsForMail,
  copy: CLIENT_COPY[lang],
} as const;

/* `<` escapado para que un valor de config no pueda cerrar el <script>. */
const clientConfigJson = JSON.stringify(clientConfig).replace(/</g, '\\u003c');
---

<section class="contact section-y" id="contacto" aria-labelledby="contacto-title">
  <div class="container-content contact__inner">
    <div class="contact__copy" data-reveal="left">
      {
        showHead && (
          <header class="contact__head">
            <p class="eyebrow">{c.eyebrow}</p>
            <h2 id="contacto-title" class="contact__title">
              {c.titulo} <em>{c.tituloEm}</em>
            </h2>
          </header>
        )
      }
      <p class="contact__lede">{c.lede}</p>

      {
        waOk && (
          <div class="contact__cta-row">
            <a class="btn btn-secondary contact__wa" href={waHref} target="_blank" rel="noopener">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.41.09-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.62 4.15 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z" />
              </svg>
              {t('cta.whatsapp')}
            </a>
          </div>
        )
      }

      <div class="contact__channels-wrap">
        <p class="contact__channels-head">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.5"
            ></rect>
            <path d="M2 7l8 5 8-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            ></path>
          </svg>
          {c.emailHead}
        </p>
        <dl class="contact__channels">
          <div>
            <dt>{c.emailComercial}</dt>
            <dd><a href={`mailto:${EMAILS.comercial}`}>{EMAILS.comercial}</a></dd>
          </div>
          <div>
            <dt>{c.emailGeneral}</dt>
            <dd><a href={`mailto:${EMAILS.contacto}`}>{EMAILS.contacto}</a></dd>
          </div>
        </dl>
      </div>
    </div>

    <noscript>
      <div class="contact__noscript">
        <p>
          <strong>{c.noscriptStrong}</strong>
          {' '}{c.noscriptText}{' '}
          <a href={`mailto:${EMAILS.contacto}`}>{EMAILS.contacto}</a>.
        </p>
      </div>
    </noscript>

    <form
      class="contact__form contact__form--wizard"
      method="post"
      action="#contacto"
      novalidate
      aria-label={c.formAria}
      data-form
      data-step="1"
      data-reveal="right"
      style="--reveal-delay: 100ms;"
    >
      {/* Tiempo de respuesta — siempre visible, para setear expectativa */}
      <p class="wizard__response-time" aria-label={c.responseTimeAria}>
        <span class="wizard__response-time-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" width="14" height="14">
            <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4"></circle>
            <path d="M8 5v3l2 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
            ></path>
          </svg>
        </span>
        {c.responseTimePre}
        <strong>{c.responseTimeStrong}</strong>.
      </p>

      <div
        class="wizard__progress"
        role="progressbar"
        aria-label={c.progressAria}
        aria-valuemin="1"
        aria-valuemax="3"
        aria-valuenow="1"
        data-wizard-progress
      >
        <ol class="wizard__steps" aria-label={c.stepsAria}>
          <li class="wizard__step is-active" data-step-indicator="1">
            <span class="wizard__step-num" aria-hidden="true">1</span>
            <span class="wizard__step-label">{c.step1Short}</span>
          </li>
          <li class="wizard__step" data-step-indicator="2">
            <span class="wizard__step-num" aria-hidden="true">2</span>
            <span class="wizard__step-label">{c.step2Short}</span>
          </li>
          <li class="wizard__step" data-step-indicator="3">
            <span class="wizard__step-num" aria-hidden="true">3</span>
            <span class="wizard__step-label">{c.step3Short}</span>
          </li>
        </ol>
        <div class="wizard__bar" aria-hidden="true">
          <span class="wizard__bar-fill" data-wizard-bar></span>
        </div>
      </div>

      {/* ─────────────────────────── PASO 1 ─────────────────────────── */}
      <fieldset class="wizard__panel is-active" data-step-panel="1">
        <div class="wizard__head">
          <legend class="wizard__legend">{c.step1Legend}</legend>
          <p class="wizard__hint">{c.step1Hint}</p>
        </div>

        <div
          class="wizard__opciones"
          role="radiogroup"
          aria-label={c.radiogroupAria}
          aria-describedby="f-interes-hint"
          data-radiogroup
        >
          {
            /* Cada card asocia label e input con `for`/`id` explícito: el label
              los envuelve, pero su texto vive en spans anidados y el linter de
              a11y no puede verlo. Explícito además es más robusto. */
          }
          {
            opciones.map((o) => (
              <label class="opt-card" for={`f-interes-${o.value}`}>
                <input
                  type="radio"
                  id={`f-interes-${o.value}`}
                  name="interes"
                  value={o.value}
                  required
                  checked={defaultInteres === o.value}
                />
                <span class="opt-card__inner">
                  <span class="opt-card__icon" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={ICON_PATHS[o.icon] ?? ICON_FALLBACK}
                    />
                  </span>
                  <span class="opt-card__label">{o.label}</span>
                  <span class="opt-card__desc">{o.desc}</span>
                  <span class="opt-card__check" aria-hidden="true">
                    <svg viewBox="0 0 14 14" fill="none">
                      <path
                        d="m3 7 3 3 5-6"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </span>
              </label>
            ))
          }
        </div>
        <small
          id="f-interes-hint"
          class="field__hint"
          data-error-for="interes"
          aria-live="polite"
          hidden></small>

        <div class="wizard__actions">
          <span aria-hidden="true"></span>
          <button type="button" class="btn btn-primary wizard__next" data-wizard-next>
            {c.next}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path
                d="M3.5 7h7M7 3.5 10.5 7 7 10.5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </fieldset>

      {/* ─────────────────────────── PASO 2 ─────────────────────────── */}
      <fieldset class="wizard__panel" data-step-panel="2">
        <div class="wizard__head">
          <legend class="wizard__legend">{c.step2Legend}</legend>
          <p class="wizard__hint">{c.step2Hint}</p>
        </div>

        <div class="field">
          <label for="f-nombre">
            {c.labelNombre}
            <span class="req" aria-hidden="true">*</span>
            <span class="sr-only">{c.requerido}</span>
          </label>
          <input
            id="f-nombre"
            name="nombre"
            type="text"
            autocomplete="name"
            required
            maxlength="80"
            aria-describedby="f-nombre-hint"
          />
          <small
            id="f-nombre-hint"
            class="field__hint"
            data-error-for="nombre"
            aria-live="polite"
            hidden></small>
        </div>

        <div class="field">
          <label for="f-empresa">{c.labelEmpresa}</label>
          <input
            id="f-empresa"
            name="empresa"
            type="text"
            autocomplete="organization"
            maxlength="100"
            placeholder={c.phEmpresa}
          />
        </div>

        <div class="field-row">
          <div class="field">
            <label for="f-email">
              {c.labelEmail}
              <span class="req" aria-hidden="true">*</span>
              <span class="sr-only">{c.requerido}</span>
            </label>
            <input
              id="f-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="120"
              aria-describedby="f-email-hint"
            />
            <small
              id="f-email-hint"
              class="field__hint"
              data-error-for="email"
              aria-live="polite"
              hidden></small>
          </div>
          <div class="field">
            <label for="f-tel">{c.labelTelefono}</label>
            <input
              id="f-tel"
              name="telefono"
              type="tel"
              autocomplete="tel"
              inputmode="tel"
              maxlength="30"
              placeholder={c.phTelefono}
            />
          </div>
        </div>

        <div class="wizard__actions">
          <button type="button" class="btn btn-outline wizard__prev" data-wizard-prev>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path
                d="M10.5 7h-7M7 3.5 3.5 7 7 10.5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            {c.prev}
          </button>
          <button type="button" class="btn btn-primary wizard__next" data-wizard-next>
            {c.next}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path
                d="M3.5 7h7M7 3.5 10.5 7 7 10.5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </fieldset>

      {/* ─────────────────────────── PASO 3 ─────────────────────────── */}
      <fieldset class="wizard__panel" data-step-panel="3">
        <div class="wizard__head">
          <legend class="wizard__legend">{c.step3Legend}</legend>
          <p class="wizard__hint">{c.step3Hint}</p>
        </div>

        <div class="field">
          <div class="field__label-row">
            <label for="f-msg">
              {c.labelMensaje}
              <span class="req" aria-hidden="true">*</span>
              <span class="sr-only">{c.requerido}</span>
            </label>
            <small class="field__counter" data-msg-counter aria-live="polite">0 / 1500</small>
          </div>
          <textarea
            id="f-msg"
            name="mensaje"
            rows="5"
            required
            maxlength="1500"
            aria-describedby="f-msg-hint"
            placeholder={c.phMensaje}></textarea>
          <small
            id="f-msg-hint"
            class="field__hint"
            data-error-for="mensaje"
            aria-live="polite"
            hidden></small>
        </div>

        {
          /*
          Honeypot — campo invisible para bots. Si llega completo, se
          descarta y se le devuelve éxito falso al bot (no al humano).
          No usa display:none (algunos bots lo detectan): va offscreen.
        */
        }
        <div class="contact__honeypot" aria-hidden="true">
          <label for="f-website">{c.honeypot}</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {
          !backendOk && (
            <p class="contact__notice">
              <span class="contact__notice-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 20 20"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <circle cx="10" cy="10" r="7.5" />
                  <path d="M10 6.4v4.2" stroke-linecap="round" />
                  <circle cx="10" cy="13.6" r="0.85" fill="currentColor" stroke="none" />
                </svg>
              </span>
              {c.noBackendNotice}
            </p>
          )
        }

        <div class="wizard__actions">
          <button type="button" class="btn btn-outline wizard__prev" data-wizard-prev>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path
                d="M10.5 7h-7M7 3.5 3.5 7 7 10.5"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            {c.prev}
          </button>
          <button type="submit" class="btn btn-primary wizard__submit" data-submit>
            <span class="wizard__spinner" aria-hidden="true"></span>
            <span class="wizard__submit-label wizard__submit-label--idle">
              {backendOk ? c.submit : c.submitMailto}
            </span>
            <span class="wizard__submit-label wizard__submit-label--sending">{c.sending}</span>
            <svg
              class="wizard__submit-arrow"
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 7h9M7 3l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>

        <p class="contact__form-status" data-form-status role="status" aria-live="polite"></p>

        {/* Fallback visible solo cuando el envío falla de verdad. */}
        <p class="contact__error-fallback" data-error-fallback hidden>
          {c.errorFallbackPre}{' '}
          <a href={`mailto:${EMAILS.contacto}`}>{EMAILS.contacto}</a>.
        </p>

        {
          /*
          Handoff a mailto. NO dice "enviado": dice exactamente lo que pasó.
          El form queda intacto abajo para reintentar.
        */
        }
        <div class="wizard__handoff" data-handoff hidden tabindex="-1">
          <h3 class="wizard__handoff-title">{c.handoffTitle}</h3>
          <p class="wizard__handoff-text">{c.handoffText}</p>
          <p class="wizard__handoff-fallback">
            {c.handoffFallback}{' '}
            <strong class="wizard__handoff-email" data-fallback-email>{EMAILS.contacto}</strong>
            <button
              type="button"
              class="form__copy-btn"
              data-copy-email
              data-copy-label={c.copyEmail}
              data-copied-label={c.copied}
            >
              {c.copyEmail}
            </button>
          </p>
          <a class="btn btn-outline wizard__handoff-retry" href="#contacto" data-handoff-retry>
            {c.handoffRetry}
          </a>
        </div>
      </fieldset>

      {/* Éxito REAL — solo se muestra si el backend confirmó la recepción. */}
      <div class="wizard__success" data-success hidden tabindex="-1">
        <span class="wizard__success-icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none" width="32" height="32">
            <circle cx="16" cy="16" r="14" stroke="currentColor" stroke-width="2"></circle>
            <path
              d="m10 16 4 4 8-10"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <h3 class="wizard__success-title">{c.successTitle}</h3>
        <p class="wizard__success-text">{c.successText}</p>
        <p class="wizard__success-meta">{c.successMeta}</p>
        <button type="button" class="btn btn-outline wizard__success-again" data-wizard-restart>
          {c.successAgain}
        </button>
      </div>
    </form>
  </div>
</section>

<script type="application/json" id="contacto-config" is:inline set:html={clientConfigJson} />

<script>
  /**
   * Wizard de 3 pasos + transporte real del formulario.
   *
   *  - Validación por paso (el radiogroup se valida como grupo).
   *  - Errores inline con aria-invalid, que se limpian al tipear.
   *  - Honeypot: al bot se le devuelve éxito, al humano nunca.
   *  - Prefill por querystring `?interes=` (values de INTERESES).
   *  - Submit: fetch POST → éxito SOLO con respuesta ok. Sin backend,
   *    handoff honesto a mailto (nunca se muestra "enviado").
   */
  interface ContactoCopy {
    errNombre: string;
    errInteres: string;
    errEmail: string;
    errMensaje: string;
    errGeneric: string;
    statusReview: string;
    statusSending: string;
    statusNetwork: string;
    statusTimeout: string;
    statusServer: string;
    mailSubject: string;
    mailFrom: string;
    mailNombre: string;
    mailEmpresa: string;
    mailInteres: string;
    mailTelefono: string;
    mailEmail: string;
    mailMensaje: string;
    mailVacio: string;
  }

  interface ContactoConfig {
    lang: string;
    endpoint: string;
    accessKey: string;
    hasBackend: boolean;
    fallbackEmail: string;
    routing: Record<string, string>;
    labels: Record<string, string>;
    copy: ContactoCopy;
  }

  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const configNode = document.getElementById('contacto-config');

  if (form && configNode?.textContent) {
    const CFG = JSON.parse(configNode.textContent) as ContactoConfig;
    const S = CFG.copy;

    const TOTAL_STEPS = 3;
    const TIMEOUT_MS = 15000;

    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const errorFallback = form.querySelector<HTMLElement>('[data-error-fallback]');
    const successBox = form.querySelector<HTMLElement>('[data-success]');
    const handoffBox = form.querySelector<HTMLElement>('[data-handoff]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');

    let sending = false;

    /* ------------------------------------------------------- errores --- */

    const errorMessages: Record<string, string> = {
      nombre: S.errNombre,
      interes: S.errInteres,
      email: S.errEmail,
      mensaje: S.errMensaje,
    };

    /** El radiogroup marca el contenedor, no el primer radio. */
    const invalidTarget = (input: HTMLElement): HTMLElement =>
      input instanceof HTMLInputElement && input.type === 'radio'
        ? (input.closest<HTMLElement>('[data-radiogroup]') ?? input)
        : input;

    const showError = (input: HTMLElement, name: string): void => {
      const hint = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (hint) {
        hint.textContent = errorMessages[name] ?? S.errGeneric;
        hint.hidden = false;
      }
      invalidTarget(input).setAttribute('aria-invalid', 'true');
    };

    const clearError = (input: HTMLElement, name: string): void => {
      const hint = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (hint) {
        hint.hidden = true;
        hint.textContent = '';
      }
      invalidTarget(input).removeAttribute('aria-invalid');
    };

    type StatusType = 'error' | 'info' | 'success';

    const setStatus = (text: string, type?: StatusType): void => {
      if (!status) return;
      status.textContent = text;
      if (type) status.setAttribute('data-form-status-type', type);
      else status.removeAttribute('data-form-status-type');
      if (errorFallback) errorFallback.hidden = type !== 'error';
    };

    /* --------------------------------------------------- validación --- */

    const getStepFields = (step: number): HTMLElement[] => {
      const panel = form.querySelector<HTMLElement>(`[data-step-panel="${step}"]`);
      if (!panel) return [];
      return Array.from(
        panel.querySelectorAll<HTMLElement>(
          'input[required], select[required], textarea[required]',
        ),
      );
    };

    const validateStep = (step: number): boolean => {
      const fields = getStepFields(step);
      let firstInvalid: HTMLElement | null = null;
      const seenRadios = new Set<string>();

      fields.forEach((el) => {
        const field = el as HTMLInputElement;

        /* Los radios se validan como grupo, una sola vez. */
        if (field.type === 'radio') {
          if (seenRadios.has(field.name)) return;
          seenRadios.add(field.name);
          const group = form.querySelectorAll<HTMLInputElement>(`input[name="${field.name}"]`);
          const anyChecked = Array.from(group).some((r) => r.checked);
          if (!anyChecked) {
            showError(field, field.name);
            if (!firstInvalid) firstInvalid = field;
          } else {
            clearError(field, field.name);
          }
          return;
        }

        if (!field.checkValidity()) {
          showError(field, field.name);
          if (!firstInvalid) firstInvalid = field;
        } else {
          clearError(field, field.name);
        }
      });

      if (firstInvalid) {
        (firstInvalid as HTMLElement).focus({ preventScroll: false });
        return false;
      }
      return true;
    };

    /* --------------------------------------------------------- pasos --- */

    const getCurrentStep = (): number => Number(form.getAttribute('data-step') ?? '1');

    const goToStep = (n: number, scroll = true): void => {
      const step = Math.max(1, Math.min(TOTAL_STEPS, n));
      form.setAttribute('data-step', String(step));

      form.querySelectorAll<HTMLElement>('[data-step-panel]').forEach((panel) => {
        panel.classList.toggle('is-active', panel.getAttribute('data-step-panel') === String(step));
      });

      form.querySelectorAll<HTMLElement>('[data-step-indicator]').forEach((ind) => {
        const num = Number(ind.getAttribute('data-step-indicator'));
        ind.classList.toggle('is-active', num === step);
        ind.classList.toggle('is-complete', num < step);
      });

      const bar = form.querySelector<HTMLElement>('[data-wizard-bar]');
      if (bar) bar.style.width = `${((step - 1) / (TOTAL_STEPS - 1)) * 100}%`;

      form
        .querySelector<HTMLElement>('[data-wizard-progress]')
        ?.setAttribute('aria-valuenow', String(step));

      if (scroll) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    /* ------------------------------------------------------- estados --- */

    const setSending = (isSending: boolean): void => {
      sending = isSending;
      form.setAttribute('data-sending', String(isSending));
      form.setAttribute('aria-busy', String(isSending));
      if (submitBtn) submitBtn.disabled = isSending;
    };

    const showSuccess = (): void => {
      if (!successBox) return;
      setStatus('');
      if (handoffBox) handoffBox.hidden = true;
      form.setAttribute('data-state', 'success');
      form.querySelector('[data-step-indicator="3"]')?.classList.add('is-complete');
      successBox.hidden = false;
      successBox.focus({ preventScroll: true });
      successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    const resetWizard = (): void => {
      form.reset();
      form.removeAttribute('data-state');
      if (successBox) successBox.hidden = true;
      if (handoffBox) handoffBox.hidden = true;
      setStatus('');
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((hint) => {
        hint.hidden = true;
        hint.textContent = '';
      });
      form
        .querySelectorAll<HTMLElement>('[aria-invalid]')
        .forEach((el) => el.removeAttribute('aria-invalid'));
      goToStep(1);
    };

    form
      .querySelector<HTMLButtonElement>('[data-wizard-restart]')
      ?.addEventListener('click', resetWizard);

    /* ------------------------------------------------------- payload --- */

    const val = (data: FormData, key: string): string => String(data.get(key) ?? '').trim();

    const buildPayload = (data: FormData): Record<string, string> => {
      const interes = val(data, 'interes');
      const label = CFG.labels[interes] ?? interes;
      return {
        /* Claves que consume el proveedor (Web3Forms y compatibles). */
        access_key: CFG.accessKey,
        subject: `${S.mailSubject} · ${label}`,
        from_name: S.mailFrom,
        replyto: val(data, 'email'),
        /* Ruteo por variable (spec 11): el buzón destino viaja en el payload. */
        to: CFG.routing[interes] ?? CFG.fallbackEmail,
        /* Campos del lead — se renderizan en el cuerpo del mail. */
        nombre: val(data, 'nombre'),
        empresa: val(data, 'empresa') || S.mailVacio,
        email: val(data, 'email'),
        telefono: val(data, 'telefono') || S.mailVacio,
        interes: label,
        interes_id: interes,
        mensaje: val(data, 'mensaje'),
        idioma: CFG.lang,
        origen: window.location.pathname,
      };
    };

    const buildMailto = (data: FormData): string => {
      const interes = val(data, 'interes');
      const label = CFG.labels[interes] ?? interes;
      const destino = CFG.routing[interes] ?? CFG.fallbackEmail;
      const body =
        `${S.mailNombre}: ${val(data, 'nombre')}\n` +
        `${S.mailEmpresa}: ${val(data, 'empresa') || S.mailVacio}\n` +
        `${S.mailInteres}: ${label}\n` +
        `${S.mailTelefono}: ${val(data, 'telefono') || S.mailVacio}\n` +
        `${S.mailEmail}: ${val(data, 'email')}\n\n` +
        `${S.mailMensaje}:\n${val(data, 'mensaje')}\n`;
      const params = new URLSearchParams({
        subject: `${S.mailSubject} · ${label}`,
        body,
      });
      return `mailto:${destino}?${params.toString()}`;
    };

    /** Handoff honesto: se dice qué pasó de verdad, sin declarar envío. */
    const showHandoff = (mailto: string, destino: string): void => {
      if (!handoffBox) return;
      const emailEl = handoffBox.querySelector<HTMLElement>('[data-fallback-email]');
      if (emailEl) emailEl.textContent = destino;
      const retry = handoffBox.querySelector<HTMLAnchorElement>('[data-handoff-retry]');
      if (retry) retry.href = mailto;
      handoffBox.hidden = false;
      handoffBox.focus({ preventScroll: true });
    };

    const copyBtn = form.querySelector<HTMLButtonElement>('[data-copy-email]');
    copyBtn?.addEventListener('click', () => {
      const target = form.querySelector<HTMLElement>('[data-fallback-email]')?.textContent ?? '';
      if (!target || !navigator.clipboard) return;
      void navigator.clipboard.writeText(target).then(() => {
        copyBtn.textContent = copyBtn.dataset.copiedLabel ?? '';
        window.setTimeout(() => {
          copyBtn.textContent = copyBtn.dataset.copyLabel ?? '';
        }, 2000);
      });
    });

    /* ------------------------------------------------------- listeners --- */

    /* Limpiar el error apenas el usuario empieza a corregir. */
    form.querySelectorAll<HTMLElement>('input, select, textarea').forEach((el) => {
      const named = el as HTMLInputElement;
      el.addEventListener('input', () => clearError(el, named.name));
      el.addEventListener('change', () => clearError(el, named.name));
    });

    /* Contador de caracteres del textarea. */
    const msgInput = form.querySelector<HTMLTextAreaElement>('#f-msg');
    const counter = form.querySelector<HTMLElement>('[data-msg-counter]');
    if (msgInput && counter) {
      const maxLen = Number(msgInput.getAttribute('maxlength') ?? 1500);
      const updateCounter = (): void => {
        const len = msgInput.value.length;
        counter.textContent = `${len} / ${maxLen}`;
        counter.classList.toggle('field__counter--warn', len > maxLen * 0.9);
      };
      msgInput.addEventListener('input', updateCounter);
      updateCounter();
    }

    form.querySelectorAll<HTMLButtonElement>('[data-wizard-next]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const current = getCurrentStep();
        if (validateStep(current)) goToStep(current + 1);
      });
    });

    form.querySelectorAll<HTMLButtonElement>('[data-wizard-prev]').forEach((btn) => {
      btn.addEventListener('click', () => goToStep(getCurrentStep() - 1));
    });

    /* ---------------------------------------------------------- submit --- */

    const postForm = async (payload: Record<string, string>): Promise<boolean> => {
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), TIMEOUT_MS);
      try {
        const res = await fetch(CFG.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        if (!res.ok) return false;
        /* Algunos proveedores devuelven 200 con { success: false }. */
        const json: unknown = await res.json().catch(() => null);
        if (json && typeof json === 'object' && 'success' in json) {
          return (json as { success: unknown }).success !== false;
        }
        return true;
      } finally {
        window.clearTimeout(timer);
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (sending) return;

      setStatus('');
      if (handoffBox) handoffBox.hidden = true;

      const data = new FormData(form);

      /* Honeypot: es un bot. Éxito falso PARA EL BOT, nada se envía. */
      if (val(data, 'website') !== '') {
        showSuccess();
        return;
      }

      if (!validateStep(getCurrentStep())) {
        setStatus(S.statusReview, 'error');
        return;
      }

      /* Sin backend: handoff honesto a mailto. Nunca decimos "enviado". */
      if (!CFG.hasBackend) {
        const interes = val(data, 'interes');
        const destino = CFG.routing[interes] ?? CFG.fallbackEmail;
        const mailto = buildMailto(data);
        window.location.href = mailto;
        showHandoff(mailto, destino);
        return;
      }

      setSending(true);
      setStatus(S.statusSending, 'info');

      void postForm(buildPayload(data))
        .then((ok) => {
          setSending(false);
          if (ok) showSuccess();
          else setStatus(S.statusServer, 'error');
        })
        .catch((err: unknown) => {
          setSending(false);
          const aborted = err instanceof DOMException && err.name === 'AbortError';
          setStatus(aborted ? S.statusTimeout : S.statusNetwork, 'error');
        });
    });

    /* ------------------------------------------------ prefill ?interes= --- */

    const requested = new URL(window.location.href).searchParams.get('interes');
    if (requested) {
      const radio = form.querySelector<HTMLInputElement>(
        `input[name="interes"][value="${CSS.escape(requested)}"]`,
      );
      if (radio) {
        radio.checked = true;
        /* Sin scroll: el `#contacto` del link ya posicionó la página. */
        goToStep(2, false);
      }
    }
  }
</script>

<style>
  .contact__inner {
    display: grid;
    /* Columna única explícita — evita que el auto track se expanda al
       min-content de los hijos (grid auto-min bug). */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }
  .contact__copy,
  .contact__form {
    min-width: 0;
  }
  @media (min-width: 960px) {
    .contact__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  .contact__copy {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .contact__head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .contact__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-tight);
    max-width: 16ch;
  }
  .contact__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .contact__lede {
    color: var(--color-text-secondary);
    line-height: var(--leading-snug);
    font-size: var(--font-size-md);
    max-width: 42ch;
  }

  .contact__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .contact__wa svg {
    flex-shrink: 0;
  }

  .contact__channels-wrap {
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
  }
  .contact__channels-head {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
