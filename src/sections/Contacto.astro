---
/**
 * Contacto — spec punto 11. Es EL mecanismo de conversión de Fase 1.
 *
 * Se conserva el wizard de 3 pasos (paso 1: interés · paso 2: datos ·
 * paso 3: mensaje) porque baja la fricción percibida. Lo que cambia:
 *
 *  1. TRANSPORTE REAL. Antes armaba un `mailto:` y a los 1.5 s mostraba
 *     éxito SIEMPRE — mentía. Ahora hace `fetch` POST contra
 *     FORM_ENDPOINT y solo festeja si la respuesta es ok. Sin backend
 *     dado de alta degrada a `mailto:` Y LO DICE: el botón cambia de
 *     texto y hay un aviso permanente arriba del submit.
 *  2. Las 6 opciones salen de INTERESES (site.ts). No hay segunda lista.
 *  3. Ruteo por variable: `routeEmail(interes)` viaja en el payload.
 *  4. Prefill `?interes=` (antes `?tipo=`), con los values de INTERESES.
 *
 * i18n: el copy del markup sale de COPY/INTERESES_I18N. Los strings que
 * necesita el script de cliente (validación, estados, cuerpo del mail)
 * no pueden resolverse con `t()` en runtime del browser, así que se
 * serializan a un `<script type="application/json">` que el módulo lee
 * al montar. Se prefiere eso antes que `define:vars`, que obligaría a
 * marcar el script como inline y perderíamos TypeScript.
 *
 * Todo el estado (éxito, handoff a mailto, error) vive en el markup y se
 * togglea. Nada se inyecta con innerHTML: el CSS de Astro es scoped y el
 * HTML inyectado no lleva el hash, así que saldría sin estilos.
 */
import {
  EMAILS,
  FORM_ACCESS_KEY,
  FORM_ENDPOINT,
  INTERESES,
  hasFormBackend,
  hasWhatsapp,
  routeEmail,
  whatsappLink,
  type InteresValue,
} from '../config/site';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  showHead?: boolean;
  /** Preselección server-side. El querystring `?interes=` hace lo mismo en cliente. */
  defaultInteres?: InteresValue | '';
}
const { showHead = true, defaultInteres = '' } = Astro.props;

/* ---------------------------------------------------------------- copy --- */

