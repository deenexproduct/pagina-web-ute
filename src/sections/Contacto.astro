---
import { APP_BASE_URL, EMAILS, whatsappLink, WHATSAPP, link } from '../config/site';

interface Props {
  showHead?: boolean;
  defaultTipo?: string;
}
const { showHead = true, defaultTipo = '' } = Astro.props;

/**
 * Contacto v2 — copy comprimido, form mantenido.
 * Tipos de consulta sincronizados con landing.
 */
const tipos = [
  'Compra B2B',
  'Corner Qüem',
  'Franquicias',
  'Proveedores / marcas',
  'Inversores',
  'Otro',
];

const waLink = whatsappLink();
const hasWhatsapp = WHATSAPP.length > 0;
---

<section class="contact section-y" id="contacto" aria-labelledby="contact-title">
  <div class="container-content contact__inner">
    <div class="contact__copy" data-reveal="left">
      {showHead && (
        <header>
          <p class="eyebrow">Contacto</p>
          <h2 id="contact-title" class="contact__title">
            Trabajemos con <em>Qüem</em>.
          </h2>
        </header>
      )}
      <p class="contact__lede">
        Compra B2B, corners, franquicias o alianzas. Escribinos.
      </p>

      <div class="contact__cta-row">
        <a class="btn btn-primary" href={APP_BASE_URL} target="_blank" rel="noopener">Comprar online</a>
        <a class="btn btn-secondary" href={waLink} {...(hasWhatsapp ? { target: '_blank', rel: 'noopener' } : {})}>
          WhatsApp comercial
        </a>
      </div>

      <dl class="contact__channels">
        <div>
          <dt>Consultas B2B</dt>
          <dd><a href={`mailto:${EMAILS.comercial}`}>{EMAILS.comercial}</a></dd>
        </div>
        <div>
          <dt>Pedidos y catálogo</dt>
          <dd><a href={`mailto:${EMAILS.ventas}`}>{EMAILS.ventas}</a></dd>
        </div>
        <div>
          <dt>General</dt>
          <dd><a href={`mailto:${EMAILS.contacto}`}>{EMAILS.contacto}</a></dd>
        </div>
      </dl>
    </div>

    <form
      class="contact__form"
      method="post"
      action="#"
      novalidate
      aria-label="Formulario de contacto comercial"
      data-form
      data-reveal="right"
      style="--reveal-delay: 100ms;"
    >
      <p class="contact__form-note">
        Te responde el equipo comercial. * obligatorios.
      </p>

      <div class="field">
        <label for="f-nombre">Nombre y apellido *</label>
        <input id="f-nombre" name="nombre" type="text" autocomplete="name" required aria-describedby="f-nombre-hint" />
        <small id="f-nombre-hint" class="field__hint" data-error-for="nombre" hidden></small>
      </div>

      <div class="field">
        <label for="f-empresa">Empresa</label>
        <input id="f-empresa" name="empresa" type="text" autocomplete="organization" />
      </div>

      <div class="field">
        <label for="f-tipo">Tipo de consulta *</label>
        <select id="f-tipo" name="tipo" required aria-describedby="f-tipo-hint">
          <option value="" disabled selected={!defaultTipo}>Elegí una opción</option>
          {tipos.map((t) => (
            <option value={t} selected={defaultTipo === t}>{t}</option>
          ))}
        </select>
        <small id="f-tipo-hint" class="field__hint" data-error-for="tipo" hidden></small>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="f-tel">Teléfono</label>
          <input id="f-tel" name="telefono" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
        <div class="field">
          <label for="f-email">Email *</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="f-email-hint" />
          <small id="f-email-hint" class="field__hint" data-error-for="email" hidden></small>
        </div>
      </div>

      <div class="field">
        <label for="f-msg">Mensaje *</label>
        <textarea id="f-msg" name="mensaje" rows="5" required aria-describedby="f-msg-hint"></textarea>
        <small id="f-msg-hint" class="field__hint" data-error-for="mensaje" hidden></small>
      </div>

      {/*
        Honeypot — campo invisible para bots. Si llega completo, descartamos.
        No usa display:none (algunos bots lo detectan). Usa offscreen + tabindex=-1.
      */}
      <div class="contact__honeypot" aria-hidden="true">
        <label for="f-website">No completes este campo</label>
        <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="btn btn-primary contact__submit">Enviar consulta</button>
      <p class="contact__form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  /**
   * Form modular: por ahora el envío es client-only — muestra mensaje de éxito
   * y arma mailto. Cuando llegue endpoint o servicio (Formspree/Netlify Forms/
   * propio backend), reemplazar el handler con un fetch al endpoint.
   *
   * Features:
   *  - Honeypot anti-spam (campo `website` invisible — si llega completo, descarta)
   *  - Validación inline con microcopy humano por campo
   *  - Prefill ?tipo= via querystring
   *  - Estado del submit accesible (aria-live)
   */
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  /** Microcopy de errores — humano, accionable, sin jerga */
  const errorMessages: Record<string, (input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => string> = {
    nombre: () => 'Contanos cómo te llamás.',
    tipo: () => 'Elegí una opción para que llegue al equipo correcto.',
    email: (i) => {
      if (!i.value) return 'Necesitamos un email para responderte.';
      return 'El email no parece válido. Revisá si tiene @ y dominio.';
    },
    mensaje: () => 'Contanos brevemente qué necesitás.',
  };

  const showError = (input: HTMLElement, name: string): void => {
    const hint = form?.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    if (!hint) return;
    hint.textContent = errorMessages[name]?.(input as HTMLInputElement) ?? 'Revisá este campo.';
    hint.hidden = false;
    (input as HTMLElement).setAttribute('aria-invalid', 'true');
  };

  const clearError = (input: HTMLElement, name: string): void => {
    const hint = form?.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    if (!hint) return;
    hint.hidden = true;
    hint.textContent = '';
    (input as HTMLElement).removeAttribute('aria-invalid');
  };

  if (form && status) {
    /* Limpiar errores cuando el usuario empieza a corregir */
    form.querySelectorAll<HTMLElement>('input, select, textarea').forEach((el) => {
      el.addEventListener('input', () => clearError(el, (el as HTMLInputElement).name));
      el.addEventListener('change', () => clearError(el, (el as HTMLInputElement).name));
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      status.textContent = '';
      status.removeAttribute('data-form-status-type');

      const data = new FormData(form);

      /* Honeypot: si el campo invisible tiene contenido, es un bot — descartar silenciosamente */
      if (String(data.get('website') ?? '').trim() !== '') {
        status.textContent = 'Tu consulta fue enviada. Gracias.';
        status.setAttribute('data-form-status-type', 'success');
        form.reset();
        return;
      }

      /* Validación: si invalid, mostrar errores inline (sin reportValidity nativo feo) */
      if (!form.checkValidity()) {
        let firstInvalid: HTMLElement | null = null;
        form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          'input[required], select[required], textarea[required]',
        ).forEach((el) => {
          if (!el.checkValidity()) {
            showError(el, el.name);
            if (!firstInvalid) firstInvalid = el;
          }
        });
        if (firstInvalid) (firstInvalid as HTMLElement).focus();
        status.textContent = 'Revisá los campos marcados.';
        status.setAttribute('data-form-status-type', 'error');
        return;
      }

      /* Sin backend todavía → mailto fallback */
      const params = new URLSearchParams();
      const subject = `Consulta web Qüem Central · ${String(data.get('tipo') ?? '')}`;
      const body =
        `Nombre: ${data.get('nombre')}\n` +
        `Empresa: ${data.get('empresa') || '-'}\n` +
        `Tipo: ${data.get('tipo')}\n` +
        `Teléfono: ${data.get('telefono') || '-'}\n` +
        `Email: ${data.get('email')}\n\n` +
        `Mensaje:\n${data.get('mensaje')}\n`;
      params.set('subject', subject);
      params.set('body', body);
      window.location.href = `mailto:comercial@quem-central.com?${params.toString()}`;
      status.textContent = 'Abriendo tu cliente de email…';
      status.setAttribute('data-form-status-type', 'success');
    });

    // Si llega el query ?tipo=Franquicias, prefill
    const u = new URL(window.location.href);
    const t = u.searchParams.get('tipo');
    if (t) {
      const sel = form.querySelector<HTMLSelectElement>('#f-tipo');
      if (sel) sel.value = t;
    }
  }
</script>

<style>
  .contact__inner {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 960px) {
    .contact__inner { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; }
  }

  .contact__copy { display: grid; gap: var(--space-5); align-content: start; }
  .contact__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
    margin-block-start: var(--space-3);
    max-width: 16ch;
  }
  .contact__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .contact__lede {
    color: var(--color-text-secondary);
    line-height: var(--leading-snug);
    font-size: var(--font-size-md);
    max-width: 42ch;
  }
  .contact__cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .contact__channels {
    display: grid;
    gap: var(--space-4);
    padding-block-start: var(--space-5);
    border-top: 1px solid var(--color-border-subtle);
  }
  .contact__channels dt {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    margin-block-end: 0.25rem;
    font-weight: var(--weight-semibold);
  }
  .contact__channels dd a {
    color: var(--color-text-primary);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--color-border-subtle);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--dur-fast);
  }
  .contact__channels dd a:hover { text-decoration-color: var(--color-brand-500); }

  .contact__form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-md);
  }
  .contact__form-note {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }
  .field { display: grid; gap: 0.4rem; }
  .field-row { display: grid; gap: var(--space-4); }
  @media (min-width: 640px) {
    .field-row { grid-template-columns: 1fr 1fr; }
  }
  .field label {
    font-size: var(--font-size-sm);
    color: var(--color-text-primary);
    font-weight: var(--weight-semibold);
  }
  .field input,
  .field select,
  .field textarea {
    padding: 0.85rem 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
    min-height: 44px;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-brand-500);
    box-shadow: var(--shadow-glow-brand);
  }
  .field textarea { resize: vertical; min-height: 120px; line-height: var(--leading-relaxed); }

  .contact__submit { justify-self: start; margin-block-start: var(--space-2); }
  .contact__form-status {
    color: var(--color-accent-700);
    font-size: var(--font-size-sm);
    min-height: 1.5rem;
  }
  .contact__form-status[data-form-status-type="error"] { color: oklch(55% 0.22 28); }
  .contact__form-status[data-form-status-type="success"] { color: var(--color-accent-700); }

  /* Field hint / error microcopy */
  .field__hint {
    font-size: var(--font-size-xs);
    color: oklch(55% 0.22 28);
    line-height: 1.4;
    margin-block-start: 0.15rem;
  }
  .field input[aria-invalid="true"],
  .field select[aria-invalid="true"],
  .field textarea[aria-invalid="true"] {
    border-color: oklch(60% 0.20 28);
    box-shadow: 0 0 0 3px oklch(60% 0.20 28 / 0.12);
  }

  /* Honeypot — offscreen pero accesible para screen readers que sí lo verán como warning */
  .contact__honeypot {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
