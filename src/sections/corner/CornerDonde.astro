---
const venues = [
  { name: 'Supermercados de cercanía', icon: 'supermarket' },
  { name: 'Cafeterías', icon: 'cafe' },
  { name: 'Clubes', icon: 'club' },
  { name: 'Gimnasios', icon: 'gym' },
  { name: 'Oficinas', icon: 'office' },
  { name: 'Estaciones de servicio', icon: 'gas' },
  { name: 'Hoteles', icon: 'hotel' },
  { name: 'Universidades', icon: 'uni' },
  { name: 'Hospitales', icon: 'hospital' },
  { name: 'Coworkings', icon: 'cowork' },
  { name: 'Kioscos premium', icon: 'kiosk' },
  { name: 'Eventos y buffets', icon: 'event' },
];
---

<section class="cn-where section-y" aria-labelledby="cn-where-title">
  <div class="container-content">
    <header class="cn-where__head">
      <p class="eyebrow">03 · Dónde funciona</p>
      <h2 id="cn-where-title" class="cn-where__title">
        Diseñado para espacios con <em>tráfico real</em>
      </h2>
      <p class="cn-where__lede">
        El modelo se adapta a múltiples canales. Cualquier comercio o espacio con flujo de personas
        puede sumar una unidad de venta congelada con menor complejidad operativa.
      </p>
    </header>

    <ul class="cn-where__grid" role="list">
      {venues.map((v) => (
        <li class="cn-venue">
          <div class="cn-venue__icon" aria-hidden="true">
            {v.icon === 'supermarket' && (
              <svg viewBox="0 0 32 32" fill="none"><path d="M4 8h2l3 16h17l3-12H9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="28" r="1.6" stroke="currentColor" stroke-width="1.6"/><circle cx="22" cy="28" r="1.6" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {v.icon === 'cafe' && (
              <svg viewBox="0 0 32 32" fill="none"><path d="M6 12h20v8c0 4-3 8-10 8s-10-4-10-8v-8Zm20 2h3a3 3 0 0 1 0 6h-3M10 8c0-2 2-2 2-4M16 8c0-2 2-2 2-4M22 8c0-2 2-2 2-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            )}
            {v.icon === 'club' && (
              <svg viewBox="0 0 32 32" fill="none"><path d="M16 4 28 12v16H4V12L16 4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 28v-8h8v8" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {v.icon === 'gym' && (
              <svg viewBox="0 0 32 32" fill="none"><path d="M4 16h4M24 16h4M8 12v8M24 12v8M12 8v16M20 8v16M12 16h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            )}
            {v.icon === 'office' && (
              <svg viewBox="0 0 32 32" fill="none"><path d="M4 28V8h14v20M18 14h10v14H18M4 28h24" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 12h2M8 16h2M8 20h2M13 12h2M13 16h2M22 18h2M22 22h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            )}
            {v.icon === 'gas' && (
              <svg viewBox="0 0 32 32" fill="none"><path d="M6 28V6h14v22M20 12h2l4 4v8a3 3 0 0 1-3 3M6 28h16M10 11h6M10 17h6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/></svg>
            )}
            {v.icon === 'hotel' && (
              <svg viewBox="0 0 32 32" fill="none"><path d="M4 28V6h24v22M4 14h24M8 10h4M8 18h4M16 18h4M16 22h4M24 18h-4M24 22h-4M8 22h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            )}
            {v.icon === 'uni' && (
              <svg viewBox="0 0 32 32" fill="none"><path d="M16 4 2 12l14 8 14-8L16 4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M6 14v6c0 3 5 5 10 5s10-2 10-5v-6M28 12v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            )}
            {v.icon === 'hospital' && (
              <svg viewBox="0 0 32 32" fill="none"><path d="M6 28V8h20v20M16 12v8M12 16h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M6 28h20" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {v.icon === 'cowork' && (
              <svg viewBox="0 0 32 32" fill="none"><circle cx="11" cy="11" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="21" cy="11" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M5 26c0-3 3-6 6-6s6 3 6 6M15 26c0-3 3-6 6-6s6 3 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            )}
            {v.icon === 'kiosk' && (
              <svg viewBox="0 0 32 32" fill="none"><path d="M5 28V12h22v16M5 12l3-6h16l3 6M14 28v-10h4v10" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            )}
            {v.icon === 'event' && (
              <svg viewBox="0 0 32 32" fill="none"><path d="M4 12h24v14c0 1-1 2-2 2H6c-1 0-2-1-2-2V12Zm0 0c0-2 2-3 4-3h16c2 0 4 1 4 3M10 9V5M22 9V5M11 18h4M17 18h4M11 22h4M17 22h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
          </div>
          <span class="cn-venue__name">{v.name}</span>
        </li>
      ))}
    </ul>

    <p class="cn-where__foot">
      ¿No ves el tipo de espacio en la lista?
      <a href="#cn-cta" class="cn-where__foot-link">Hablemos del tuyo →</a>
    </p>
  </div>
</section>

<style>
  .cn-where__head { display: grid; gap: var(--space-3); margin-block-end: var(--space-7); max-width: 60ch; }
  .cn-where__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.05;
  }
  .cn-where__title em {
    font-style: normal;
    background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-700));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cn-where__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-relaxed);
  }

  .cn-where__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
  }
  .cn-venue {
    display: grid;
    place-items: center;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-3);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    text-align: center;
    transition: transform var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard),
                background var(--dur-fast) var(--ease-standard);
  }
  .cn-venue:hover {
    transform: translateY(-3px);
    border-color: var(--color-brand-300);
    background: linear-gradient(180deg, var(--color-bg-elevated), var(--color-brand-50));
  }
  .cn-venue__icon {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand-50);
    color: var(--color-brand-600);
    display: grid;
    place-items: center;
    transition: background var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard);
  }
  .cn-venue:hover .cn-venue__icon {
    background: var(--color-brand-500);
    color: var(--color-text-on-brand);
  }
  .cn-venue__icon svg { width: 1.5rem; height: 1.5rem; }
  .cn-venue__name {
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .cn-where__foot {
    margin-block-start: var(--space-7);
    text-align: center;
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
  }
  .cn-where__foot-link {
    color: var(--color-text-brand);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-decoration-color: oklch(from var(--color-brand-500) l c h / 0.3);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--dur-fast) var(--ease-standard);
  }
  .cn-where__foot-link:hover { text-decoration-color: var(--color-brand-500); }
</style>
