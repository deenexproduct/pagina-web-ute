---
/**
 * Corner QÜEM — qué incluye v2 comprimido.
 * Items por columna mantenidos (es la propuesta), título y lede comprimidos.
 */
const columns = [
  {
    title: 'Infraestructura',
    icon: 'infra',
    items: ['Freezers y equipamiento', 'Diseño visual del corner', 'Branding y material POP', 'Layout comercial'],
  },
  {
    title: 'Producto',
    icon: 'product',
    items: ['Postres y helados', 'Snacks y waffles', 'Ready meals y frutas', 'Impulso y marcas aliadas'],
  },
  {
    title: 'Operación',
    icon: 'ops',
    items: ['Logística y distribución', 'Reposición programada', 'Capacitación operativa', 'Soporte y acompañamiento'],
  },
  {
    title: 'Tecnología',
    icon: 'tech',
    items: ['Plataforma / app integrada', 'Pedidos simples', 'Catálogo digital', 'Analytics (futuro)'],
  },
];
---

<section class="cn-includes section-y" aria-labelledby="cn-includes-title">
  <div class="container-content">
    <header class="cn-includes__head">
      <p class="eyebrow" data-reveal style="--reveal-y: 16px;">Qué incluye</p>
      <h2 id="cn-includes-title" class="cn-includes__title" data-reveal style="--reveal-delay: 100ms;">
        Una solución <em>llave en mano</em>.
      </h2>
      <p class="cn-includes__lede" data-reveal style="--reveal-delay: 200ms;">
        Producto, marca, logística, experiencia y soporte. Vos aportás el espacio.
      </p>
    </header>

    <ul class="cn-includes__grid" role="list" data-reveal-stagger>
      {columns.map((c) => (
        <li class="cn-col" data-reveal>
          <div class="cn-col__icon" aria-hidden="true">
            {c.icon === 'infra' && (
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 9 12 4l8 5v11H4V9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 20v-6h6v6M4 13h16" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'product' && (
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 3 8v8l9 5 9-5V8l-9-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m3 8 9 5 9-5M12 13v8" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'ops' && (
              <svg viewBox="0 0 24 24" fill="none"><path d="M3 17V7h12v10M15 11h4l3 3v3h-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="18" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'tech' && (
              <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M9 21h6M12 17v4M7 9l3 2-3 2M13 13h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
          </div>
          <h3>{c.title}</h3>
          <ul class="cn-col__list">
            {c.items.map((it) => (
              <li>
                <span class="cn-col__bullet" aria-hidden="true"></span>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cn-includes__head { display: grid; gap: var(--space-3); margin-block-end: var(--space-7); max-width: 56ch; }
  .cn-includes__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
  }
  .cn-includes__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cn-includes__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
  }

  .cn-includes__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }
  @media (min-width: 540px) {
    .cn-includes__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .cn-includes__grid { grid-template-columns: repeat(4, 1fr); }
  }
  .cn-col {
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    display: grid;
    gap: var(--space-3);
    align-content: start;
    transition: border-color var(--dur-fast), box-shadow var(--dur-normal), transform var(--dur-fast);
  }
  .cn-col:hover {
    border-color: var(--color-brand-300);
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }
  .cn-col__icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.7rem;
    background: linear-gradient(135deg, var(--color-brand-50), var(--color-bg));
    border: 1px solid var(--color-brand-100);
    color: var(--color-brand-600);
    display: grid;
    place-items: center;
  }
  .cn-col__icon svg { width: 1.35rem; height: 1.35rem; }
  .cn-col h3 {
    font-size: var(--font-size-md);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }
  .cn-col__list { display: grid; gap: 0.4rem; margin-block-start: 0.25rem; }
  .cn-col__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem;
    align-items: start;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.45;
  }
  .cn-col__bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-brand-500);
    margin-block-start: 0.55rem;
    flex-shrink: 0;
  }
</style>
