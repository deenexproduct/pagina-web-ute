---
const columns = [
  {
    title: 'Infraestructura',
    icon: 'infra',
    items: ['Freezers y equipamiento', 'Diseño visual del corner', 'Branding y material POP', 'Layout comercial'],
  },
  {
    title: 'Producto',
    icon: 'product',
    items: ['Postres y helados', 'Snacks y waffles', 'Ready meals', 'Frutas congeladas', 'Productos de impulso', 'Marcas aliadas'],
  },
  {
    title: 'Operación',
    icon: 'ops',
    items: ['Logística y distribución', 'Reposición programada', 'Abastecimiento continuo', 'Soporte comercial', 'Acompañamiento operativo'],
  },
  {
    title: 'Tecnología',
    icon: 'tech',
    items: ['Integración con plataforma/app', 'Pedidos simplificados', 'Catálogo digital', 'Analytics y control (futuro)'],
  },
  {
    title: 'Capacitación',
    icon: 'training',
    items: ['Lineamientos de exhibición', 'Sugeridos de surtido', 'Capacitación operativa básica'],
  },
];
---

<section class="cn-includes section-y" aria-labelledby="cn-includes-title">
  <div class="container-content">
    <header class="cn-includes__head">
      <p class="eyebrow">02 · Qué incluye el modelo</p>
      <h2 id="cn-includes-title" class="cn-includes__title">
        Una solución comercial completa — <em>llave en mano</em>
      </h2>
      <p class="cn-includes__lede">
        QÜEM aporta producto, marca, logística, experiencia y soporte. El comercio aporta el espacio
        y el flujo de clientes.
      </p>
    </header>

    <ul class="cn-includes__grid" role="list">
      {columns.map((c) => (
        <li class="cn-col">
          <div class="cn-col__icon" aria-hidden="true">
            {c.icon === 'infra' && (
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 9 12 4l8 5v11H4V9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 20v-6h6v6M4 13h16" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'product' && (
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 3 8v8l9 5 9-5V8l-9-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m3 8 9 5 9-5M12 13v8" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'ops' && (
              <svg viewBox="0 0 24 24" fill="none"><path d="M3 17V7h12v10M15 11h4l3 3v3h-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="18" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {c.icon === 'tech' && (
              <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M9 21h6M12 17v4M7 9l3 2-3 2M13 13h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
            {c.icon === 'training' && (
              <svg viewBox="0 0 24 24" fill="none"><path d="m12 4 9 4-9 4-9-4 9-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M7 11v5c0 2 3 3 5 3s5-1 5-3v-5M21 9v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            )}
          </div>
          <h3>{c.title}</h3>
          <ul class="cn-col__list">
            {c.items.map((it) => (
              <li>
                <span class="cn-col__bullet" aria-hidden="true"></span>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cn-includes__head { display: grid; gap: var(--space-3); margin-block-end: var(--space-7); max-width: 60ch; }
  .cn-includes__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.05;
  }
  .cn-includes__title em {
    font-style: normal;
    background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-700));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cn-includes__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-relaxed);
  }

  .cn-includes__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .cn-col {
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    display: grid;
    gap: var(--space-3);
    align-content: start;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .cn-col:hover { border-color: var(--color-brand-200); }
  .cn-col__icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.6rem;
    background: linear-gradient(135deg, var(--color-brand-50), var(--color-bg));
    border: 1px solid var(--color-brand-100);
    color: var(--color-brand-600);
    display: grid;
    place-items: center;
  }
  .cn-col__icon svg { width: 1.25rem; height: 1.25rem; }
  .cn-col h3 {
    font-size: var(--font-size-md);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }
  .cn-col__list { display: grid; gap: 0.4rem; margin-block-start: 0.25rem; }
  .cn-col__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem;
    align-items: start;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.45;
  }
  .cn-col__bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-brand-500);
    margin-block-start: 0.55rem;
    flex-shrink: 0;
  }
</style>
