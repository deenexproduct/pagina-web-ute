---
import { contactLink } from '../../config/site';
const cornerContactLink = contactLink('corner');

/**
 * Corner QÜEM — hero v2 comprimido.
 * Subtitle 1 frase, highlights mantenidos, panel mockup conservado.
 */
---

<section class="cn-hero" aria-labelledby="cn-hero-title">
  <div class="cn-hero__bg" aria-hidden="true"></div>

  <div class="container-content cn-hero__inner">
    <div class="cn-hero__copy">
      <p class="cn-hero__tag" data-reveal style="--reveal-y: 12px;">
        <span class="cn-hero__tag-dot" aria-hidden="true"></span>
        Modelo comercial
      </p>
      <h1 id="cn-hero-title" class="cn-hero__title" data-reveal style="--reveal-delay: 100ms;">
        Convertimos espacios en <span class="cn-hero__title-em">nuevas oportunidades de venta</span
        >.
      </h1>
      <p class="cn-hero__subtitle" data-reveal style="--reveal-delay: 200ms;">
        Retail congelado llave en mano. Instalado dentro de tu comercio.
      </p>
      <div class="cn-hero__cta-row" data-reveal style="--reveal-delay: 300ms;">
        <a class="btn btn-primary cn-hero__cta-main" href={cornerContactLink}>
          Hablar con comercial
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
            ><path
              d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </a>
        <a class="btn btn-outline" href="#cn-formatos">Ver formatos</a>
      </div>

      <dl class="cn-hero__highlights" aria-label="Highlights del modelo" data-reveal-stagger>
        <div data-reveal style="--reveal-y: 12px;">
          <dt>Implementación</dt>
          <dd>rápida</dd>
        </div>
        <div data-reveal style="--reveal-y: 12px;">
          <dt>Operación</dt>
          <dd>baja</dd>
        </div>
        <div data-reveal style="--reveal-y: 12px;">
          <dt>Rotación</dt>
          <dd>alta</dd>
        </div>
        <div data-reveal style="--reveal-y: 12px;">
          <dt>Estética</dt>
          <dd>retail moderno</dd>
        </div>
      </dl>
    </div>

    <aside
      class="cn-hero__panel"
      aria-hidden="true"
      data-reveal="right"
      style="--reveal-delay: 250ms; --reveal-duration: 1000ms;"
    >
      <div class="cn-hero__panel-card">
        <div class="cn-hero__panel-display">
          <div class="cn-hero__panel-display-top">
            <span>Qüem corner</span>
            <span class="cn-hero__panel-display-led" aria-hidden="true"></span>
          </div>
          <div class="cn-hero__panel-display-mid">
            <div class="cn-hero__panel-shelf">
              <span></span><span></span><span></span>
            </div>
            <div class="cn-hero__panel-shelf">
              <span></span><span></span><span></span>
            </div>
            <div class="cn-hero__panel-shelf cn-hero__panel-shelf--accent">
              <span></span><span></span><span></span>
            </div>
          </div>
          <div class="cn-hero__panel-display-bottom">
            <div class="cn-hero__panel-brand">Qüem</div>
          </div>
        </div>

        <div class="cn-hero__panel-meta">
          <div>
            <div class="cn-hero__panel-meta-label">Mix curado</div>
            <div class="cn-hero__panel-meta-value">8+ líneas</div>
          </div>
          <div>
            <div class="cn-hero__panel-meta-label">Reposición</div>
            <div class="cn-hero__panel-meta-value">incluida</div>
          </div>
          <div>
            <div class="cn-hero__panel-meta-label">Branding</div>
            <div class="cn-hero__panel-meta-value">aplicado</div>
          </div>
        </div>
      </div>

      <div class="cn-hero__panel-glow" aria-hidden="true"></div>
    </aside>
  </div>
</section>

<style>
  .cn-hero {
    position: relative;
    padding-block: clamp(3rem, 5vw, 5.5rem) clamp(2.5rem, 4vw, 4rem);
    overflow: hidden;
    isolation: isolate;
  }
  .cn-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        50% 60% at 100% 0%,
        oklch(from var(--color-brand-500) l c h / 0.18) 0%,
        transparent 65%
      ),
      radial-gradient(
        40% 50% at 0% 100%,
        oklch(from var(--color-accent-500) l c h / 0.18) 0%,
        transparent 65%
      ),
      linear-gradient(180deg, var(--color-brand-tint) 0%, var(--color-bg) 100%);
  }
  .cn-hero__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      oklch(from var(--color-brand-500) l c h / 0.06) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    mask-image: linear-gradient(180deg, black 0%, transparent 90%);
    -webkit-mask-image: linear-gradient(180deg, black 0%, transparent 90%);
  }

  .cn-hero__inner {
    display: grid;
    /* Mobile: 1 columna explícita con minmax(0,1fr) para que los grid items
       no expandan el track más allá del viewport (grid auto-min bug). */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }
  /* Los grid items deben poder colapsar por debajo de su min-content */
  .cn-hero__copy,
  .cn-hero__panel {
    min-width: 0;
  }
  @media (min-width: 960px) {
    .cn-hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .cn-hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: max-content;
    padding: 0.4rem 0.85rem;
    background: oklch(from var(--color-brand-500) l c h / 0.08);
    color: var(--color-text-brand);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
    border: 1px solid oklch(from var(--color-brand-500) l c h / 0.15);
  }
  .cn-hero__tag-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent-500);
    box-shadow: 0 0 0 4px oklch(from var(--color-accent-500) l c h / 0.3);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 4px oklch(from var(--color-accent-500) l c h / 0.3);
    }
    50% {
      box-shadow: 0 0 0 7px oklch(from var(--color-accent-500) l c h / 0.1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cn-hero__tag-dot {
      animation: none;
    }
  }

  .cn-hero__title {
    font-size: var(--font-size-4xl);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: var(--weight-extrabold);
    margin-block: var(--space-4) var(--space-3);
    color: var(--color-text-primary);
    text-wrap: balance;
    max-width: 22ch;
  }
  .cn-hero__title-em {
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cn-hero__subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
    max-width: 50ch;
    margin-block-end: var(--space-5);
  }
  .cn-hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-end: var(--space-6);
  }
  .cn-hero__cta-main {
    padding-inline: 1.5rem;
    padding-block: 1rem;
    font-size: var(--font-size-sm);
    box-shadow: 0 6px 18px oklch(from var(--color-brand-500) l c h / 0.32);
  }
  .cn-hero__cta-main:hover {
    box-shadow: 0 8px 24px oklch(from var(--color-brand-500) l c h / 0.4);
  }

  .cn-hero__highlights {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(50%, 9rem), 1fr));
    padding-block-start: var(--space-5);
    border-top: 1px solid var(--color-border-subtle);
  }
  .cn-hero__highlights dt {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
    margin-block-end: 0.25rem;
  }
  .cn-hero__highlights dd {
    font-family: var(--font-display);
    font-size: var(--font-size-md);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  /* Panel mockup */
  .cn-hero__panel {
    position: relative;
  }
  .cn-hero__panel-card {
    position: relative;
    z-index: 1;
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 1.5rem;
    box-shadow: var(--shadow-lg);
    display: grid;
    gap: var(--space-4);
  }

  .cn-hero__panel-display {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--color-neutral-50) 0%, var(--color-neutral-100) 100%);
    border: 1px solid var(--color-border-subtle);
    padding: var(--space-3);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-2);
  }
  .cn-hero__panel-display-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
  }
  .cn-hero__panel-display-led {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-500);
    box-shadow: 0 0 8px oklch(from var(--color-accent-500) l c h / 0.7);
  }
  .cn-hero__panel-display-mid {
    display: grid;
    gap: 6px;
    align-content: center;
    padding-inline: 0.5rem;
  }
  .cn-hero__panel-shelf {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    padding: 0.5rem;
    background: oklch(100% 0 0);
    border-radius: var(--radius-sm);
    border-bottom: 2px solid var(--color-border-subtle);
  }
  .cn-hero__panel-shelf span {
    aspect-ratio: 1;
    background: linear-gradient(135deg, var(--color-brand-100) 0%, var(--color-brand-200) 100%);
    border-radius: 3px;
  }
  .cn-hero__panel-shelf--accent span {
    background: linear-gradient(135deg, var(--color-accent-100) 0%, var(--color-accent-200) 100%);
  }
  .cn-hero__panel-display-bottom {
    display: flex;
    justify-content: center;
  }
  .cn-hero__panel-brand {
    padding: 0.3rem 1rem;
    background: var(--color-brand-500);
    color: var(--color-text-on-brand);
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    border-radius: var(--radius-sm);
  }

  .cn-hero__panel-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    padding-block-start: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
  }
  .cn-hero__panel-meta-label {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
    margin-block-end: 0.2rem;
  }
  .cn-hero__panel-meta-value {
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .cn-hero__panel-glow {
    position: absolute;
    inset: 14% -10% -10% 8%;
    z-index: 0;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, var(--color-brand-200) 0%, var(--color-accent-200) 100%);
    filter: blur(40px);
    opacity: 0.5;
  }
</style>
