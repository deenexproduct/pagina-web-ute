---
import { link, contactLink } from '../../config/site';

/**
 * Corner Teaser — resumen compacto del modelo Corner para la home.
 * Reemplaza los 5 sub-bloques de Corner en la home (~3500px → ~500px).
 * El detalle completo vive en /corner-quem.
 */
const cornerContactLink = contactLink('Corner Qüem');

const formats = [
  { label: 'Módulo fijo',     desc: 'Exhibidor exclusivo instalado.' },
  { label: 'Sección curada',  desc: 'Góndola o espacio compartido.' },
  { label: 'Corner express',  desc: 'Minimódulo para espacios chicos.' },
  { label: 'Dark corner',     desc: 'Operación exclusivamente delivery.' },
  { label: 'Módulo eventos',  desc: 'Ferias y eventos puntuales.' },
] as const;

const highlights = [
  { label: 'Implementación', value: 'rápida' },
  { label: 'Operación',      value: 'baja complejidad' },
  { label: 'Inversión',      value: 'sin stock propio' },
  { label: 'Rotación',       value: 'alta' },
] as const;

const venues = [
  'Cafeterías', 'Gimnasios', 'Oficinas', 'Clubes',
  'Hoteles', 'Universidades', 'Kioscos premium', 'Coworkings',
] as const;
---

<section class="ct section-y" id="corner-quem" aria-labelledby="ct-title">
  <div class="ct__bg" aria-hidden="true"></div>

  <div class="container-content ct__inner">

    <!-- COPY -->
    <div class="ct__copy">
      <p class="ct__eyebrow" data-reveal style="--reveal-y: 14px;">
        <span class="ct__eyebrow-dot" aria-hidden="true"></span>
        Corner Qüem
      </p>

      <h2 id="ct-title" class="ct__title" data-reveal style="--reveal-delay: 100ms;">
        Retail congelado <em>llave en mano</em>. En tu espacio.
      </h2>

      <p class="ct__lede" data-reveal style="--reveal-delay: 200ms;">
        Instalamos y operamos un corner con producto Qüem dentro de tu comercio. Sin inversión inicial ni complejidad operativa.
      </p>

      <dl class="ct__highlights" data-reveal style="--reveal-delay: 300ms;" aria-label="Características del modelo">
        {highlights.map((h) => (
          <div>
            <dt>{h.label}</dt>
            <dd>{h.value}</dd>
          </div>
        ))}
      </dl>

      <div class="ct__actions" data-reveal style="--reveal-delay: 400ms;">
        <a class="btn btn-primary" href={link('/corner-quem')}>
          Conocer Corner Qüem
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="btn btn-outline" href={cornerContactLink}>
          Hablar con comercial
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <!-- VISUAL -->
    <div class="ct__visual" aria-hidden="true" data-reveal="right" style="--reveal-delay: 200ms; --reveal-duration: 900ms;">

      <!-- Formatos -->
      <div class="ct__formats-block">
        <p class="ct__block-label">5 formatos disponibles</p>
        <ul class="ct__formats">
          {formats.map((f) => (
            <li class="ct__format">
              <span class="ct__format-dot"></span>
              <span class="ct__format-label">{f.label}</span>
              <span class="ct__format-desc">{f.desc}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Venues -->
      <div class="ct__venues-block">
        <p class="ct__block-label">12 tipos de espacios</p>
        <ul class="ct__venues">
          {venues.map((v) => (
            <li class="ct__venue-chip">{v}</li>
          ))}
          <li class="ct__venue-more">
            <a href={link('/corner-quem#cn-where-title')} class="ct__venue-more-link">+4 más →</a>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .ct {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(180deg, var(--color-brand-tint) 0%, var(--color-bg) 100%);
  }
  .ct__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(50% 70% at 100% 0%, oklch(from var(--color-brand-500) l c h / 0.14) 0%, transparent 65%),
      radial-gradient(35% 50% at 0% 100%, oklch(from var(--color-accent-500) l c h / 0.12) 0%, transparent 65%);
  }
  .ct__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, oklch(from var(--color-brand-500) l c h / 0.055) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(180deg, black 0%, transparent 85%);
    -webkit-mask-image: linear-gradient(180deg, black 0%, transparent 85%);
  }

  .ct__inner {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }
  @media (min-width: 960px) {
    .ct__inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; }
  }

  /* ── COPY ── */
  .ct__copy { display: grid; gap: var(--space-4); }

  .ct__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: max-content;
    padding: 0.4rem 0.85rem;
    background: oklch(from var(--color-brand-500) l c h / 0.08);
    color: var(--color-text-brand);
    border: 1px solid oklch(from var(--color-brand-500) l c h / 0.16);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
  }
  .ct__eyebrow-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--color-accent-500);
    box-shadow: 0 0 0 4px oklch(from var(--color-accent-500) l c h / 0.30);
  }

  .ct__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.03;
    color: var(--color-text-primary);
    text-wrap: balance;
    max-width: 22ch;
  }
  .ct__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ct__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
    max-width: 50ch;
  }

  /* Highlights table — full width horizontal, 4 columnas */
  .ct__highlights {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3) var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    width: 100%;
  }
  @media (min-width: 640px) {
    .ct__highlights { grid-template-columns: repeat(4, 1fr); }
  }
  .ct__highlights > div { display: grid; gap: 0.2rem; }
  /* Separadores verticales sutiles entre items en desktop */
  @media (min-width: 640px) {
    .ct__highlights > div + div {
      padding-inline-start: var(--space-4);
      border-inline-start: 1px solid var(--color-border-subtle);
    }
  }
  .ct__highlights dt {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
  }
  .ct__highlights dd {
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .ct__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-block-start: var(--space-2);
  }
  /* ── VISUAL ── */
  .ct__visual {
    display: grid;
    gap: var(--space-4);
  }

  .ct__block-label {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
    margin-block-end: var(--space-3);
  }

  /* Formats list */
  .ct__formats-block,
  .ct__venues-block {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-5);
  }
  .ct__formats { display: grid; gap: var(--space-2); }
  .ct__format {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem var(--space-3);
    border-radius: var(--radius-md);
    transition: background var(--dur-fast);
  }
  .ct__format:hover { background: var(--color-surface-subtle); }
  .ct__format-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--color-brand-400);
    flex-shrink: 0;
  }
  .ct__format-label {
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    white-space: nowrap;
  }
  .ct__format-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-align: right;
  }

  /* Venues chips */
  .ct__venues {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .ct__venue-chip,
  .ct__venue-more {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    font-size: var(--font-size-xs);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  /* "+4 más" chip — move tap area entirely onto the <a> so the
     full 44px min touch target is clickable (not just the text node) */
  .ct__venue-more {
    padding: 0;
    min-block-size: 44px;
  }
  .ct__venue-more-link {
    display: flex;
    align-items: center;
    align-self: stretch;
    min-block-size: 44px;
    padding: 0.35rem 0.75rem;
  }
  .ct__venue-chip {
    background: var(--color-brand-50);
    color: var(--color-brand-700);
    border: 1px solid oklch(from var(--color-brand-500) l c h / 0.18);
  }
  .ct__venue-more {
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-subtle);
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }
  .ct__venue-more:hover {
    border-color: var(--color-brand-300);
    color: var(--color-text-brand);
  }
  .ct__venue-more-link {
    color: inherit;
    text-decoration: none;
    font-weight: var(--weight-semibold);
  }
</style>
