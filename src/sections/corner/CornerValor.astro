---
/**
 * Corner QÜEM — propuesta de valor v2.
 * Quote final = brief, columnas split mantenidas, items comprimidos.
 */
const noNeed = [
  'Cocina',
  'Desarrollar productos',
  'Estructura compleja',
  'Conocimiento técnico',
];

const quemAporta = [
  { label: 'Producto', detail: 'mix curado alta rotación' },
  { label: 'Marca', detail: 'identidad + POP' },
  { label: 'Logística', detail: 'distribución + reposición' },
  { label: 'Experiencia', detail: 'retail moderno' },
  { label: 'Soporte', detail: 'acompañamiento comercial' },
  { label: 'Operación', detail: 'capacitación y lineamientos' },
];
---

<section class="cn-value section-y" aria-labelledby="cn-value-title">
  <div class="container-content">
    <header class="cn-value__head">
      <p class="eyebrow" data-reveal style="--reveal-y: 16px;">Propuesta de valor</p>
      <h2 id="cn-value-title" class="cn-value__title" data-reveal style="--reveal-delay: 100ms;">
        Sumá facturación <em>sin complejizar la operación</em>.
      </h2>
    </header>

    <div class="cn-value__split">
      <article class="cn-value__col cn-value__col--no" data-reveal="left" style="--reveal-delay: 100ms;">
        <header>
          <span class="cn-value__col-tag" data-tone="no">No necesitás</span>
          <h3>Cero fricción operativa</h3>
        </header>
        <ul>
          {noNeed.map((n) => (
            <li>
              <span class="cn-value__cross" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M4 4l6 6M10 4l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
              <span>{n}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="cn-value__col cn-value__col--si" data-reveal="right" style="--reveal-delay: 200ms;">
        <header>
          <span class="cn-value__col-tag" data-tone="si">Qüem aporta</span>
          <h3>Solución llave en mano</h3>
        </header>
        <ul class="cn-value__si-grid">
          {quemAporta.map((q) => (
            <li>
              <span class="cn-value__check" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="m3 7 3 3 6-7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <span class="cn-value__si-label">{q.label}</span>
                <span class="cn-value__si-detail">{q.detail}</span>
              </div>
            </li>
          ))}
        </ul>
      </article>
    </div>

  </div>
</section>

<style>
  .cn-value__head { display: grid; gap: var(--space-3); margin-block-end: var(--space-7); max-width: 56ch; }
  .cn-value__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
  }
  .cn-value__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cn-value__split {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 768px) {
    .cn-value__split { grid-template-columns: 1fr 1.4fr; }
  }

  .cn-value__col {
    padding: var(--space-6);
    border-radius: var(--radius-2xl);
    display: grid;
    gap: var(--space-4);
  }
  .cn-value__col--no {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
  }
  .cn-value__col--si {
    background: linear-gradient(180deg, oklch(from var(--color-brand-500) l c h / 0.06) 0%, var(--color-bg-elevated) 60%);
    border: 1px solid oklch(from var(--color-brand-500) l c h / 0.25);
    color: var(--color-text-primary);
    position: relative;
    overflow: hidden;
  }
  .cn-value__col--si::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, oklch(42% 0.190 252 / 0.05) 1px, transparent 1px);
    background-size: 20px 20px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 90%);
    pointer-events: none;
  }
  .cn-value__col > * { position: relative; z-index: 1; }

  .cn-value__col-tag {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
    margin-block-end: var(--space-3);
  }
  .cn-value__col-tag[data-tone="no"] {
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-subtle);
  }
  .cn-value__col-tag[data-tone="si"] {
    background: var(--color-accent-50);
    color: var(--color-accent-700);
    border: 1px solid oklch(from var(--color-accent-500) l c h / 0.30);
  }
  .cn-value__col h3 {
    font-size: var(--font-size-xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .cn-value__col--si h3 { color: var(--color-text-primary); }

  .cn-value__col ul { display: grid; gap: var(--space-3); }
  .cn-value__col li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    font-size: var(--font-size-base);
    line-height: 1.4;
  }
  .cn-value__col--no li { color: var(--color-text-secondary); }
  .cn-value__col--si li { color: var(--color-text-primary); }

  .cn-value__cross {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    display: grid;
    place-items: center;
    margin-block-start: 0.1rem;
  }
  .cn-value__check {
    width: 1.65rem;
    height: 1.65rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-100);
    color: var(--color-accent-700);
    display: grid;
    place-items: center;
    margin-block-start: 0.1rem;
  }

  .cn-value__si-grid { display: grid; gap: var(--space-3); }
  @media (min-width: 640px) {
    .cn-value__si-grid { grid-template-columns: 1fr 1fr; }
  }
  .cn-value__si-label {
    display: block;
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    font-size: var(--font-size-base);
    letter-spacing: -0.01em;
  }
  .cn-value__si-detail {
    display: block;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    margin-block-start: 0.15rem;
  }

</style>
