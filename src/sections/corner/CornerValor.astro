---
const noNeed = [
  'No necesitás cocina',
  'No necesitás desarrollar productos',
  'No necesitás estructura compleja',
  'No necesitás conocimiento técnico profundo',
];

const quemAporta = [
  { label: 'Producto', detail: 'mix curado de alta rotación' },
  { label: 'Marca', detail: 'identidad y material POP' },
  { label: 'Logística', detail: 'distribución y reposición' },
  { label: 'Experiencia', detail: 'retail moderno premium' },
  { label: 'Soporte', detail: 'acompañamiento comercial' },
  { label: 'Operación', detail: 'lineamientos y capacitación' },
];
---

<section class="cn-value section-y" aria-labelledby="cn-value-title">
  <div class="container-content">
    <header class="cn-value__head">
      <p class="eyebrow" data-reveal style="--reveal-y: 16px;">04 · Propuesta de valor</p>
      <h2 id="cn-value-title" class="cn-value__title" data-reveal style="--reveal-delay: 100ms;">
        Te ayudamos a sumar facturación <em>sin complejizar tu operación</em>
      </h2>
    </header>

    <div class="cn-value__split">
      <article class="cn-value__col cn-value__col--no" data-reveal="left" style="--reveal-delay: 100ms;">
        <header>
          <span class="cn-value__col-tag" data-tone="no">El comercio NO necesita</span>
          <h3>Cero fricción operativa</h3>
        </header>
        <ul>
          {noNeed.map((n) => (
            <li>
              <span class="cn-value__cross" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M4 4l6 6M10 4l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </span>
              <span>{n}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="cn-value__col cn-value__col--si" data-reveal="right" style="--reveal-delay: 200ms;">
        <header>
          <span class="cn-value__col-tag" data-tone="si">QÜEM aporta</span>
          <h3>Solución comercial integral</h3>
        </header>
        <ul class="cn-value__si-grid">
          {quemAporta.map((q) => (
            <li>
              <span class="cn-value__check" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="m3 7 3 3 6-7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <span class="cn-value__si-label">{q.label}</span>
                <span class="cn-value__si-detail">{q.detail}</span>
              </div>
            </li>
          ))}
        </ul>
      </article>
    </div>

    <blockquote class="cn-value__quote">
      <p>"Te ayudamos a sumar facturación sin complejizar tu operación."</p>
    </blockquote>
  </div>
</section>

<style>
  .cn-value__head { display: grid; gap: var(--space-3); margin-block-end: var(--space-7); max-width: 60ch; }
  .cn-value__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.05;
  }
  .cn-value__title em {
    font-style: normal;
    background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-700));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cn-value__split {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 768px) {
    .cn-value__split { grid-template-columns: 1fr 1.4fr; }
  }

  .cn-value__col {
    padding: var(--space-6);
    border-radius: var(--radius-2xl);
    display: grid;
    gap: var(--space-4);
  }
  .cn-value__col--no {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
  }
  .cn-value__col--si {
    background: linear-gradient(135deg, var(--color-brand-700) 0%, var(--color-brand-900) 100%);
    color: var(--color-text-on-brand);
    border: 1px solid var(--color-brand-700);
    position: relative;
    overflow: hidden;
  }
  .cn-value__col--si::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, oklch(100% 0 0 / 0.06) 1px, transparent 1px);
    background-size: 20px 20px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 90%);
    pointer-events: none;
  }
  .cn-value__col > * { position: relative; z-index: 1; }

  .cn-value__col-tag {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
    margin-block-end: var(--space-3);
  }
  .cn-value__col-tag[data-tone="no"] {
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-subtle);
  }
  .cn-value__col-tag[data-tone="si"] {
    background: oklch(from var(--color-accent-500) l c h / 0.2);
    color: var(--color-accent-300);
    border: 1px solid oklch(from var(--color-accent-500) l c h / 0.4);
  }
  .cn-value__col h3 {
    font-size: var(--font-size-xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .cn-value__col--si h3 { color: var(--color-text-on-brand); }

  .cn-value__col ul { display: grid; gap: var(--space-3); }
  .cn-value__col li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    font-size: var(--font-size-base);
    line-height: 1.4;
  }
  .cn-value__col--no li { color: var(--color-text-secondary); }
  .cn-value__col--si li { color: oklch(100% 0 0 / 0.92); }

  .cn-value__cross {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    display: grid;
    place-items: center;
    margin-block-start: 0.1rem;
  }
  .cn-value__check {
    width: 1.65rem;
    height: 1.65rem;
    border-radius: var(--radius-pill);
    background: oklch(from var(--color-accent-500) l c h / 0.2);
    color: var(--color-accent-300);
    display: grid;
    place-items: center;
    margin-block-start: 0.1rem;
  }

  .cn-value__si-grid { display: grid; gap: var(--space-3); }
  @media (min-width: 640px) {
    .cn-value__si-grid { grid-template-columns: 1fr 1fr; }
  }
  .cn-value__si-label {
    display: block;
    font-weight: var(--weight-bold);
    color: var(--color-text-on-brand);
    font-size: var(--font-size-base);
    letter-spacing: -0.01em;
  }
  .cn-value__si-detail {
    display: block;
    color: oklch(100% 0 0 / 0.7);
    font-size: var(--font-size-sm);
    margin-block-start: 0.15rem;
  }

  .cn-value__quote {
    margin-block-start: var(--space-8);
    padding: var(--space-6) var(--space-5);
    background: linear-gradient(135deg, var(--color-brand-50), var(--color-accent-50));
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border-subtle);
    text-align: center;
  }
  .cn-value__quote p {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
    max-width: 32ch;
    margin-inline: auto;
  }
</style>
