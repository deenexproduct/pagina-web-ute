---
/**
 * Hero — placeholder editorial.
 * Layout asimétrico: título display a la izquierda con tracking negativo,
 * meta a la derecha en columna estrecha. Sin centrado obvio.
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid container-content">
    <p class="eyebrow hero__eyebrow">Próximamente · Casa gastronómica</p>

    <h1 id="hero-title" class="hero__title">
      <span class="hero__title-line">Una mesa</span>
      <span class="hero__title-line hero__title-line--italic">que se queda</span>
      <span class="hero__title-line">con vos.</span>
    </h1>

    <p class="hero__lede">
      UTE es un encuentro entre producto, fuego y memoria. Una propuesta gastronómica
      pensada como obra: temporada, autor, ritmo.
    </p>

    <div class="hero__cta-row">
      <a href="#reservas" class="cta cta--primary">Reservar mesa</a>
      <a href="#experiencia" class="cta cta--ghost">
        Conocer la experiencia
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <aside class="hero__meta">
      <dl>
        <div><dt>Próxima apertura</dt><dd>2026</dd></div>
        <div><dt>Ciudad</dt><dd>Buenos Aires · AR</dd></div>
      </dl>
    </aside>
  </div>

  <div class="hero__rule" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(8rem, 14vh, 14rem) clamp(4rem, 8vh, 8rem);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--space-6);
    column-gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .hero__grid {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      grid-template-areas:
        'eyebrow  meta'
        'title    meta'
        'lede     .'
        'cta      .';
      align-items: end;
    }
    .hero__eyebrow { grid-area: eyebrow; }
    .hero__title { grid-area: title; }
    .hero__lede { grid-area: lede; }
    .hero__cta-row { grid-area: cta; }
    .hero__meta { grid-area: meta; }
  }

  .hero__title {
    font-size: var(--font-size-display);
    line-height: 0.92;
    letter-spacing: var(--tracking-tightest);
    font-weight: var(--weight-light);
    margin-block-start: var(--space-3);
  }
  .hero__title-line {
    display: block;
  }
  .hero__title-line--italic {
    font-style: italic;
    color: var(--color-text-secondary);
    padding-inline-start: clamp(2rem, 8vw, 8rem);
  }

  .hero__lede {
    max-width: 38ch;
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-relaxed);
    margin-block-start: var(--space-5);
  }

  .hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .cta {
    --_pad-x: 1.5rem;
    --_pad-y: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: var(--_pad-y) var(--_pad-x);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    transition: transform var(--dur-fast) var(--ease-standard),
                background-color var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard);
    min-height: 44px;
    min-width: 44px;
  }

  .cta--primary {
    background-color: var(--color-text-primary);
    color: var(--color-bg);
  }
  .cta--primary:hover {
    transform: translateY(-1px);
    background-color: var(--color-brand-600);
  }

  .cta--ghost {
    background-color: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-strong);
  }
  .cta--ghost:hover {
    background-color: var(--color-surface-subtle);
  }

  .hero__meta {
    align-self: end;
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
  }
  .hero__meta dl {
    display: grid;
    gap: var(--space-3);
  }
  .hero__meta dt {
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-size: var(--font-size-2xs);
    color: var(--color-text-muted);
    margin-block-end: 0.25rem;
  }
  .hero__meta dd {
    color: var(--color-text-primary);
    font-size: var(--font-size-base);
    font-family: var(--font-display);
  }

  .hero__rule {
    margin-block-start: var(--space-9);
    height: 1px;
    background: var(--color-border-subtle);
  }
</style>
