---
/**
 * UnidadesDeNegocio — spec punto 6.
 *
 * "4 bloques: Tiendas · Central · Smart · Origen. Cada uno: imagen + una
 * línea. Visión de grupo (para el inversor)."
 *
 * Es la sección que le habla al inversor: comunica ESCALA (cuatro frentes
 * operativos) y COHERENCIA (un solo grupo). Por eso las cuatro se tratan
 * igual — misma card, mismo peso tipográfico — y lo único que las
 * distingue es la textura del placeholder.
 *
 * ── Cambios respecto de la versión anterior ──────────────────────────────
 *  - Antes describía 9 unidades funcionales inventadas en el markup. Ahora
 *    los datos salen de UNIDADES (src/config/site.ts), que es la única
 *    lista.
 *  - Se sacó el CTA "Empezar a comprar" → buyOnlineLink(): Fase 1 deroga
 *    el e-commerce.
 *  - El archivo estaba huérfano (nadie lo importaba). El CSS bueno se
 *    reusó; el bento de 9 celdas se reemplazó por una fila de 4.
 *
 * SIN CTA PROPIA, a propósito: la conversión la manejan los `CTABand`
 * que `Home.astro` intercala alrededor de esta sección (spec punto 8) —
 * uno justo arriba y otro de "inversión" más abajo. Meter una tercera acá
 * sería pisar esa decisión y apilar dos CTAs a 30px una de otra. Si se
 * decide sumarla, va a `contactLink('inversion')` envuelto en
 * `localizedPath` (contactLink no conoce el idioma).
 *
 * Tampoco fija fondo propio: hereda `--color-bg` de la página para que el
 * `CTABand variant="subtle"` de arriba siga leyéndose como un escalón.
 */
import { UNIDADES, type UnidadSlug } from '../config/site';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/* ── Copy propio de la sección ─────────────────────────────────────────── */
const COPY = {
  es: {
    eyebrow: 'Unidades de negocio',
    titulo: 'Cuatro unidades,',
    tituloEm: 'un solo grupo.',
    bajada:
      'Del desarrollo de producto al mostrador: cada unidad cubre un tramo de la cadena del congelado.',
    /* Prefijo del alt cuando llegue la foto real. TODO: alt propio por unidad con el asset definitivo. */
    altPrefix: 'Imagen de',
  },
  en: {
    eyebrow: 'Business units',
    titulo: 'Four units,',
    tituloEm: 'one group.',
    bajada:
      'From product development to the counter: each unit covers one stretch of the frozen-food chain.',
    altPrefix: 'Photo of',
  },
} as const;
const c = COPY[lang];

/**
 * Override de idioma de las 4 unidades.
 *
 * El ES es la fuente de verdad y vive en site.ts, así que no se duplica
 * acá: `es` queda vacío a propósito y cae al dato de config. En EN sólo se
 * traduce la línea — los nombres son marca y no se traducen.
 */
interface UnidadCopy {
  /** Sólo si el nombre cambiara; las marcas no se traducen. */
  readonly nombre?: string;
  readonly linea: string;
}

const UNIDADES_I18N: Record<Lang, Partial<Record<UnidadSlug, UnidadCopy>>> = {
  es: {},
  en: {
    tiendas: { linea: 'The retail network for end consumers, with its own ordering app.' },
    central: {
      linea: 'Sourcing, cold-chain logistics and distribution for restaurants and retailers.',
    },
    smart: { linea: 'Unattended retail formats for offices, buildings and high-traffic spaces.' },
    origen: { linea: 'Product development and a direct link to production.' },
  },
};

/**
 * Vista resuelta: config + override de idioma + numeral de orden.
 * `draft` viaja hasta el DOM como `data-draft` (ver más abajo).
 */
const unidades = UNIDADES.map((u, i) => {
  const override = UNIDADES_I18N[lang][u.slug];
  return {
    slug: u.slug,
    nombre: override?.nombre ?? u.nombre,
    linea: override?.linea ?? u.linea,
    imagen: u.imagen,
    draft: u.draft === true,
    num: String(i + 1).padStart(2, '0'),
  };
});
---

{
  unidades.length > 0 && (
    <section
      id="unidades"
      class="unidades section-y"
      aria-labelledby="unidades-title"
      style={`--draft-label: '${t('state.borrador')}'`}
    >
      <div class="container-content">
        <header class="unidades__head">
          <p class="eyebrow" data-reveal style="--reveal-y: 12px;">
            {c.eyebrow}
          </p>
          <h2 id="unidades-title" class="unidades__title" data-reveal style="--reveal-delay: 80ms;">
            {c.titulo} <em>{c.tituloEm}</em>
          </h2>
          <p class="unidades__lede" data-reveal style="--reveal-delay: 160ms;">
            {c.bajada}
          </p>
        </header>

        {/*
          `data-draft` = copy INFERIDO, pendiente de que el cliente confirme
          qué son exactamente "Smart" y "Origen". Es invisible para el
          usuario final (nada de badge feo) pero greppable, y se pinta solo
          en modo revisión interna: abrir la home con `?review` (ver el
          script y el bloque `html[data-review]` de más abajo).
        */}
        <ol class="unidades__grid" role="list">
          {unidades.map((u, i) => (
            <li
              class="unidad"
              data-draft={u.draft ? 'true' : undefined}
              data-reveal
              style={`--reveal-delay: ${220 + i * 90}ms`}
            >
              {/*
                Slot de imagen. Sin `imagen` en config va un placeholder
                deliberado: textura propia por unidad + numeral. Cuando llegue
                la foto, `imagen` en site.ts la reemplaza sin tocar el markup.
              */}
              {u.imagen ? (
                <img
                  class="unidad__img"
                  src={u.imagen}
                  alt={`${c.altPrefix} ${u.nombre}`}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div
                  class:list={['unidad__media', `unidad__media--${u.slug}`]}
                  data-placeholder="imagen"
                  aria-hidden="true"
                >
                  <span class="unidad__num">{u.num}</span>
                </div>
              )}

              <div class="unidad__body">
                <h3 class="unidad__nombre">{u.nombre}</h3>
                <p class="unidad__linea">{u.linea}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

{
  /* Modo revisión interna: `?review` en la URL marca el copy en borrador.
    Inline (son 3 líneas) para no agregar un request en producción, donde
    además no hace nada. */
}
<script is:inline>
  if (new URLSearchParams(window.location.search).has('review')) {
    document.documentElement.setAttribute('data-review', '');
  }
</script>

<style>
  /* Sin `background` propio: hereda --color-bg de la página (ver docblock). */

  /* ── Header ─────────────────────────────────────────────── */
  .unidades__head {
    display: grid;
    gap: var(--space-3);
    max-width: 52ch;
    margin-block-end: var(--space-7);
  }
  @media (min-width: 768px) {
    .unidades__head {
      margin-block-end: var(--space-8);
    }
  }
  .unidades__title {
    font-size: var(--font-size-2xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-tight);
  }
  .unidades__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .unidades__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
  }

  /* ── Grid: 1 → 2 → 4 ────────────────────────────────────── */
  .unidades__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 560px) {
    .unidades__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .unidades__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
  }

  /* ── Card ───────────────────────────────────────────────── */
  .unidad {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xs);
    transition:
      border-color var(--dur-normal) var(--ease-premium),
      box-shadow var(--dur-normal) var(--ease-premium);
  }
  /* Las cards no son links: el hover no levanta (no insinúa click). */
  .unidad:hover {
    border-color: oklch(from var(--color-brand-500) l c h / 0.28);
    box-shadow: var(--shadow-card);
  }

  /* ── Slot de imagen ─────────────────────────────────────── */
  .unidad__img,
  .unidad__media {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  @media (min-width: 560px) {
    .unidad__img,
    .unidad__media {
      aspect-ratio: 4 / 3;
    }
  }
  @media (min-width: 1024px) {
    .unidad__img,
    .unidad__media {
      aspect-ratio: 4 / 5;
    }
  }

  .unidad__media {
    position: relative;
    display: grid;
    place-items: center;
    border-block-end: 1px solid var(--color-border-subtle);
  }
  .unidad__num {
    font-family: var(--font-display);
    font-size: var(--font-size-4xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tightest);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-primary);
    opacity: 0.14;
    user-select: none;
  }

  /* Textura propia por unidad — que no sean 4 rectángulos idénticos.
     Todo sale de tokens; el alpha es lo único numérico (igual que en el
     resto del repo). */

  /* 01 · Tiendas — retícula de mostrador / punto de venta */
  .unidad__media--tiendas {
    background-color: var(--color-brand-50);
    background-image:
      repeating-linear-gradient(
        0deg,
        oklch(from var(--color-brand-500) l c h / 0.14) 0 1px,
        transparent 1px 26px
      ),
      repeating-linear-gradient(
        90deg,
        oklch(from var(--color-brand-500) l c h / 0.14) 0 1px,
        transparent 1px 26px
      );
  }

  /* 02 · Central — flujo logístico en diagonal */
  .unidad__media--central {
    background-color: var(--color-surface-subtle);
    background-image: repeating-linear-gradient(
      135deg,
      oklch(from var(--color-brand-500) l c h / 0.16) 0 2px,
      transparent 2px 15px
    );
  }

  /* 03 · Smart — punto desatendido, ondas concéntricas */
  .unidad__media--smart {
    background-color: var(--color-accent-50);
    background-image: repeating-radial-gradient(
      circle at 50% 50%,
      oklch(from var(--color-accent-700) l c h / 0.18) 0 1px,
      transparent 1px 20px
    );
  }

  /* 04 · Origen — estratos horizontales (producción / origen) */
  .unidad__media--origen {
    background-color: var(--color-brand-tint);
    background-image: repeating-linear-gradient(
      180deg,
      oklch(from var(--color-brand-700) l c h / 0.12) 0 3px,
      transparent 3px 22px
    );
  }

  /* ── Texto ──────────────────────────────────────────────── */
  .unidad__body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
  }
  .unidad__nombre {
    font-size: var(--font-size-lg);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-snug);
  }
  .unidad__linea {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-snug);
    max-width: 34ch;
  }

  /* ── Modo revisión interna (?review) ─────────────────────
     Marca las unidades con copy en borrador. Invisible en producción:
     depende de un atributo que sólo pone el script de arriba. */
  :global(html[data-review]) .unidad[data-draft='true'] {
    outline: 2px dashed var(--color-warning);
    outline-offset: calc(-1 * var(--space-1));
  }
  :global(html[data-review]) .unidad[data-draft='true'] .unidad__body::after {
    content: var(--draft-label, '');
    justify-self: start;
    font-size: var(--font-size-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-on-accent);
    background: var(--color-warning);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-pill);
  }
</style>
