---
interface Props {
  showHead?: boolean;
}
const { showHead = true } = Astro.props;

/**
 * Unidades de negocio v2 — timeline copy comprimido.
 * Status visual por unidad: 'active', 'featured', 'development'.
 * Descripciones max ~14 palabras.
 */
const unidades = [
  { n: '01', title: 'Distribución B2B',
    desc: 'Negocio principal: gastronómicos y comercios con catálogo de alta rotación.',
    status: 'featured', badge: 'Principal' },
  { n: '02', title: 'Franquicias',
    desc: 'Formatos replicables bajo marca Qüem en nuevos mercados.',
    status: 'active', badge: 'Activo' },
  { n: '03', title: 'Corner Qüem',
    desc: 'Productos Qüem dentro de espacios comerciales existentes.',
    status: 'featured', badge: 'Destacado' },
  { n: '04', title: 'Logística de congelados',
    desc: 'Última milla AMBA y Provincia de Buenos Aires.',
    status: 'active', badge: null },
  { n: '05', title: 'Retail B2C',
    desc: 'Tiendas y venta directa al consumidor final.',
    status: 'active', badge: null },
  { n: '06', title: 'Tecnología / App',
    desc: 'Catálogo digital, pedidos y compra B2B en un canal.',
    status: 'active', badge: null },
  { n: '07', title: 'Fraccionamiento',
    desc: 'Formatos y presentaciones según necesidad comercial.',
    status: 'active', badge: null },
  { n: '08', title: 'Desarrolladora comercial',
    desc: 'Validamos y escalamos nuevos formatos del mercado.',
    status: 'active', badge: null },
  { n: '09', title: 'Representación de marcas',
    desc: 'Marcas en eventos, puntos de expendio y canales estratégicos.',
    status: 'development', badge: 'En desarrollo' },
] as const;
---

<section class="un section-y" id="unidades-de-negocio" aria-labelledby="un-title">
  <div class="container-content">
    {showHead && (
      <header class="un__head">
        <p class="eyebrow" data-reveal style="--reveal-y: 14px;">Unidades de negocio</p>
        <h2 id="un-title" class="un__title" data-reveal style="--reveal-delay: 100ms;">
          9 unidades comerciales. <em>Una sola operación.</em>
        </h2>
        <p class="un__lede" data-reveal style="--reveal-delay: 200ms;">
          Líneas que abastecen, distribuyen, representan y escalan productos congelados.
        </p>
      </header>
    )}

    <ol class="un__timeline" data-reveal-stagger>
      <div class="un__line" aria-hidden="true"></div>
      {unidades.map((u, i) => (
        <li class:list={['un-item', `un-item--${i % 2 === 0 ? 'left' : 'right'}`, `un-item--${u.status}`]} data-reveal>
          <div class="un-item__dot" aria-hidden="true">
            <span class="un-item__dot-inner"></span>
          </div>

          <div class="un-item__card">
            <div class="un-item__head">
              <span class="un-item__num" aria-hidden="true">{u.n}</span>
              {u.badge && (
                <span class:list={['un-item__badge', `un-item__badge--${u.status}`]}>{u.badge}</span>
              )}
            </div>
            <h3 class="un-item__title">{u.title}</h3>
            <p class="un-item__desc">{u.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .un__head { display: grid; gap: var(--space-3); margin-block-end: var(--space-8); max-width: 56ch; }
  .un__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
  }
  .un__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
  }
  .un__lede { color: var(--color-text-secondary); font-size: var(--font-size-md); line-height: var(--leading-snug); }

  .un__timeline {
    position: relative;
    display: grid;
    gap: var(--space-4);
  }
  .un__line { display: none; }
  @media (min-width: 960px) {
    .un__line {
      display: block;
      position: absolute;
      top: 0; bottom: 0; left: 50%;
      width: 2px;
      background: linear-gradient(180deg, transparent 0%, var(--color-border-strong) 8%, var(--color-border-strong) 92%, transparent 100%);
      transform: translateX(-50%);
      pointer-events: none;
    }
    .un__timeline { gap: var(--space-2); }
  }

  .un-item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
  }
  @media (min-width: 960px) {
    .un-item { grid-template-columns: 1fr auto 1fr; align-items: center; }
    .un-item--left .un-item__card { grid-column: 1; text-align: right; }
    .un-item--left .un-item__dot { grid-column: 2; }
    .un-item--right .un-item__dot { grid-column: 2; }
    .un-item--right .un-item__card { grid-column: 3; }
    .un-item--left .un-item__head { justify-content: flex-end; }
  }

  .un-item__dot {
    position: relative;
    width: 24px; height: 24px;
    display: grid; place-items: center;
    flex-shrink: 0;
    margin-block-start: 1rem;
    z-index: 1;
  }
  @media (min-width: 960px) { .un-item__dot { margin-block-start: 0; } }
  .un-item__dot::before {
    content: '';
    position: absolute; inset: 0;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-border-strong);
    transition: border-color var(--dur-fast), background var(--dur-fast);
  }
  .un-item__dot-inner {
    position: relative;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--color-border-strong);
    transition: background var(--dur-fast), transform var(--dur-fast);
  }
  .un-item--featured .un-item__dot::before { border-color: var(--color-brand-500); background: var(--color-brand-50); }
  .un-item--featured .un-item__dot-inner { background: var(--color-brand-500); }
  .un-item--development .un-item__dot::before { border-color: var(--color-text-muted); }
  .un-item--development .un-item__dot-inner { background: var(--color-text-muted); }
  .un-item:hover .un-item__dot::before { border-color: var(--color-brand-500); background: var(--color-brand-50); }
  .un-item:hover .un-item__dot-inner { background: var(--color-brand-500); transform: scale(1.5); }

  .un-item__card {
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    transition: transform var(--dur-fast), border-color var(--dur-fast), box-shadow var(--dur-normal);
  }
  .un-item__card:hover {
    transform: translateY(-2px);
    border-color: var(--color-brand-300);
    box-shadow: var(--shadow-card);
  }
  .un-item--featured .un-item__card {
    background: linear-gradient(180deg, oklch(from var(--color-brand-500) l c h / 0.04) 0%, var(--color-bg-elevated) 60%);
    border-color: oklch(from var(--color-brand-500) l c h / 0.18);
  }
  .un-item--development .un-item__card { opacity: 0.88; }

  .un-item__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-2);
    flex-wrap: wrap;
  }
  .un-item__num {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: var(--weight-extrabold);
    color: var(--color-text-brand);
    letter-spacing: -0.02em;
    background: var(--color-brand-50);
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius-sm);
  }
  .un-item__badge {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
  }
  .un-item__badge--featured {
    color: var(--color-brand-700);
    background: var(--color-brand-50);
    border: 1px solid oklch(from var(--color-brand-500) l c h / 0.25);
  }
  .un-item__badge--active {
    color: var(--color-accent-700);
    background: var(--color-accent-50);
    border: 1px solid oklch(from var(--color-accent-500) l c h / 0.2);
  }
  .un-item__badge--development {
    color: var(--color-text-muted);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-subtle);
  }

  .un-item__title {
    font-size: var(--font-size-lg);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-block-end: var(--space-2);
  }
  .un-item__desc {
    color: var(--color-text-secondary);
    line-height: var(--leading-snug);
    font-size: var(--font-size-sm);
  }
  @media (min-width: 960px) {
    .un-item--left .un-item__desc { margin-inline-start: auto; max-width: 36ch; }
    .un-item--right .un-item__desc { max-width: 36ch; }
  }
</style>
