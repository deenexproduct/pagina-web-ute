---
interface Props {
  showHead?: boolean;
}
const { showHead = true } = Astro.props;

/**
 * Unidades de negocio v3 — bento grid.
 * Desktop: 01 (span 2), 02-08 (1×1), 09 (full width horizontal).
 * Hierarchy: featured → brand/accent tint + top bar.
 *            development → dashed, muted, horizontal layout.
 */
const unidades = [
  {
    n: '01',
    title: 'Distribución B2B',
    desc: 'Canal principal. Gastronómicos y comercios con catálogo de alta rotación y logística incluida.',
    status: 'featured',
    badge: 'Canal principal',
  },
  {
    n: '02',
    title: 'Franquicias',
    desc: 'Formatos replicables bajo marca Qüem en nuevos mercados.',
    status: 'active',
    badge: null,
  },
  {
    n: '03',
    title: 'Corner Qüem',
    desc: 'Productos Qüem dentro de espacios comerciales existentes. Llave en mano.',
    status: 'featured',
    badge: 'Destacado',
  },
  {
    n: '04',
    title: 'Logística de congelados',
    desc: 'Última milla AMBA y Provincia de Buenos Aires.',
    status: 'active',
    badge: null,
  },
  {
    n: '05',
    title: 'Retail B2C',
    desc: 'Tiendas y venta directa al consumidor final.',
    status: 'active',
    badge: null,
  },
  {
    n: '06',
    title: 'Tecnología / App',
    desc: 'Catálogo digital, pedidos y compra B2B en un solo canal.',
    status: 'active',
    badge: null,
  },
  {
    n: '07',
    title: 'Fraccionamiento',
    desc: 'Formatos y presentaciones según necesidad comercial.',
    status: 'active',
    badge: null,
  },
  {
    n: '08',
    title: 'Desarrolladora comercial',
    desc: 'Validamos y escalamos nuevos formatos del mercado.',
    status: 'active',
    badge: null,
  },
  {
    n: '09',
    title: 'Representación de marcas',
    desc: 'Marcas en eventos, puntos de expendio y canales estratégicos.',
    status: 'development',
    badge: 'En desarrollo',
  },
];
---

<section
  class="un section-y"
  id="unidades-de-negocio"
  aria-labelledby="un-title"
  style="background: var(--color-surface-subtle);"
>
  <div class="container-content">

    {showHead && (
      <header class="un__head">
        <p class="eyebrow" data-reveal style="--reveal-y:12px;">Unidades de negocio</p>
        <h2 id="un-title" class="un__title" data-reveal style="--reveal-delay:80ms;">
          9 unidades comerciales.<br><em>Una sola operación.</em>
        </h2>
        <p class="un__lede" data-reveal style="--reveal-delay:180ms;">
          Líneas que abastecen, distribuyen, representan y escalan productos congelados.
        </p>
      </header>
    )}

    <ol class="un__grid" aria-label="Unidades de negocio Qüem Central">
      {unidades.map((u, i) => (
        <li
          class:list={['un-card', `un-card--${u.status}`]}
          data-reveal
          style={`--reveal-delay:${220 + i * 38}ms`}
        >
          <span class="un-card__watermark" aria-hidden="true">{u.n}</span>
          <div class="un-card__body">
            <div class="un-card__meta">
              <span class="un-card__num">{u.n}</span>
              {u.badge && (
                <span class:list={['un-card__badge', `un-card__badge--${u.status}`]}>
                  {u.badge}
                </span>
              )}
            </div>
            <h3 class="un-card__title">{u.title}</h3>
            <p class="un-card__desc">{u.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="un__cta" data-reveal style="--reveal-delay:600ms;">
      <a class="btn btn-primary" href="https://app.quem-central.com" target="_blank" rel="noopener">
        Empezar a comprar
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="btn btn-outline" href="#contacto">Hablar con ventas ↗</a>
    </div>

  </div>
</section>

<style>
/* ── CTA ─────────────────────────────────────── */
.un__cta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-block-start: var(--space-8);
}

/* ── Header ──────────────────────────────────── */
.un__head {
  max-width: 52ch;
  display: grid;
  gap: var(--space-3);
  margin-block-end: var(--space-10);
}
@media (max-width: 639px) {
  .un__head { margin-block-end: var(--space-6); }
}
.un__title {
  font-size: clamp(2.1rem, 4.5vw, var(--font-size-4xl));
  font-weight: var(--weight-extrabold);
  letter-spacing: var(--tracking-tighter);
  line-height: 1.0;
}
.un__title em {
  font-style: normal;
  background: var(--gradient-text-brand);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.un__lede {
  color: var(--color-text-secondary);
  font-size: var(--font-size-md);
  line-height: var(--leading-snug);
}

/* ── Bento grid ──────────────────────────────── */
.un__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-3);
  list-style: none;
  padding: 0;
  margin: 0;
}
@media (min-width: 600px) {
  .un__grid { grid-template-columns: repeat(2, 1fr); }
  .un-card:nth-child(1),
  .un-card:nth-child(9) { grid-column: 1 / -1; }
}
@media (min-width: 960px) {
  .un__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .un-card:nth-child(1) { grid-column: span 2; }
  .un-card:nth-child(9) { grid-column: 1 / -1; }
}

/* ── Card base ───────────────────────────────── */
.un-card {
  position: relative;
  overflow: hidden;
  background: var(--color-bg-elevated);
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-2xl);
  padding: var(--space-6);
  transition:
    transform 200ms var(--ease-standard),
    border-color 200ms var(--ease-standard),
    box-shadow 200ms var(--ease-standard);
}
.un-card:hover {
  transform: translateY(-3px);
  border-color: oklch(from var(--color-brand-500) l c h / 0.3);
  box-shadow: 0 10px 28px -6px oklch(from var(--color-brand-500) l c h / 0.1);
}

/* ── Watermark number ────────────────────────── */
.un-card__watermark {
  position: absolute;
  right: var(--space-4);
  bottom: -0.15em;
  font-family: var(--font-display);
  font-size: 6.5rem;
  font-weight: var(--weight-extrabold);
  letter-spacing: -0.05em;
  line-height: 1;
  color: var(--color-text-primary);
  opacity: 0.04;
  pointer-events: none;
  user-select: none;
  transition: opacity 200ms var(--ease-standard);
}
.un-card:hover .un-card__watermark { opacity: 0.08; }
.un-card:nth-child(1) .un-card__watermark { font-size: 9rem; }
.un-card:nth-child(9) .un-card__watermark { font-size: 8rem; }

/* ── Card body ───────────────────────────────── */
.un-card__body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.un-card__meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-block-end: var(--space-1);
}

/* ── Number chip ─────────────────────────────── */
.un-card__num {
  font-size: var(--font-size-xs);
  font-weight: var(--weight-extrabold);
  font-variant-numeric: tabular-nums;
  color: var(--color-text-brand);
  background: var(--color-brand-50);
  padding: 0.2rem 0.5rem;
  border-radius: var(--radius-sm);
  line-height: 1.5;
}

/* ── Badge ───────────────────────────────────── */
.un-card__badge {
  font-size: 0.64rem;
  font-weight: var(--weight-bold);
  text-transform: uppercase;
  letter-spacing: 0.07em;
  padding: 0.2rem 0.6rem;
  border-radius: var(--radius-pill);
}
.un-card__badge--featured {
  color: var(--color-brand-700);
  background: var(--color-brand-50);
  border: 1px solid oklch(from var(--color-brand-500) l c h / 0.2);
}
.un-card__badge--development {
  color: var(--color-text-muted);
  background: transparent;
  border: 1px solid var(--color-border-subtle);
}

/* ── Title & desc ────────────────────────────── */
.un-card__title {
  font-size: var(--font-size-lg);
  font-weight: var(--weight-bold);
  letter-spacing: -0.025em;
  line-height: 1.2;
  color: var(--color-text-primary);
}
.un-card__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: var(--leading-snug);
  max-width: 38ch;
}

/* ── Featured (01 + 03) ──────────────────────── */
.un-card--featured {
  background: linear-gradient(
    145deg,
    oklch(from var(--color-brand-500) l c h / 0.06) 0%,
    var(--color-bg-elevated) 58%
  );
  border-color: oklch(from var(--color-brand-500) l c h / 0.16);
}
.un-card--featured::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--color-brand-400), var(--color-brand-600));
}
.un-card--featured:hover {
  border-color: oklch(from var(--color-brand-500) l c h / 0.4);
  box-shadow: 0 12px 36px -8px oklch(from var(--color-brand-500) l c h / 0.15);
}

/* card 01 — bigger type */
.un-card:nth-child(1) .un-card__title { font-size: var(--font-size-xl); }
.un-card:nth-child(1) .un-card__desc  { font-size: var(--font-size-base); max-width: none; }

/* card 03 — accent green */
.un-card:nth-child(3) {
  background: linear-gradient(
    145deg,
    oklch(from var(--color-accent-500) l c h / 0.06) 0%,
    var(--color-bg-elevated) 58%
  );
  border-color: oklch(from var(--color-accent-500) l c h / 0.16);
}
.un-card:nth-child(3)::before {
  background: linear-gradient(90deg, var(--color-accent-400), var(--color-accent-600));
}
.un-card:nth-child(3):hover {
  border-color: oklch(from var(--color-accent-500) l c h / 0.38);
  box-shadow: 0 12px 36px -8px oklch(from var(--color-accent-500) l c h / 0.12);
}
.un-card:nth-child(3) .un-card__num {
  color: var(--color-accent-700);
  background: var(--color-accent-50);
}
.un-card:nth-child(3) .un-card__badge--featured {
  color: var(--color-accent-700);
  background: var(--color-accent-50);
  border-color: oklch(from var(--color-accent-500) l c h / 0.2);
}

/* ── Development (09) ────────────────────────── */
.un-card--development {
  background: transparent;
  border-style: dashed;
}
.un-card--development:hover {
  border-style: dashed;
  border-color: var(--color-border-strong);
  box-shadow: none;
  transform: none;
}
.un-card--development .un-card__num {
  background: var(--color-surface-subtle);
  color: var(--color-text-muted);
}
.un-card--development .un-card__title,
.un-card--development .un-card__desc { opacity: 0.72; }
.un-card--development .un-card__watermark { opacity: 0.025; }

/* 09 — horizontal on wide screens */
@media (min-width: 960px) {
  .un-card:nth-child(9) .un-card__body {
    flex-direction: row;
    align-items: center;
    gap: var(--space-8);
  }
  .un-card:nth-child(9) .un-card__meta  { margin-block-end: 0; flex-shrink: 0; }
  .un-card:nth-child(9) .un-card__title { flex-shrink: 0; font-size: var(--font-size-base); }
  .un-card:nth-child(9) .un-card__desc  { max-width: none; flex: 1; }
}
</style>
