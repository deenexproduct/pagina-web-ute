---
import { CATEGORIES, APP_BASE_URL, categoryUrl } from '../config/site';

interface Props {
  showHead?: boolean;
}
const { showHead = true } = Astro.props;
---

<section class="cats section-y" id="productos" aria-labelledby="cats-title">
  <div class="container-content">
    {showHead && (
      <header class="cats__head">
        <p class="eyebrow">05 · Categorías</p>
        <h2 id="cats-title" class="cats__title">Categorías de productos</h2>
        <p class="cats__lede">
          Explorá nuestras principales líneas de alimentos congelados y comprá online desde el catálogo digital de QUEM Central.
        </p>
      </header>
    )}

    <ul class="cats__grid" role="list">
      {CATEGORIES.map((cat) => (
        <li>
          <a class="cat-card" href={categoryUrl(cat)} target="_blank" rel="noopener" aria-label={`${cat.nombre} — abrir en app`}>
            <div class="cat-card__photo" aria-hidden="true">
              {cat.foto ? (
                <img src={cat.foto} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="cat-card__placeholder">{cat.nombre.charAt(0)}</span>
              )}
            </div>
            <div class="cat-card__meta">
              <span class="cat-card__name">{cat.nombre}</span>
              <span class="cat-card__arrow" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="cats__cta-row">
      <a class="btn btn-primary" href={APP_BASE_URL} target="_blank" rel="noopener">Ver catálogo completo</a>
    </div>
  </div>
</section>

<style>
  .cats__head { display: grid; gap: var(--space-3); margin-block-end: var(--space-6); max-width: 60ch; }
  .cats__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.1;
  }
  .cats__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-relaxed);
  }

  .cats__grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
  }

  .cat-card {
    display: block;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    transition: transform var(--dur-fast) var(--ease-standard),
                box-shadow var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard);
  }
  .cat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-brand-300);
  }
  .cat-card__photo {
    aspect-ratio: 4 / 3;
    background:
      linear-gradient(135deg, oklch(96% 0.005 240), oklch(92% 0.04 250 / 0.4));
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .cat-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }
  .cat-card:hover .cat-card__photo img { transform: scale(1.04); }
  .cat-card__placeholder {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: var(--weight-light);
    color: var(--color-brand-300);
    letter-spacing: -0.04em;
  }
  .cat-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4);
    gap: var(--space-3);
  }
  .cat-card__name {
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    font-size: var(--font-size-base);
  }
  .cat-card__arrow {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-subtle);
    color: var(--color-text-brand);
    transition: background-color var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard);
  }
  .cat-card:hover .cat-card__arrow {
    background-color: var(--color-brand-500);
    color: var(--color-text-on-brand);
  }

  .cats__cta-row {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-6);
  }
</style>
