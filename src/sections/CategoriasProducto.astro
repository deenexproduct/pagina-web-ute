---
import { CATEGORIES, APP_BASE_URL, categoryUrl } from '../config/site';

interface Props {
  showHead?: boolean;
}
const { showHead = true } = Astro.props;

/**
 * Categorías v2 — copy comprimido + grid mantenido.
 * Iconos custom + hue por categoría para tint del fondo.
 */
const ICONS: Record<string, { svg: string; hue: number }> = {
  bunuelos:     { svg: 'M14 5C10 5 7 8 7 12s3 7 7 7c1 0 2-.3 3-.8M14 5c3 0 6 2 7 5M14 5v3M9 12h3M14 17v3', hue: 35 },
  empanadas:    { svg: 'M5 14c0-5 4-9 9-9s9 4 9 9-4 9-9 9-9-4-9-9Zm5 0 4-4 4 4M9 16h10', hue: 38 },
  hamburguesas: { svg: 'M4 12h20M5 14c0 2 1 4 4 4h10c3 0 4-2 4-4M5 10c0-3 4-5 9-5s9 2 9 5', hue: 28 },
  frutas:       { svg: 'M14 5c2-2 6-1 6 3 0 4-3 9-6 13-3-4-6-9-6-13 0-4 4-5 6-3ZM14 5v3', hue: 18 },
  franui:       { svg: 'M14 4v6M9 10h10l-1 12H10L9 10Zm0 5h10M11 15v6M14 15v6M17 15v6', hue: 320 },
  postres:      { svg: 'M5 10h18l-1 10c0 1-1 2-2 2H8c-1 0-2-1-2-2L5 10Zm0 0c0-2 2-3 4-3h10c2 0 4 1 4 3M11 14v6M14 14v6M17 14v6', hue: 320 },
  pizzas:       { svg: 'M14 4 4 22h20L14 4Zm0 0v18m-4-7h8m-6 4h4', hue: 12 },
  pescados:     { svg: 'M3 14c4-6 10-6 14-3l5-3-1 6 1 6-5-3c-4 3-10 3-14-3Zm14 0h.01', hue: 200 },
  verduras:     { svg: 'M14 5c-1 0-3 .5-4 3 0 0-3-1-5 1-2 2-1 5-1 5s-1 2-1 4 2 4 5 4 5-2 5-2 2 2 5 2 5-2 5-4-1-4-1-4 1-3-1-5-5-1-5-1c-1-2-3-3-4-3Z', hue: 140 },
  rebozados:    { svg: 'M5 14c0-5 4-9 9-9s9 4 9 9-4 9-9 9-9-4-9-9Zm3-2 2 2M11 9l2 2M16 9l2 2M9 16l2-2M14 18l2-2M19 16l2-2', hue: 42 },
  tartas:       { svg: 'M4 16c0-4 4-8 10-8s10 4 10 8H4Zm0 0v3a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-3M9 14c-1-1-1-3 0-4M14 12V7M14 7c0-1 1-2 2-2', hue: 50 },
};
const fallback = { svg: 'M6 6h16v16H6V6Zm5 5h6v6h-6v-6Z', hue: 250 };
const iconFor = (slug: string) => ICONS[slug] ?? fallback;
---

<section class="cats section-y" id="productos" aria-labelledby="cats-title">
  <div class="container-content">
    {showHead && (
      <header class="cats__head">
        <p class="eyebrow" data-reveal style="--reveal-y: 16px;">Categorías</p>
        <h2 id="cats-title" class="cats__title" data-reveal style="--reveal-delay: 100ms;">
          11 categorías. <em>Un solo catálogo.</em>
        </h2>
        <p class="cats__lede" data-reveal style="--reveal-delay: 200ms;">
          Explorá las líneas de congelados y comprá online desde la app.
        </p>
      </header>
    )}

    <ul class="cats__grid" role="list" data-reveal-stagger>
      {CATEGORIES.map((cat) => {
        const icon = iconFor(cat.slug);
        return (
          <li data-reveal>
            <a class="cat-card" href={categoryUrl(cat)} target="_blank" rel="noopener" aria-label={`${cat.nombre}: abrir en app`}>
              <div
                class="cat-card__photo"
                aria-hidden="true"
                style={`--cat-hue: ${icon.hue};`}
              >
                {cat.foto ? (
                  <img src={cat.foto} alt="" loading="lazy" decoding="async" />
                ) : (
                  <svg class="cat-card__icon" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                    <path d={icon.svg} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </div>
              <div class="cat-card__meta">
                <span class="cat-card__name">{cat.nombre}</span>
                <span class="cat-card__arrow" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="cats__cta-row">
      <a class="btn btn-primary" href={APP_BASE_URL} target="_blank" rel="noopener">
        Ver catálogo completo
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .cats__head { display: grid; gap: var(--space-3); margin-block-end: var(--space-6); max-width: 56ch; }
  .cats__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
  }
  .cats__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cats__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
  }

  .cats__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
  }

  .cat-card {
    display: block;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    transition: transform var(--dur-fast), box-shadow var(--dur-normal), border-color var(--dur-fast);
  }
  .cat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-brand-300);
  }
  .cat-card__photo {
    aspect-ratio: 1 / 1;
    background:
      radial-gradient(circle at 70% 30%, oklch(95% 0.05 var(--cat-hue) / 0.8) 0%, transparent 60%),
      linear-gradient(135deg, oklch(98% 0.020 var(--cat-hue)) 0%, oklch(90% 0.060 var(--cat-hue)) 100%);
    display: grid;
    place-items: center;
    overflow: hidden;
    position: relative;
  }
  .cat-card__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, oklch(15% 0.018 240 / 0.04) 1px, transparent 1px);
    background-size: 12px 12px;
    mix-blend-mode: multiply;
    opacity: 0.5;
  }
  .cat-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }
  .cat-card:hover .cat-card__photo img { transform: scale(1.04); }

  .cat-card__icon {
    position: relative;
    z-index: 1;
    width: 50%;
    height: 50%;
    max-width: 4rem;
    max-height: 4rem;
    color: oklch(40% 0.14 var(--cat-hue));
    filter: drop-shadow(0 4px 8px oklch(40% 0.14 var(--cat-hue) / 0.18));
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .cat-card:hover .cat-card__icon { transform: scale(1.08) rotate(-2deg); }

  .cat-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    gap: var(--space-3);
  }
  .cat-card__name {
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    letter-spacing: -0.01em;
  }
  .cat-card__arrow {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-subtle);
    color: var(--color-text-brand);
    transition: background-color var(--dur-fast), color var(--dur-fast), transform var(--dur-fast);
  }
  .cat-card:hover .cat-card__arrow {
    background-color: var(--color-brand-500);
    color: var(--color-text-on-brand);
    transform: translate(2px, -2px);
  }

  .cats__cta-row {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-7);
  }
</style>
