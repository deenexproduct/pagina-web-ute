---
interface Props {
  showHead?: boolean;
}
const { showHead = true } = Astro.props;

/**
 * Franquicias v2 — copy comprimido a 1 frase lede + 3 cards con desc cortas.
 */
const cards = [
  { title: 'Franquicias', desc: 'Unidades comerciales con identidad Qüem Central.', icon: 'store', featured: true, accent: false },
  { title: 'Corner Qüem', desc: 'Producto congelado dentro de espacios comerciales existentes.', icon: 'corner', featured: false, accent: true },
  { title: 'Alianzas comerciales', desc: 'Marcas que necesitan capilaridad y distribución.', icon: 'handshake', featured: false, accent: false },
] as const;
---

<section class="franq section-y" id="franquicias" aria-labelledby="franq-title">
  <div class="container-content">
    {showHead && (
      <header class="franq__head">
        <p class="eyebrow" data-reveal style="--reveal-y: 16px;">Franquicias y expansión</p>
        <h2 id="franq-title" class="franq__title" data-reveal style="--reveal-delay: 100ms;">
          3 formatos para <em>crecer con Qüem</em>.
        </h2>
        <p class="franq__lede" data-reveal style="--reveal-delay: 200ms;">
          Modelos para escalar la marca en nuevos mercados.
        </p>
      </header>
    )}

    <div class="franq__grid" data-reveal-stagger>
      {cards.map((c) => (
        <article class:list={['franq-card', c.featured && 'franq-card--featured', c.accent && 'franq-card--accent']} data-reveal>
          <div class="franq-card__icon" aria-hidden="true">
            {c.icon === 'store' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M4 11h20l-2-6H6l-2 6Z" stroke="currentColor" stroke-width="1.8"/><path d="M5 11v12h18V11" stroke="currentColor" stroke-width="1.8"/><path d="M10 23v-6h8v6" stroke="currentColor" stroke-width="1.8"/></svg>
            )}
            {c.icon === 'corner' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="M4 22V8l9-3 11 4v13" stroke="currentColor" stroke-width="1.8"/><path d="M9 22v-7h6v7M19 22v-4h2v4" stroke="currentColor" stroke-width="1.8"/></svg>
            )}
            {c.icon === 'handshake' && (
              <svg viewBox="0 0 28 28" fill="none"><path d="m4 16 4-5 6 5-3 3-7-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 16 9 21l3 2 4-4M14 16l5-5 5 5-4 5-3-2-3-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            )}
          </div>
          <h3>{c.title}</h3>
          <p>{c.desc}</p>
          <span class="franq-card__arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .franq {
    background:
      radial-gradient(55% 60% at 100% 100%, oklch(62% 0.150 155 / 0.07) 0%, transparent 65%),
      radial-gradient(40% 40% at 0% 0%, oklch(58% 0.155 254 / 0.05) 0%, transparent 65%),
      var(--color-bg);
  }

  .franq__head { display: grid; gap: var(--space-3); margin-block-end: var(--space-7); max-width: 56ch; }
  .franq__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
  }
  .franq__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .franq__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
  }

  .franq__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .franq-card {
    position: relative;
    padding: var(--space-6);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    transition: transform var(--dur-fast), border-color var(--dur-fast), box-shadow var(--dur-normal);
    overflow: hidden;
  }
  .franq-card::after {
    content: '';
    position: absolute;
    inset: auto auto 0 0;
    width: 100%;
    height: 0;
    background: var(--gradient-brand);
    opacity: 0;
    transition: height var(--dur-normal), opacity var(--dur-normal);
  }
  .franq-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-brand-300);
    box-shadow: var(--shadow-card);
  }
  .franq-card:hover::after { height: 3px; opacity: 1; }

  /* FR2: Featured Franquicias card */
  .franq-card--featured {
    background: linear-gradient(180deg, var(--color-brand-50) 0%, var(--color-bg-elevated) 70%);
    border-color: oklch(from var(--color-brand-500) l c h / 0.30);
  }
  .franq-card--featured::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--gradient-brand);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  }
  .franq-card--featured h3 {
    color: var(--color-text-brand);
  }

  .franq-card__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-brand-50), var(--color-bg));
    border: 1px solid var(--color-brand-100);
    color: var(--color-brand-600);
    margin-block-end: var(--space-4);
    transition: background var(--dur-fast), color var(--dur-fast), transform var(--dur-fast);
  }
  .franq-card:hover .franq-card__icon {
    background: var(--gradient-brand);
    color: var(--color-text-on-brand);
    border-color: transparent;
    transform: scale(1.05);
  }
  .franq-card__icon svg { width: 1.7rem; height: 1.7rem; }
  .franq-card h3 {
    font-size: var(--font-size-lg);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    margin-block-end: var(--space-2);
  }
  .franq-card p {
    color: var(--color-text-secondary);
    line-height: var(--leading-snug);
    font-size: var(--font-size-sm);
  }
  .franq-card__arrow {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    display: grid;
    place-items: center;
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    transition: background var(--dur-fast), color var(--dur-fast), transform var(--dur-fast);
  }
  .franq-card:hover .franq-card__arrow {
    background: var(--color-brand-500);
    color: var(--color-text-on-brand);
    transform: translate(2px, -2px);
  }

  /* FR3: Corner Qüem accent card — verde accent */
  .franq-card--accent {
    background: linear-gradient(180deg, oklch(from var(--color-accent-500) l c h / 0.07) 0%, var(--color-bg-elevated) 70%);
    border-color: oklch(from var(--color-accent-500) l c h / 0.25);
  }
  .franq-card--accent::before {
    background: linear-gradient(90deg, var(--color-accent-500), oklch(from var(--color-accent-500) l c h / 0.6));
  }
  .franq-card--accent h3 {
    color: var(--color-accent-700);
  }
  .franq-card--accent .franq-card__icon {
    background: linear-gradient(135deg, oklch(from var(--color-accent-500) l c h / 0.12), var(--color-bg));
    color: var(--color-accent-600);
    border-color: oklch(from var(--color-accent-500) l c h / 0.2);
  }
  .franq-card--accent:hover {
    border-color: var(--color-accent-400);
  }
  .franq-card--accent:hover .franq-card__icon {
    background: linear-gradient(135deg, var(--color-accent-500), var(--color-accent-400));
    color: white;
    border-color: transparent;
  }

</style>
