---
import { link } from '../config/site';

/**
 * Plataforma v3 — video showcase (reemplaza mockup de phone con video real
 * heredado del sitio UTE). Autoplay + muted + loop = no requiere interacción
 * del usuario, no rompe accesibilidad.
 */
const mensajes = [
  'Precio fijo visible. Stock en tiempo real.',
  'Pedido confirmado en segundos — sin llamadas',
  'Seguimiento desde el despacho hasta la entrega',
  'Reposición programada cuando más la necesitás',
];
---

<section class="plat section-y" id="plataforma" aria-labelledby="plat-title">
  <div class="container-content plat__inner">
    <div class="plat__copy">
      <p class="eyebrow" data-reveal style="--reveal-y: 16px;">Plataforma</p>
      <h2 id="plat-title" class="plat__title" data-reveal style="--reveal-delay: 100ms;">
        Del pedido a la entrega, <em>sin fricción.</em>
      </h2>
      <p data-reveal style="--reveal-delay: 200ms;">
        Precio listado, stock visible, confirmación al instante. Sin negociar, sin llamar, sin esperar.
      </p>

      <ul class="plat__list" data-reveal-stagger>
        {mensajes.map((m) => (
          <li data-reveal style="--reveal-y: 12px;">
            <span class="plat__check" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="m3 7 3 3 5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>{m}</span>
          </li>
        ))}
      </ul>

      <a class="plat__next" href={link('/#productos')} data-reveal style="--reveal-delay: 400ms;">
        Ver el catálogo
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <div class="plat__video-wrap" data-reveal="right" style="--reveal-delay: 200ms; --reveal-duration: 1000ms;">
      <div class="plat__video-frame">
        {/*
          Video lazy-loaded: arranca con preload="none" + data-src,
          y el script abajo lo carga + reproduce cuando entra al viewport.
          Esto baja el TTFB inicial de la home de 15MB → 0.
        */}
        <video
          class="plat__video"
          data-lazy-video
          data-src={link('/video/hero.mp4')}
          poster={link('/video/hero-poster.jpg')}
          muted
          loop
          playsinline
          preload="none"
          aria-label="Demo del modelo operativo Qüem Central"
        ></video>
        <div class="plat__video-overlay" aria-hidden="true"></div>
        <div class="plat__video-badge" aria-hidden="true">
          <span class="plat__video-badge-dot"></span>
          Demo
        </div>
        {/*
          Botón play visible si autoplay fue rechazado (iOS low-power mode,
          Safari, Chrome con autoplay block, etc.). El script lo muestra
          on-demand. Por default está hidden.
        */}
        <button
          type="button"
          class="plat__video-play"
          data-video-play
          aria-label="Reproducir video"
          hidden
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        </button>
      </div>
      <div class="plat__video-glow" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  /**
   * Lazy-load del video de plataforma.
   *
   * Por qué: el .mp4 pesa ~15MB. Cargarlo on-page-load penaliza mobile 3G
   * y consume datos del usuario. Lo hacemos solo cuando el wrap entra al
   * viewport (con rootMargin para anticipar la carga ~200px antes).
   *
   * Fallback: si IntersectionObserver no existe, cargamos directo.
   */
  const lazyVideos = document.querySelectorAll<HTMLVideoElement>('[data-lazy-video]');

  const loadVideo = (v: HTMLVideoElement): void => {
    const src = v.dataset.src;
    if (!src || v.src) return;
    v.src = src;
    v.load();

    // Si autoplay falla (iOS low-power, Safari, etc.) mostramos un botón
    // play visible. El usuario hace click y reproducimos manualmente.
    v.play().catch(() => {
      const frame = v.closest('.plat__video-frame');
      const playBtn = frame?.querySelector<HTMLButtonElement>('[data-video-play]');
      if (playBtn) {
        playBtn.hidden = false;
        playBtn.addEventListener(
          'click',
          () => {
            v.play().catch(() => {});
            playBtn.hidden = true;
          },
          { once: true },
        );
      }
    });
  };

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadVideo(entry.target as HTMLVideoElement);
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '200px 0px', threshold: 0.01 },
    );
    lazyVideos.forEach((v) => io.observe(v));
  } else {
    // Sin IO support → cargar directo (browsers viejos)
    lazyVideos.forEach(loadVideo);
  }
</script>

<style>
  .plat {
    background: linear-gradient(180deg, var(--color-bg), var(--color-surface-subtle));
  }
  .plat__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 960px) {
    .plat__inner { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
  }
  .plat__copy { display: grid; gap: var(--space-4); max-width: 56ch; }
  .plat__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
    margin-block-end: var(--space-2);
  }
  .plat__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .plat__copy p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
  }

  .plat__list { display: grid; gap: var(--space-2); margin-block-start: var(--space-3); }
  .plat__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    line-height: var(--leading-snug);
  }
  .plat__check {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-100);
    color: var(--color-accent-700);
  }
  /* CTA discreto que cierra la sección y empuja a Categorías */
  .plat__next {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: var(--space-4);
    padding-block: 0.45rem;
    color: var(--color-text-brand);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    border-bottom: 1.5px solid transparent;
    width: max-content;
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }
  .plat__next svg { transition: transform var(--dur-fast); }
  .plat__next:hover {
    color: var(--color-text-primary);
    border-color: var(--color-brand-500);
  }
  .plat__next:hover svg { transform: translateX(3px); }

  /* ===== Video showcase ===================================== */
  .plat__video-wrap {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: var(--space-5);
    isolation: isolate;
  }

  .plat__video-frame {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 32rem;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: var(--color-brand-900);
    border: 1px solid var(--color-border-subtle);
    box-shadow:
      0 1px 0 oklch(100% 0 0 / 0.06) inset,
      var(--shadow-xl),
      0 0 0 8px var(--color-bg-elevated);
  }

  .plat__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Overlay sutil para integrar el video con la paleta */
  .plat__video-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 60%, oklch(22% 0.018 95 / 0.25) 100%);
    mix-blend-mode: multiply;
  }

  /* Badge "En vivo" */
  .plat__video-badge {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    background: oklch(15% 0.018 95 / 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: oklch(100% 0 0);
    font-size: var(--font-size-2xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    border-radius: var(--radius-pill);
    border: 1px solid oklch(100% 0 0 / 0.15);
  }
  .plat__video-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent-500);
    box-shadow: 0 0 8px oklch(88% 0.115 105 / 0.6);
    animation: plat-badge-pulse 2s ease-in-out infinite;
  }
  @keyframes plat-badge-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 oklch(88% 0.115 105 / 0.7); }
    50%      { opacity: 0.7; box-shadow: 0 0 0 6px oklch(88% 0.115 105 / 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .plat__video-badge-dot { animation: none; }
  }

  /* Botón play fallback — visible si autoplay rechazado */
  .plat__video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: oklch(100% 0 0 / 0.9);
    color: var(--color-brand-700);
    border: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow:
      0 8px 24px oklch(15% 0.018 95 / 0.30),
      0 0 0 4px oklch(100% 0 0 / 0.15);
    transition: transform var(--dur-fast), background var(--dur-fast);
    z-index: 2;
  }
  .plat__video-play:hover {
    transform: translate(-50%, -50%) scale(1.06);
    background: oklch(100% 0 0 / 1);
  }
  .plat__video-play svg {
    margin-left: 3px; /* ajuste óptico — el triángulo se ve mejor offset */
  }

  .plat__video-glow {
    position: absolute;
    inset: 10% -8% -8% 10%;
    z-index: 0;
    border-radius: 2.5rem;
    background: var(--gradient-mixed);
    filter: blur(50px);
    opacity: 0.30;
  }
</style>
