---
/**
 * Plataforma v2 — ángulo "experiencia de compra B2B", no catálogo
 * (el catálogo ya se muestra en CategoriasProducto).
 */
const mensajes = [
  'Precio fijo visible. Stock en tiempo real.',
  'Pedido confirmado en segundos — sin llamadas',
  'Seguimiento desde el despacho hasta la entrega',
  'Reposición programada cuando más la necesitás',
];
---

<section class="plat section-y" aria-labelledby="plat-title">
  <div class="container-content plat__inner">
    <div class="plat__copy">
      <p class="eyebrow" data-reveal style="--reveal-y: 16px;">Plataforma</p>
      <h2 id="plat-title" class="plat__title" data-reveal style="--reveal-delay: 100ms;">
        Del pedido a la entrega, <em>sin fricción.</em>
      </h2>
      <p data-reveal style="--reveal-delay: 200ms;">
        Precio listado, stock visible, confirmación al instante. Sin negociar, sin llamar, sin esperar.
      </p>

      <ul class="plat__list" data-reveal-stagger>
        {mensajes.map((m) => (
          <li data-reveal style="--reveal-y: 12px;">
            <span class="plat__check" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="m3 7 3 3 5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>{m}</span>
          </li>
        ))}
      </ul>

    </div>

    <div class="plat__phone-wrap" aria-hidden="true" data-reveal="right" style="--reveal-delay: 200ms; --reveal-duration: 1000ms;">
      <div class="plat__phone">
        <div class="plat__phone-notch"></div>
        <div class="plat__phone-screen">
          <div class="plat__device-header">
            <div class="plat__device-logo">Qüem Central</div>
            <div class="plat__device-pill">B2B</div>
          </div>
          <p class="plat__screen-label">Pedido #1 · Confirmado</p>
          <div class="plat__device-order">
            <div class="plat__order-row">
              <span class="plat__order-name">Empanadas · 20 u.</span>
              <span class="plat__order-check">✓</span>
            </div>
            <div class="plat__order-row">
              <span class="plat__order-name">Hamburguesas · 12 u.</span>
              <span class="plat__order-check">✓</span>
            </div>
            <div class="plat__order-row plat__order-row--logistics">
              <span class="plat__order-name">Logística incluida</span>
              <span class="plat__order-check">✓</span>
            </div>
          </div>
          <div class="plat__device-cta">Entrega: jueves · 15:00 →</div>
        </div>
        <div class="plat__phone-bar"></div>
      </div>
      <div class="plat__device-glow" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .plat {
    background: linear-gradient(180deg, var(--color-bg), var(--color-surface-subtle));
  }
  .plat__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 960px) {
    .plat__inner { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
  }
  .plat__copy { display: grid; gap: var(--space-4); max-width: 56ch; }
  .plat__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
    margin-block-end: var(--space-2);
  }
  .plat__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .plat__copy p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
  }

  .plat__list { display: grid; gap: var(--space-2); margin-block-start: var(--space-3); }
  .plat__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    line-height: var(--leading-snug);
  }
  .plat__check {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-100);
    color: var(--color-accent-700);
  }
  /* PL2: Mobile phone mockup */
  .plat__phone-wrap {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: var(--space-5);
  }
  .plat__phone {
    position: relative;
    z-index: 1;
    width: min(18rem, 100%);
    background: var(--color-bg-elevated);
    border-radius: 2.5rem;
    border: 2px solid var(--color-border-strong);
    box-shadow: var(--shadow-xl), 0 0 0 6px var(--color-surface-subtle);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .plat__phone-notch {
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-elevated);
  }
  .plat__phone-notch::after {
    content: '';
    width: 5rem;
    height: 0.75rem;
    border-radius: 999px;
    background: var(--color-border-strong);
  }
  .plat__phone-screen { padding: var(--space-4); display: grid; gap: var(--space-3); }
  .plat__device-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .plat__device-logo {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
  }
  .plat__device-pill {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand-500);
    color: var(--color-text-on-brand);
    font-weight: var(--weight-semibold);
  }
  .plat__device-order {
    display: grid;
    gap: 0.4rem;
  }
  .plat__order-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.8rem;
    background: var(--color-surface-subtle);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
  }
  .plat__order-name { color: var(--color-text-primary); }
  .plat__order-check {
    color: var(--color-accent-600);
    font-weight: var(--weight-bold);
    font-size: var(--font-size-xs);
  }
  .plat__order-row--logistics .plat__order-name {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }
  .plat__device-cta {
    text-align: center;
    padding: 0.9rem;
    background: var(--color-brand-500);
    color: var(--color-text-on-brand);
    border-radius: var(--radius-md);
    font-weight: var(--weight-semibold);
    font-size: var(--font-size-sm);
  }

  .plat__phone-bar {
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-elevated);
  }
  .plat__phone-bar::after {
    content: '';
    width: 4rem;
    height: 0.3rem;
    border-radius: 999px;
    background: var(--color-border-strong);
  }
  .plat__screen-label {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
  }

  .plat__device-glow {
    position: absolute;
    inset: 10% -10% -10% 10%;
    z-index: 0;
    border-radius: 2.5rem;
    background: linear-gradient(135deg, var(--color-brand-200) 0%, var(--color-accent-200) 100%);
    filter: blur(50px);
    opacity: 0.45;
  }
</style>
