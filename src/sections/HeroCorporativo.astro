---
import { APP_BASE_URL, link } from '../config/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>

  <div class="hero__inner container-content">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">
        <span class="eyebrow__dot" aria-hidden="true"></span>
        Plataforma integral · alimentos congelados
      </p>

      <h1 id="hero-title" class="hero__title">
        QUEM<span class="hero__title-em"> Central</span>
      </h1>

      <p class="hero__subtitle">
        Plataforma integral para el abastecimiento y desarrollo comercial de alimentos congelados.
      </p>

      <p class="hero__lede">
        Integramos distribución B2B, logística especializada, franquicias, corners comerciales y tecnología
        para conectar productos congelados con negocios gastronómicos, comercios y nuevos canales de venta.
      </p>

      <div class="hero__cta-row">
        <a class="btn btn-primary hero__cta-primary" href={APP_BASE_URL} target="_blank" rel="noopener">
          Comprar online
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="btn btn-outline" href="#quem-central">
          Conocer QUEM Central
        </a>
      </div>

      <ul class="hero__chips" aria-label="Capacidades clave">
        <li>Distribución B2B</li>
        <li>Logística especializada</li>
        <li>Franquicias y Corners</li>
        <li>Catálogo digital</li>
      </ul>
    </div>

    <aside class="hero__panel" aria-hidden="true">
      <div class="hero__panel-frame">
        <div class="hero__panel-grid">
          <div class="hero__stat hero__stat--lg">
            <div class="hero__stat-label">Cobertura logística</div>
            <div class="hero__stat-value">AMBA + PBA</div>
            <div class="hero__stat-meta">última milla congelados</div>
          </div>

          <div class="hero__stat">
            <div class="hero__stat-icon" data-tone="brand">
              <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18M8 14h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </div>
            <div class="hero__stat-label">Catálogo</div>
            <div class="hero__stat-value">Digital · App</div>
          </div>

          <div class="hero__stat">
            <div class="hero__stat-icon" data-tone="accent">
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 19V8l8-4 8 4v11" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 19v-6h6v6" stroke="currentColor" stroke-width="1.6"/></svg>
            </div>
            <div class="hero__stat-label">Modelos</div>
            <div class="hero__stat-value">Franquicia · Corner</div>
          </div>

          <div class="hero__stat hero__stat--accent">
            <div class="hero__stat-pill">CTA principal</div>
            <div class="hero__stat-value">Compra B2B</div>
            <div class="hero__stat-meta">desde un único canal</div>
          </div>
        </div>

        <div class="hero__panel-foot">
          <div class="hero__panel-tag">QUEM · Central</div>
          <div class="hero__panel-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </div>
      </div>

      <div class="hero__panel-shadow" aria-hidden="true"></div>
    </aside>
  </div>

  <a href="#quem-central" class="hero__scroll-hint" aria-label="Ir a la sección Qué es QUEM Central">
    <span>Conocé el ecosistema</span>
    <svg width="14" height="20" viewBox="0 0 14 20" fill="none" aria-hidden="true"><path d="M7 2v14m0 0-4-4m4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 5vw, 5.5rem) clamp(2.5rem, 4vw, 4rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 60% at 90% 0%, oklch(58% 0.155 254 / 0.10) 0%, transparent 70%),
      radial-gradient(50% 50% at 0% 100%, oklch(62% 0.150 155 / 0.07) 0%, transparent 70%),
      linear-gradient(180deg, var(--color-bg) 0%, var(--color-brand-tint) 100%);
  }
  .hero__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, oklch(42% 0.190 252 / 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(180deg, transparent 0%, black 30%, black 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 30%, black 70%, transparent 100%);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero__inner { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--space-8); }
  }

  /* eyebrow con dot lateral */
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: oklch(from var(--color-brand-500) l c h / 0.08);
    padding: 0.4rem 0.85rem 0.4rem 0.6rem;
    border-radius: var(--radius-pill);
    color: var(--color-text-brand);
    border: 1px solid oklch(from var(--color-brand-500) l c h / 0.15);
  }
  .eyebrow__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent-500);
    box-shadow: 0 0 0 4px oklch(62% 0.150 155 / 0.18);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px oklch(62% 0.150 155 / 0.18); }
    50%      { box-shadow: 0 0 0 7px oklch(62% 0.150 155 / 0.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .eyebrow__dot { animation: none; }
  }

  .hero__title {
    font-size: var(--font-size-display);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-weight: var(--weight-extrabold);
    margin-block: var(--space-5) var(--space-3);
    color: var(--color-text-primary);
    text-wrap: balance;
  }
  .hero__title-em {
    background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-700) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: var(--weight-extrabold);
  }

  .hero__subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-primary);
    line-height: var(--leading-snug);
    font-weight: var(--weight-medium);
    max-width: 30ch;
    margin-block-end: var(--space-4);
  }

  .hero__lede {
    max-width: 52ch;
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--leading-relaxed);
    margin-block-end: var(--space-6);
  }

  .hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-end: var(--space-7);
  }
  .hero__cta-primary { padding-inline: 1.5rem; padding-block: 0.95rem; font-size: var(--font-size-sm); }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .hero__chips li {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    font-weight: var(--weight-medium);
  }

  /* Panel lateral */
  .hero__panel { position: relative; }
  .hero__panel-frame {
    position: relative;
    z-index: 1;
    padding: var(--space-5);
    border-radius: 1.5rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(4px);
  }
  .hero__panel-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .hero__stat {
    padding: var(--space-4);
    border-radius: 0.9rem;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-subtle);
    display: grid;
    gap: 0.35rem;
    align-content: start;
    min-height: 120px;
  }
  .hero__stat--lg {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-700) 100%);
    color: var(--color-text-on-brand);
    border-color: transparent;
    padding: var(--space-5);
    min-height: 0;
  }
  .hero__stat--accent {
    background: linear-gradient(135deg, var(--color-accent-500) 0%, var(--color-accent-700) 100%);
    color: var(--color-text-on-accent);
    border-color: transparent;
  }
  .hero__stat-label {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
  }
  .hero__stat--lg .hero__stat-label,
  .hero__stat--accent .hero__stat-label {
    color: oklch(100% 0 0 / 0.78);
  }

  .hero__stat-value {
    font-family: var(--font-display);
    font-size: var(--font-size-md);
    font-weight: var(--weight-bold);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }
  .hero__stat--lg .hero__stat-value,
  .hero__stat--accent .hero__stat-value { color: currentColor; font-size: var(--font-size-xl); }

  .hero__stat-meta {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }
  .hero__stat--lg .hero__stat-meta,
  .hero__stat--accent .hero__stat-meta { color: oklch(100% 0 0 / 0.72); }

  .hero__stat-icon {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.6rem;
    display: grid;
    place-items: center;
    margin-block-end: 0.5rem;
  }
  .hero__stat-icon[data-tone="brand"] { color: var(--color-brand-600); background: var(--color-brand-50); }
  .hero__stat-icon[data-tone="accent"] { color: var(--color-accent-700); background: var(--color-accent-50); }
  .hero__stat-icon svg { width: 1.2rem; height: 1.2rem; }

  .hero__stat-pill {
    align-self: start;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    background: oklch(100% 0 0 / 0.22);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-semibold);
    width: max-content;
  }

  .hero__panel-foot {
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .hero__panel-tag {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
  }
  .hero__panel-dots { display: flex; gap: 0.3rem; }
  .hero__panel-dots span {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-border-strong);
  }
  .hero__panel-dots span:first-child { background: var(--color-accent-500); }

  .hero__panel-shadow {
    position: absolute;
    inset: 12% -8% -10% 8%;
    z-index: 0;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, var(--color-brand-100) 0%, var(--color-accent-100) 100%);
    filter: blur(40px);
    opacity: 0.6;
  }

  /* Scroll hint */
  .hero__scroll-hint {
    display: none;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-semibold);
  }
  .hero__scroll-hint:hover { color: var(--color-text-primary); }
  .hero__scroll-hint svg { animation: scroll-bounce 2s ease-in-out infinite; }
  @keyframes scroll-bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-hint svg { animation: none; }
  }
  @media (min-width: 960px) {
    .hero__scroll-hint {
      display: inline-flex;
      position: absolute;
      bottom: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
