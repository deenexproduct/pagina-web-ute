---
import { APP_BASE_URL, CATEGORIES } from '../config/site';

/**
 * Hero v2 — Dirección "Promesa + entrada a la app".
 *
 * Reglas de la versión:
 *  - Una sola promesa fuerte en title.
 *  - Subtitle = una línea dot-separated.
 *  - UNA sola CTA primaria dominante + 1 link discreto.
 *  - Visual = phone mockup grande con preview real de la app
 *    (categorías reales del config). Floating con animación sutil.
 *  - Sin chips, sin bars chart, sin sub-grid cargado.
 *
 * Objetivo: conversión al click "Comprar online" → app.
 */

/* 6 categorías visibles en el preview de la app — mix balanceado. */
const previewCategories = [
  { slug: 'empanadas',    nombre: 'Empanadas',    hue: 38 },
  { slug: 'hamburguesas', nombre: 'Hamburguesas', hue: 28 },
  { slug: 'pizzas',       nombre: 'Pizzas',       hue: 12 },
  { slug: 'postres',      nombre: 'Postres',      hue: 320 },
  { slug: 'frutas',       nombre: 'Frutas',       hue: 18 },
  { slug: 'pescados',     nombre: 'Pescados',     hue: 200 },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__bg-mesh" data-parallax="0.15"></div>
    <div class="hero__bg-dots"></div>
    <div class="hero__bg-orb hero__bg-orb--brand" data-parallax="0.25"></div>
    <div class="hero__bg-orb hero__bg-orb--accent" data-parallax="0.35"></div>
  </div>

  <div class="hero__inner container-content">
    <!-- COPY -->
    <div class="hero__copy">
      <p class="hero__brand-tag" data-reveal="fade" style="--reveal-delay: 100ms;">
        <span class="hero__brand-mark" aria-hidden="true">Q</span>
        <span>Qüem Central</span>
      </p>

      <h1 id="hero-title" class="hero__title">
        <span class="hero__title-line" data-reveal style="--reveal-delay: 250ms; --reveal-duration: 800ms;">Comprá alimentos</span>
        <span class="hero__title-line hero__title-line--gradient" data-reveal style="--reveal-delay: 400ms; --reveal-duration: 800ms;">congelados</span>
        <span class="hero__title-line" data-reveal style="--reveal-delay: 550ms; --reveal-duration: 800ms;">con un click.</span>
      </h1>

      <p class="hero__meta" data-reveal style="--reveal-delay: 800ms;">
        <span>Catálogo digital B2B</span>
        <span class="hero__meta-dot" aria-hidden="true">·</span>
        <span>Logística incluida</span>
        <span class="hero__meta-dot" aria-hidden="true">·</span>
        <span>AMBA + PBA</span>
      </p>

      <div class="hero__actions" data-reveal style="--reveal-delay: 950ms;">
        <a class="hero__cta-main" href={APP_BASE_URL} target="_blank" rel="noopener">
          <span class="hero__cta-main-text">Comprar online</span>
          <span class="hero__cta-main-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 12 12 4M12 4H6M12 4v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="hero__cta-main-shine" aria-hidden="true"></span>
        </a>
        <a class="hero__cta-alt" href="#contacto">
          Hablar con ventas
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- PHONE MOCKUP -->
    <aside class="hero__phone" aria-hidden="true" data-reveal="right" style="--reveal-delay: 600ms; --reveal-duration: 1100ms;">
      <div class="hero__phone-glow"></div>

      <div class="hero__phone-device">
        <!-- Dynamic island -->
        <div class="hero__phone-island" aria-hidden="true"></div>

        <!-- Status bar -->
        <div class="hero__phone-status">
          <span class="hero__phone-status-time">9:41</span>
          <span class="hero__phone-status-icons">
            <svg width="16" height="11" viewBox="0 0 16 11" fill="none"><path d="M1 7h2v3H1zM5 5h2v5H5zM9 3h2v7H9zM13 1h2v9h-2z" fill="currentColor"/></svg>
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M7 2.5c1.5 0 2.9.5 4 1.5l1.4-1.4C10.9 1.1 9 0.5 7 0.5S3.1 1.1 1.6 2.6L3 4c1.1-1 2.5-1.5 4-1.5Z" fill="currentColor"/><circle cx="7" cy="8" r="1.5" fill="currentColor"/></svg>
            <svg width="22" height="10" viewBox="0 0 22 10" fill="none"><rect x="0.5" y="0.5" width="18" height="9" rx="2" stroke="currentColor"/><rect x="2" y="2" width="14" height="6" rx="1" fill="currentColor"/><rect x="19.5" y="3.5" width="1.5" height="3" rx="0.5" fill="currentColor"/></svg>
          </span>
        </div>

        <!-- App screen -->
        <div class="hero__phone-screen">
          <!-- App header -->
          <header class="hero__phone-header">
            <div class="hero__phone-header-brand">
              <span class="hero__phone-header-mark">Q</span>
              <span class="hero__phone-header-name">Qüem</span>
            </div>
            <span class="hero__phone-header-cart" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M2 3h2l2 9h10l2-7H5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                <circle cx="7" cy="15" r="1.2" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="14" cy="15" r="1.2" stroke="currentColor" stroke-width="1.6"/>
              </svg>
              <span class="hero__phone-header-cart-dot"></span>
            </span>
          </header>

          <!-- Search bar -->
          <div class="hero__phone-search">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.4"/><path d="m12.5 12.5-3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            <span>Buscar productos</span>
          </div>

          <!-- Section title -->
          <div class="hero__phone-section">
            <span class="hero__phone-section-label">Categorías</span>
            <span class="hero__phone-section-more">Ver todas →</span>
          </div>

          <!-- Categorías grid -->
          <ul class="hero__phone-cats">
            {previewCategories.map((c, i) => (
              <li class="hero__phone-cat" style={`--cat-hue: ${c.hue}; --cat-delay: ${i * 90 + 1400}ms;`}>
                <div class="hero__phone-cat-thumb">
                  <span class="hero__phone-cat-mark"></span>
                </div>
                <span class="hero__phone-cat-name">{c.nombre}</span>
              </li>
            ))}
          </ul>

          <!-- Floating CTA dentro de la app -->
          <div class="hero__phone-cta" aria-hidden="true">
            <span class="hero__phone-cta-pulse"></span>
            <span class="hero__phone-cta-text">Comprar online</span>
            <span class="hero__phone-cta-icon">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M4 7h6m0 0L7 4m3 3-3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </div>
      </div>

      <!-- Floating chip 1: stock status -->
      <div class="hero__phone-chip hero__phone-chip--stock" data-reveal="scale" style="--reveal-delay: 1600ms;" aria-hidden="true">
        <span class="hero__phone-chip-dot"></span>
        <span>Stock en línea</span>
      </div>

      <!-- Floating chip 2: cobertura -->
      <div class="hero__phone-chip hero__phone-chip--coverage" data-reveal="scale" style="--reveal-delay: 1800ms;" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="7" cy="7" r="3" stroke="currentColor" stroke-width="1.4"/></svg>
        <span>AMBA + PBA</span>
      </div>
    </aside>
  </div>

  <!-- Scroll cue -->
  <a class="hero__cue" href="#quem-central" aria-label="Bajar a Qüem Central" data-reveal style="--reveal-delay: 1400ms;">
    <span class="hero__cue-line" aria-hidden="true"></span>
    <span class="hero__cue-text">Descubrí más</span>
  </a>
</section>

<style>
  /* ===== Hero shell =============================================== */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5.5rem) clamp(4rem, 6vw, 6rem);
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(620px, 86vh, 880px);
    display: flex;
    align-items: center;
  }

  /* ===== Scroll cue ================================================ */
  .hero__cue {
    position: absolute;
    bottom: clamp(1rem, 3vw, 1.75rem);
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
    transition: color var(--dur-fast);
    z-index: 2;
  }
  .hero__cue:hover { color: var(--color-text-brand); }
  .hero__cue-line {
    width: 1.5px;
    height: 36px;
    background: linear-gradient(180deg, transparent 0%, var(--color-border-strong) 100%);
    position: relative;
    overflow: hidden;
    border-radius: 99px;
  }
  .hero__cue-line::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 40%;
    background: linear-gradient(180deg, transparent 0%, var(--color-brand-500) 100%);
    border-radius: 99px;
    animation: hero-cue-trickle 2s ease-in-out infinite;
  }
  @keyframes hero-cue-trickle {
    0%   { transform: translateY(-100%); opacity: 0; }
    25%  { opacity: 1; }
    75%  { opacity: 1; }
    100% { transform: translateY(150%); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cue-line::after { animation: none; opacity: 0.6; transform: none; }
  }
  @media (max-width: 640px) { .hero__cue { display: none; } }

  /* ===== Background ================================================ */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-brand-tint) 100%);
  }
  .hero__bg-mesh {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(45% 55% at 80% 10%, oklch(58% 0.155 254 / 0.18) 0%, transparent 60%),
      radial-gradient(40% 50% at 10% 90%, oklch(62% 0.150 155 / 0.12) 0%, transparent 60%);
    transform: translateY(var(--parallax-y, 0));
    will-change: transform;
  }
  .hero__bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, oklch(42% 0.190 252 / 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(180deg, transparent 0%, black 25%, black 75%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 25%, black 75%, transparent 100%);
  }
  .hero__bg-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(var(--blur-xl));
    transform: translateY(var(--parallax-y, 0));
    will-change: transform;
    opacity: 0.45;
  }
  .hero__bg-orb--brand {
    width: 50rem; height: 50rem;
    top: -25rem; right: -18rem;
    background: var(--color-brand-300);
  }
  .hero__bg-orb--accent {
    width: 32rem; height: 32rem;
    bottom: -15rem; left: -10rem;
    background: var(--color-accent-300);
  }

  /* ===== Grid layout ============================================== */
  .hero__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    width: 100%;
  }
  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  /* ===== Brand tag ================================================= */
  .hero__brand-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.85rem 0.4rem 0.45rem;
    background: oklch(from var(--color-bg-elevated) l c h / 0.7);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(8px);
    color: var(--color-text-primary);
    font-size: var(--font-size-xs);
    font-weight: var(--weight-semibold);
    width: max-content;
    letter-spacing: -0.005em;
  }
  .hero__brand-mark {
    display: inline-grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 0.4rem;
    background: var(--gradient-brand);
    color: var(--color-text-on-brand);
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 0.7rem;
    letter-spacing: -0.06em;
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.2);
  }

  /* ===== Title — 3 líneas grandes ================================== */
  .hero__title {
    margin-block: var(--space-5) var(--space-4);
    font-size: clamp(2.75rem, 1.8rem + 4.5vw, 5.5rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
    font-weight: var(--weight-extrabold);
    color: var(--color-text-primary);
    text-wrap: balance;
  }
  .hero__title-line {
    display: block;
  }
  .hero__title-line--gradient {
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ===== Meta line ================================================ */
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-medium);
    margin-block-end: var(--space-6);
  }
  .hero__meta-dot {
    color: var(--color-text-muted);
    font-weight: var(--weight-bold);
  }

  /* ===== Actions =================================================== */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  .hero__cta-main {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1.05rem 1.6rem 1.05rem 1.75rem;
    border-radius: var(--radius-pill);
    background: var(--gradient-brand);
    color: var(--color-text-on-brand);
    font-size: var(--font-size-base);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.005em;
    overflow: hidden;
    transition: transform var(--dur-fast) var(--ease-standard),
                box-shadow var(--dur-normal) var(--ease-out-expo);
    box-shadow:
      0 1px 0 oklch(100% 0 0 / 0.2) inset,
      0 10px 28px oklch(42% 0.190 252 / 0.32),
      0 2px 6px oklch(42% 0.190 252 / 0.18);
    min-height: 56px;
  }
  .hero__cta-main:hover {
    transform: translateY(-2px);
    box-shadow:
      0 1px 0 oklch(100% 0 0 / 0.25) inset,
      0 14px 36px oklch(42% 0.190 252 / 0.42),
      0 4px 12px oklch(42% 0.190 252 / 0.22);
  }
  .hero__cta-main:active { transform: translateY(0); }
  .hero__cta-main-icon {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: oklch(100% 0 0 / 0.22);
    place-items: center;
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .hero__cta-main-icon svg { display: block; }
  .hero__cta-main:hover .hero__cta-main-icon { transform: translate(2px, -2px) rotate(0); }
  .hero__cta-main-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, oklch(100% 0 0 / 0) 0%, oklch(100% 0 0 / 0.18) 50%, oklch(100% 0 0 / 0) 100%);
    transform: translateX(-110%);
    pointer-events: none;
    transition: transform 720ms var(--ease-out-expo);
  }
  .hero__cta-main:hover .hero__cta-main-shine { transform: translateX(110%); }

  .hero__cta-alt {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    padding-block: 0.5rem;
    border-bottom: 1.5px solid transparent;
    transition: color var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard);
  }
  .hero__cta-alt:hover {
    color: var(--color-text-primary);
    border-color: var(--color-brand-500);
  }
  .hero__cta-alt:hover span { transform: translateX(3px); }
  .hero__cta-alt span {
    transition: transform var(--dur-fast) var(--ease-standard);
    display: inline-block;
  }

  /* ===== PHONE MOCKUP ============================================== */
  .hero__phone {
    position: relative;
    display: grid;
    place-items: center;
    padding: var(--space-5) 0;
    isolation: isolate;
  }

  .hero__phone-glow {
    position: absolute;
    inset: 5% 5%;
    z-index: -1;
    background: var(--gradient-mixed);
    filter: blur(72px);
    opacity: 0.35;
    border-radius: 50%;
  }

  .hero__phone-device {
    position: relative;
    width: clamp(260px, 24vw, 320px);
    aspect-ratio: 9 / 19.5;
    background: linear-gradient(180deg, oklch(20% 0.012 240) 0%, oklch(14% 0.014 240) 100%);
    border-radius: 2.6rem;
    padding: 0.55rem;
    box-shadow:
      0 0 0 1.5px oklch(28% 0.018 240) inset,
      0 0 0 8px oklch(8% 0.008 240),
      0 30px 60px oklch(15% 0.018 240 / 0.45),
      0 60px 120px oklch(42% 0.190 252 / 0.30);
    animation: hero-phone-float 6s ease-in-out infinite;
  }
  @keyframes hero-phone-float {
    0%, 100% { transform: translateY(0) rotate(0); }
    50%      { transform: translateY(-10px) rotate(-0.4deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__phone-device { animation: none; }
  }

  /* Dynamic island */
  .hero__phone-island {
    position: absolute;
    top: 0.85rem;
    left: 50%;
    transform: translateX(-50%);
    width: 5.5rem;
    height: 1.2rem;
    background: oklch(6% 0.006 240);
    border-radius: 0.7rem;
    z-index: 3;
  }

  /* Status bar */
  .hero__phone-status {
    position: absolute;
    top: 0.65rem;
    left: 1.5rem;
    right: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: oklch(100% 0 0 / 0.9);
    font-size: 0.65rem;
    font-weight: var(--weight-bold);
    z-index: 2;
    letter-spacing: -0.02em;
  }
  .hero__phone-status-time {
    width: 4rem;
    text-align: left;
  }
  .hero__phone-status-icons {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: 4rem;
    justify-content: flex-end;
  }
  .hero__phone-status-icons svg { width: 14px; height: auto; }

  /* App screen */
  .hero__phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(60% 50% at 0% 0%, oklch(75% 0.110 252 / 0.10) 0%, transparent 60%),
      radial-gradient(50% 40% at 100% 100%, oklch(62% 0.150 155 / 0.08) 0%, transparent 60%),
      var(--color-bg-elevated);
    border-radius: 2.05rem;
    padding: 2.5rem 0.9rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    overflow: hidden;
  }

  .hero__phone-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-inline: 0.2rem;
  }
  .hero__phone-header-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero__phone-header-mark {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.4rem;
    background: var(--gradient-brand);
    color: var(--color-text-on-brand);
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 0.75rem;
    letter-spacing: -0.06em;
  }
  .hero__phone-header-name {
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 0.85rem;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }
  .hero__phone-header-cart {
    position: relative;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    background: var(--color-surface-subtle);
    border-radius: 0.5rem;
    color: var(--color-text-primary);
  }
  .hero__phone-header-cart-dot {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 7px;
    height: 7px;
    background: var(--color-accent-500);
    border-radius: 50%;
    border: 1.5px solid var(--color-bg-elevated);
  }

  /* Search */
  .hero__phone-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.7rem;
    background: var(--color-surface-subtle);
    border-radius: 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    font-weight: var(--weight-medium);
  }

  /* Section title */
  .hero__phone-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-inline: 0.2rem;
    margin-block-start: 0.3rem;
  }
  .hero__phone-section-label {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: 0.78rem;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }
  .hero__phone-section-more {
    font-size: 0.65rem;
    color: var(--color-text-brand);
    font-weight: var(--weight-semibold);
  }

  /* Categories grid */
  .hero__phone-cats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    flex: 1;
  }
  .hero__phone-cat {
    background: var(--color-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.7rem;
    padding: 0.55rem;
    display: grid;
