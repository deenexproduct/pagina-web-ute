---
/**
 * HeroCorporativo — Hero institucional del grupo QUEM (spec Fase 1, punto 2).
 *
 * Qué cambió respecto de la versión anterior:
 *  - Se eliminó el mockup de teléfono con carrito + badge de cantidad, los dos
 *    CTAs "Comprar online" y el CSS muerto de `.hero__brand-mark`. Fase 1
 *    deroga el e-commerce: toda CTA va a contacto o WhatsApp.
 *  - El h1 dejó de vender "proveedor de congelados" y pasó a hablar como
 *    GRUPO (QUEM es la marca madre; Qüem Central es una de sus 4 unidades).
 *  - Se tokenizaron los ~35 `oklch()` literales del fondo. Los que estaban en
 *    hue azul (254 / 252 / 240) eran resabios de una paleta abandonada: se
 *    reemplazaron por brand (oliva) y accent (dorado).
 *
 * Video de fondo: `HERO_VIDEO` está vacío A PROPÓSITO (el asset anterior tenía
 * marca de terceros). Mientras esté vacío el hero renderiza un fondo tratado
 * —mesh + orbs + trama de puntos— que se lee como decisión, no como hueco.
 * Cuando llegue el asset definitivo se prende solo, sin tocar este archivo.
 */
import { BRAND, hasHeroVideo, hasWhatsapp, HERO_VIDEO, link, whatsappLink } from '../config/site';
import { getLangFromUrl, localizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const COPY = {
  es: {
    eyebrow: `Grupo ${BRAND.group}`,
    tituloL1: 'Toda la cadena del',
    tituloL2: 'alimento congelado.',
    bajada:
      'Tiendas, abastecimiento mayorista, franquicias y desarrollo de producto, bajo un mismo grupo.',
    whatsappMsg: `Hola ${BRAND.group}. Quiero conocer más sobre el grupo.`,
    cue: 'Conocé el grupo',
  },
  en: {
    eyebrow: `${BRAND.group} Group`,
    tituloL1: 'The entire',
    tituloL2: 'frozen food chain.',
    bajada:
      'Retail stores, wholesale supply, franchises and product development, under a single group.',
    whatsappMsg: `Hi ${BRAND.group}. I'd like to know more about the group.`,
    cue: 'Meet the group',
  },
} as const;
const c = COPY[lang];

const showVideo = hasHeroVideo();
const showWhatsapp = hasWhatsapp();

/*
 * `contactLink()` de site.ts es agnóstico de idioma: devuelve `/#contacto`, que
 * desde `/en/` saca al visitante a la home en español. Hasta que el helper sea
 * lang-aware, el anchor se localiza acá. En ES el resultado es idéntico.
 */
const contactHref = localizedPath('/#contacto', lang);
const whatsappHref = whatsappLink(c.whatsappMsg, lang);
const nosotrosHref = localizedPath('/#nosotros', lang);

/*
 * Guard de `prefers-reduced-motion` para el video.
 * El CSS ya oculta el `<video>` y muestra el poster, pero un video en
 * `display: none` puede seguir decodificando: esto lo frena de verdad.
 * Va como `is:inline` y sólo se emite si existe el asset.
 */
const REDUCED_MOTION_GUARD = `
(function () {
  var v = document.querySelector('[data-hero-video]');
  if (!v) return;
  var mq = window.matchMedia('(prefers-reduced-motion: reduce)');
  function apply() {
    if (mq.matches) {
      v.pause();
      v.removeAttribute('autoplay');
    } else {
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }
  }
  apply();
  if (mq.addEventListener) mq.addEventListener('change', apply);
})();
`;
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    {
      showVideo ? (
        <Fragment>
          <video
            class="hero__video"
            data-hero-video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={HERO_VIDEO.poster ? link(HERO_VIDEO.poster) : undefined}
          >
            {HERO_VIDEO.webm.length > 0 && (
              <source src={link(HERO_VIDEO.webm)} type="video/webm" />
            )}
            <source src={link(HERO_VIDEO.mp4)} type="video/mp4" />
          </video>
          {HERO_VIDEO.poster.length > 0 && (
            <div
              class="hero__poster"
              style={`background-image: url('${link(HERO_VIDEO.poster)}');`}
            />
          )}
          <div class="hero__scrim" />
        </Fragment>
      ) : (
        <Fragment>
          <div class="hero__mesh" data-parallax="0.12" />
          <div class="hero__grid" />
          <div class="hero__orb hero__orb--brand" data-parallax="0.22" />
          <div class="hero__orb hero__orb--accent" data-parallax="0.32" />
        </Fragment>
      )
    }
  </div>

  <div class="hero__inner container-content">
    <p class="eyebrow" data-reveal="fade">{c.eyebrow}</p>

    <h1 id="hero-title" class="hero__title">
      <span class="hero__title-line" data-reveal style="--reveal-delay: 80ms;">{c.tituloL1}</span>
      <span class="hero__title-line hero__title-line--em" data-reveal style="--reveal-delay: 180ms;"
        >{c.tituloL2}</span
      >
    </h1>

    <p class="hero__lede" data-reveal style="--reveal-delay: 300ms;">{c.bajada}</p>

    <div class="hero__actions" data-reveal style="--reveal-delay: 400ms;">
      <a class="btn hero__cta hero__cta--main" href={contactHref}>{t('cta.hablemos')}</a>
      {
        showWhatsapp && (
          <a
            class="btn btn-outline hero__cta"
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('cta.whatsapp')}
          </a>
        )
      }
    </div>
  </div>

  <!-- Sin aria-label: el nombre accesible tiene que contener el texto visible (WCAG 2.5.3). -->
  <a class="hero__cue" href={nosotrosHref}>
    <span class="hero__cue-label">{c.cue}</span>
    <span class="hero__cue-line" aria-hidden="true"></span>
  </a>

  {showVideo && <script is:inline set:html={REDUCED_MOTION_GUARD} />}
</section>

<style>
  /* ===== Shell ===================================================== */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    /* El header es sticky, así que ocupa flujo: descontarlo del alto. */
    min-height: clamp(30rem, calc(100svh - var(--header-height)), 52rem);
    padding-block: var(--space-8) var(--space-9);

    /*
     * Velo del video. Único knob de la sección: cuánto se ve el material
     * detrás del texto. 0.45 es el techo que mantiene contraste AA del
     * cuerpo de texto incluso si el cliente entrega footage muy oscuro.
     */
    --hero-video-veil: 0.45;
  }

  /* ===== Fondo — base común ======================================== */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-brand-tint) 100%);
  }

  /* ===== Fondo — CON video ========================================= */
  .hero__video,
  .hero__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: var(--hero-video-veil);
  }
  .hero__poster {
    display: none;
    background-size: cover;
    background-position: center;
  }
  /* Reduced motion: nada de reproducción, sólo el poster fijo. */
  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
    .hero__poster {
      display: block;
    }
  }

  /*
   * Scrim: crema opaco en el centro (donde vive el texto) que se desvanece
   * hacia los bordes. Garantiza AA del titular, la bajada y las CTAs sin
   * depender de qué footage entregue el cliente.
   */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(78% 82% at 50% 50%, var(--color-bg) 0%, var(--color-bg) 46%, transparent 82%),
      linear-gradient(
        180deg,
        var(--color-bg) 0%,
        transparent 24%,
        transparent 70%,
        var(--color-brand-tint) 100%
      );
  }

  /* ===== Fondo — SIN video (estado actual) =========================
   * Tratamiento deliberado: mesh de marca + trama fina + dos orbs
   * difusos. Ni hueco ni caja vacía esperando un asset.
   * ================================================================= */
  .hero__mesh {
    position: absolute;
    inset: -20%;
    background: var(--gradient-mesh);
    transform: translateY(var(--parallax-y, 0));
    will-change: transform;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      oklch(from var(--color-brand-500) l c h / 0.07) 1px,
      transparent 1px
    );
    background-size: 30px 30px;
    mask-image: linear-gradient(180deg, transparent 0%, black 22%, black 72%, transparent 100%);
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 22%,
      black 72%,
      transparent 100%
    );
  }
  .hero__orb {
    position: absolute;
    border-radius: var(--radius-circle);
    filter: blur(var(--blur-xl));
    transform: translateY(var(--parallax-y, 0));
    will-change: transform;
    opacity: 0.4;
  }
  .hero__orb--brand {
    inline-size: 46rem;
    block-size: 46rem;
    inset-block-start: -24rem;
    inset-inline-end: -16rem;
    background: var(--color-brand-300);
  }
  .hero__orb--accent {
    inline-size: 30rem;
    block-size: 30rem;
    inset-block-end: -14rem;
    inset-inline-start: -10rem;
    background: var(--color-accent-300);
  }

  /* ===== Contenido ================================================= */
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .hero__title {
    max-inline-size: 20ch;
    font-size: var(--font-size-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tightest);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
  }
  .hero__title-line {
    display: block;
  }
  /* Sólido, no gradiente: el extremo claro del gradient-text no llega a AA. */
  .hero__title-line--em {
    color: var(--color-brand-700);
  }

  .hero__lede {
    max-inline-size: 46ch;
    font-size: var(--font-size-md);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* ===== CTAs ====================================================== */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-block-start: var(--space-3);
  }

  .hero__cta {
    padding-block: var(--space-3);
    padding-inline: var(--space-5);
    /* Físico a propósito: tiene que ganarle al `min-height` de `.btn`. */
    min-height: 52px;
    font-size: var(--font-size-base);
    border-radius: var(--radius-pill);
  }

  /*
   * Primaria: brand-700, no brand-500. El `.btn-primary` global queda en
   * ~3.1:1 con texto blanco, por debajo de AA; acá se corrige localmente.
   */
  .hero__cta--main {
    background-color: var(--color-brand-700);
    color: var(--color-text-on-brand);
    box-shadow: var(--shadow-md);
  }
  .hero__cta--main:hover {
    background-color: var(--color-brand-800);
    box-shadow: var(--shadow-lg);
  }

  /* ===== Scroll cue ================================================ */
  .hero__cue {
    position: absolute;
    inset-block-end: var(--space-4);
    inset-inline: 0;
    inline-size: max-content;
    margin-inline: auto;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 44px;
    min-inline-size: 44px;
    padding: var(--space-2) var(--space-4);
    /* text-muted quedaría en ~3.6:1 sobre la crema: no llega a AA. */
    color: var(--color-text-secondary);
    font-size: var(--font-size-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease-out-cubic);
  }
  .hero__cue:hover {
    color: var(--color-text-brand);
  }
  .hero__cue-line {
    inline-size: 1px;
    block-size: var(--space-5);
    background: linear-gradient(180deg, var(--color-border-strong) 0%, transparent 100%);
    animation: hero-cue-pulse 2.6s var(--ease-out-cubic) infinite;
  }
  @keyframes hero-cue-pulse {
    0%,
    100% {
      transform: scaleY(1);
      transform-origin: top;
      opacity: 0.9;
    }
    50% {
      transform: scaleY(0.55);
      transform-origin: top;
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cue-line {
      animation: none;
    }
  }
  /* Sólo cuando hay alto real de sobra: si no, pisa el contenido. */
  @media (min-width: 48rem) and (min-height: 45rem) {
    .hero__cue {
      display: inline-flex;
    }
  }

  /* ===== Escalas mayores =========================================== */
  @media (min-width: 48rem) {
    .hero__inner {
      gap: var(--space-5);
    }
  }
</style>
