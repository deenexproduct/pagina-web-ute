---
import { link } from '../config/site';

interface Props {
  showHead?: boolean;
}
const { showHead = true } = Astro.props;

/** Mini-grid de bloques de valor con números y cifras cualitativas, sin inventar métricas. */
const valueBlocks = [
  { label: 'Sin cocina ni desarrollo', detail: 'producto curado listo para vender' },
  { label: 'Reposición simple', detail: 'logística y abastecimiento incluidos' },
  { label: 'Implementación rápida', detail: 'corner operativo en pocas semanas' },
  { label: 'Marca y POP', detail: 'branding profesional aplicado al espacio' },
];

/** Formatos disponibles para preview en home. */
const formats = [
  { name: 'Freezer vertical', svg: 'vertical' },
  { name: 'Freezer exhibidor', svg: 'horizontal' },
  { name: 'Isla', svg: 'island' },
  { name: 'Mini store', svg: 'ministore' },
  { name: 'Grab & go', svg: 'grab' },
];
---

<section class="corner section-y" id="corner-quem" aria-labelledby="corner-title">
  <div class="corner__bg" aria-hidden="true"></div>

  <div class="container-content corner__inner">
    {showHead && (
      <header class="corner__head">
        <div class="corner__head-tag">
          <span class="corner__head-tag-dot" aria-hidden="true"></span>
          Nueva unidad de negocio · Sección destacada
        </div>
        <p class="eyebrow corner__eyebrow">04 · Corner QÜEM</p>
        <h2 id="corner-title" class="corner__title">
          Más facturación.<br />
          <span class="corner__title-accent">Menos complejidad.</span>
        </h2>
        <p class="corner__subtitle">
          Una solución integral de retail congelado lista para operar dentro de tu espacio
          — cafetería, supermercado, gimnasio, hotel, club, estación, oficina.
        </p>
      </header>
    )}

    <div class="corner__split">
      <div class="corner__pitch">
        <p class="corner__pitch-lede">
          <strong>Corner QÜEM</strong> transforma metros cuadrados subutilizados en una nueva unidad de venta
          con producto curado, marca, logística y soporte operativo.
        </p>

        <ul class="corner__values">
          {valueBlocks.map((b) => (
            <li>
              <span class="corner__values-check" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="m3 7 3 3 6-7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <span class="corner__values-label">{b.label}</span>
                <span class="corner__values-detail">{b.detail}</span>
              </div>
            </li>
          ))}
        </ul>

        <div class="corner__cta-row">
          <a class="btn btn-secondary corner__cta-main" href={link('/corner-quem')}>
            Quiero hablar con el equipo comercial
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="btn btn-ghost" href={link('/corner-quem')}>Ver el modelo completo</a>
        </div>
      </div>

      <aside class="corner__visual" aria-hidden="true">
        <div class="corner__visual-frame">
          <div class="corner__visual-head">
            <div class="corner__visual-tag">Formatos disponibles</div>
            <div class="corner__visual-dots"><span></span><span></span><span></span></div>
          </div>
          <ul class="corner__formats">
            {formats.map((f) => (
              <li class="corner-format">
                <div class="corner-format__icon">
                  {f.svg === 'vertical' && (
                    <svg viewBox="0 0 32 40" fill="none"><rect x="6" y="3" width="20" height="34" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M6 13h20M6 23h20" stroke="currentColor" stroke-width="1.2"/><circle cx="22" cy="8" r="0.8" fill="currentColor"/></svg>
                  )}
                  {f.svg === 'horizontal' && (
                    <svg viewBox="0 0 40 32" fill="none"><rect x="3" y="8" width="34" height="20" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M10 8V4h20v4M3 18h34" stroke="currentColor" stroke-width="1.2"/></svg>
                  )}
                  {f.svg === 'island' && (
                    <svg viewBox="0 0 40 32" fill="none"><rect x="4" y="10" width="32" height="18" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M4 19h32M14 10V6h12v4" stroke="currentColor" stroke-width="1.2"/><circle cx="10" cy="24" r="0.8" fill="currentColor"/><circle cx="30" cy="24" r="0.8" fill="currentColor"/></svg>
                  )}
                  {f.svg === 'ministore' && (
                    <svg viewBox="0 0 40 32" fill="none"><path d="M5 12h30l-2-6H7L5 12Z" stroke="currentColor" stroke-width="1.4"/><path d="M6 12v16h28V12" stroke="currentColor" stroke-width="1.4"/><path d="M12 28v-8h6v8M22 20h6v4h-6z" stroke="currentColor" stroke-width="1.2"/></svg>
                  )}
                  {f.svg === 'grab' && (
                    <svg viewBox="0 0 32 32" fill="none"><rect x="4" y="6" width="24" height="22" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M4 13h24M11 19h6M11 23h10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                  )}
                </div>
                <span class="corner-format__name">{f.name}</span>
              </li>
            ))}
          </ul>
          <div class="corner__visual-foot">
            <span>QÜEM · retail congelado listo para operar</span>
            <span class="corner__visual-pill">5 formatos</span>
          </div>
        </div>
        <div class="corner__visual-shadow" aria-hidden="true"></div>
      </aside>
    </div>
  </div>
</section>

<style>
  .corner {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-bg);
  }
  .corner__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(50% 60% at 100% 0%, oklch(58% 0.155 254 / 0.14) 0%, transparent 65%),
      radial-gradient(40% 50% at 0% 100%, oklch(62% 0.150 155 / 0.10) 0%, transparent 65%),
      linear-gradient(180deg, var(--color-brand-tint) 0%, var(--color-bg) 100%);
  }
  .corner__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, oklch(42% 0.190 252 / 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 90%);
  }

  .corner__inner { display: grid; gap: var(--space-7); }
  .corner__head { display: grid; gap: var(--space-2); max-width: 60ch; }
  .corner__head-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: max-content;
    padding: 0.4rem 0.85rem;
    background: oklch(from var(--color-accent-500) l c h / 0.12);
    color: var(--color-accent-700);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
    border: 1px solid oklch(from var(--color-accent-500) l c h / 0.18);
  }
  .corner__head-tag-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-accent-500);
  }
  .corner__title {
    font-size: var(--font-size-4xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.04em;
    line-height: 1.0;
    margin-block-start: var(--space-3);
    text-wrap: balance;
  }
  .corner__title-accent {
    background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-700));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .corner__subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    max-width: 56ch;
    line-height: var(--leading-snug);
    margin-block-start: var(--space-3);
  }

  /* Split */
  .corner__split { display: grid; gap: var(--space-7); align-items: start; }
  @media (min-width: 960px) {
    .corner__split { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: var(--space-8); }
  }

  /* Pitch */
  .corner__pitch { display: grid; gap: var(--space-5); }
  .corner__pitch-lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-relaxed);
    max-width: 48ch;
  }
  .corner__pitch-lede strong { color: var(--color-text-primary); font-weight: var(--weight-semibold); }

  .corner__values { display: grid; gap: var(--space-2); }
  .corner__values li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur-fast) var(--ease-standard),
                transform var(--dur-fast) var(--ease-standard);
  }
  .corner__values li:hover {
    border-color: var(--color-accent-300);
    transform: translateX(3px);
  }
  .corner__values-check {
    width: 1.65rem;
    height: 1.65rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-100);
    color: var(--color-accent-700);
    display: grid;
    place-items: center;
    margin-block-start: 0.1rem;
  }
  .corner__values-label {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }
  .corner__values-detail {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    margin-block-start: 0.15rem;
  }

  .corner__cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-block-start: var(--space-3); }
  .corner__cta-main {
    padding-inline: 1.4rem;
    padding-block: 0.95rem;
    font-size: var(--font-size-sm);
    box-shadow: 0 6px 18px oklch(42% 0.190 252 / 0.28);
  }
  .corner__cta-main:hover { box-shadow: 0 8px 24px oklch(42% 0.190 252 / 0.36); }

  /* Visual card */
  .corner__visual { position: relative; }
  .corner__visual-frame {
    position: relative;
    z-index: 1;
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 1.5rem;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .corner__visual-frame::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-brand-500), var(--color-accent-500));
  }
  .corner__visual-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block-end: var(--space-4);
  }
  .corner__visual-tag {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
    color: var(--color-text-brand);
  }
  .corner__visual-dots { display: flex; gap: 0.3rem; }
  .corner__visual-dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--color-border-strong); }
  .corner__visual-dots span:first-child { background: var(--color-accent-500); }

  .corner__formats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .corner__formats li:nth-child(5) { grid-column: 1 / -1; }
  .corner-format {
    display: grid;
    place-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-2);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    transition: background var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard),
                transform var(--dur-fast) var(--ease-standard);
  }
  .corner-format:hover {
    background: var(--color-bg-elevated);
    border-color: var(--color-brand-300);
    transform: translateY(-2px);
  }
  .corner-format__icon {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    color: var(--color-brand-600);
  }
  .corner-format__icon svg { width: 2.5rem; height: 2.5rem; }
  .corner-format__name {
    font-size: var(--font-size-xs);
    color: var(--color-text-primary);
    font-weight: var(--weight-semibold);
    text-align: center;
    letter-spacing: -0.01em;
  }

  .corner__visual-foot {
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .corner__visual-foot span:first-child {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
  }
  .corner__visual-pill {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand-500);
    color: var(--color-text-on-brand);
  }

  .corner__visual-shadow {
    position: absolute;
    inset: 14% -10% -12% 10%;
    z-index: 0;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, var(--color-brand-100) 0%, var(--color-accent-100) 100%);
    filter: blur(40px);
    opacity: 0.55;
  }
</style>
