---
import { PRESS } from '../../config/press';

interface Props {
  showHead?: boolean;
}
const { showHead = true } = Astro.props;

const fmtDate = (iso: string): string => {
  const d = new Date(iso);
  return d.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
};

/* Outlets únicos para el strip social-proof "Como nos vieron" */
const uniqueOutlets = Array.from(new Map(PRESS.map((p) => [p.outletSlug, p.outlet])).entries());
---

<section class="pr-list section-y" id="prensa" aria-labelledby="pr-list-title">
  <div class="container-content">

    {showHead && (
      <header class="pr-list__section-head">
        <p class="eyebrow" data-reveal style="--reveal-y: 16px;">Prensa</p>
        <h2 id="pr-list-title" class="pr-list__section-title" data-reveal style="--reveal-delay: 100ms;">
          Qüem en <em>los medios</em>.
        </h2>
        <p class="pr-list__section-lede" data-reveal style="--reveal-delay: 200ms;">
          Cobertura de medios económicos y de negocios sobre Qüem Central.
        </p>
      </header>
    )}

    <div class="pr-list__head">
      {!showHead && <h2 id="pr-list-title" class="sr-only">Notas de prensa</h2>}

      {/* Strip "Como nos vieron" — wordmarks de medios sobre las cards */}
      <div class="pr-list__outlets" aria-label="Medios donde aparecemos" data-reveal>
        <span class="pr-list__outlets-label">Cobertura en</span>
        <ul class="pr-list__outlets-list" role="list">
          {uniqueOutlets.map(([slug, name]) => (
            <li class:list={['pr-outlet-mark', `pr-outlet-mark--${slug}`]}>
              <span class="pr-outlet-mark__dot" aria-hidden="true"></span>
              <span class="pr-outlet-mark__name">{name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Pull-quote destacado — La Nación (datos del artículo oct 2023) */}
    <a
      class="pr-pullquote"
      href="https://www.lanacion.com.ar/economia/se-hizo-socio-para-ayudar-a-un-amigo-y-termino-adquiriendo-un-emprendimiento-de-congelados-que-nid16102023/"
      target="_blank"
      rel="noopener"
      data-reveal
      aria-label="Leer nota completa en La Nación"
    >
      <div class="pr-pullquote__left">
        <div class="pr-pullquote__outlet">
          <span class="pr-pullquote__dot" aria-hidden="true"></span>
          <span class="pr-pullquote__outlet-name">La Nación</span>
          <time class="pr-pullquote__date" datetime="2023-10-16">Oct 2023</time>
        </div>
        <blockquote class="pr-pullquote__text">
          "Factura $800 millones al año. 21 tiendas, 15 franquiciadas. Expansión proyectada a Colombia."
        </blockquote>
        <span class="pr-pullquote__cta" aria-hidden="true">
          Leer nota completa
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </div>
      <div class="pr-pullquote__stats" aria-hidden="true">
        <div class="pr-pullquote__stat">
          <span class="pr-pullquote__stat-val">$800M</span>
          <span class="pr-pullquote__stat-label">facturación anual</span>
        </div>
        <span class="pr-pullquote__divider"></span>
        <div class="pr-pullquote__stat">
          <span class="pr-pullquote__stat-val">21</span>
          <span class="pr-pullquote__stat-label">tiendas activas</span>
        </div>
        <span class="pr-pullquote__divider"></span>
        <div class="pr-pullquote__stat">
          <span class="pr-pullquote__stat-val">15</span>
          <span class="pr-pullquote__stat-label">franquiciadas</span>
        </div>
      </div>
    </a>

    <ul class="pr-list__grid" role="list" data-reveal-stagger>
      {PRESS.map((p) => (
        <li data-reveal>
          <a
            class:list={['pr-card', `pr-card--${p.outletSlug}`, p.featured && 'pr-card--featured']}
            href={p.url}
            target="_blank"
            rel="noopener"
            aria-label={`${p.title} — ${p.outlet}, ${fmtDate(p.date)}`}
          >
            <header class="pr-card__head">
              <span class="pr-card__outlet" aria-hidden="true">
                <span class="pr-card__outlet-mark"></span>
                <span class="pr-card__outlet-name">{p.outlet}</span>
              </span>
              <time class="pr-card__date" datetime={p.date}>{fmtDate(p.date)}</time>
            </header>

            {p.tag && (
              <div class="pr-card__tag">
                {p.featured && <span class="pr-card__tag-star" aria-hidden="true">★</span>}
                {p.tag}
              </div>
            )}

            <h3 class="pr-card__title">{p.title}</h3>

            <p class="pr-card__excerpt">{p.excerpt}</p>

            <div class="pr-card__foot">
              <span class="pr-card__cta">
                Leer la nota
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="pr-card__domain">{new URL(p.url).hostname.replace(/^www\./, '')}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Section header — muestra cuando showHead=true */
  .pr-list__section-head {
    display: grid;
    gap: var(--space-3);
    max-width: 56ch;
    margin-block-end: var(--space-7);
  }
  .pr-list__section-title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
    color: var(--color-text-primary);
  }
  .pr-list__section-title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .pr-list__section-lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
  }

  .pr-list__head { margin-block-end: var(--space-6); }

  /* Strip outlets — social proof "Cobertura en" */
  .pr-list__outlets {
    display: flex;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    flex-wrap: wrap;
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border-subtle);
    margin-block-end: var(--space-6);
  }
  .pr-list__outlets-label {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
    flex-shrink: 0;
  }
  .pr-list__outlets-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }
  .pr-outlet-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity var(--dur-fast);
  }
  .pr-list__outlets:hover .pr-outlet-mark { opacity: 0.55; }
  .pr-list__outlets:hover .pr-outlet-mark:hover { opacity: 1; }
  .pr-outlet-mark__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--color-neutral-400);
  }
  .pr-outlet-mark--la-nacion .pr-outlet-mark__dot { background: #003366; }
  .pr-outlet-mark--iprofesional .pr-outlet-mark__dot { background: #d63031; }
  .pr-outlet-mark--tn .pr-outlet-mark__dot { background: #ffd600; }
  .pr-outlet-mark--clarin .pr-outlet-mark__dot { background: #ce0000; }
  .pr-outlet-mark--infobae .pr-outlet-mark__dot { background: #1e88e5; }
  .pr-outlet-mark__name {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--font-size-sm);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  /* Pull-quote La Nación */
  .pr-pullquote {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-6);
    margin-block-end: var(--space-6);
    background: linear-gradient(135deg, #eef3fa 0%, var(--color-bg-elevated) 100%);
    border: 1px solid #c5d4e8;
    border-inline-start: 4px solid #003366;
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: transform var(--dur-fast), box-shadow var(--dur-fast), border-color var(--dur-fast);
  }
  .pr-pullquote:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: #003366;
  }

  .pr-pullquote__left {
    display: grid;
    gap: var(--space-2);
    flex: 1;
    min-width: 18rem;
  }
  .pr-pullquote__outlet {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pr-pullquote__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #003366;
    flex-shrink: 0;
  }
  .pr-pullquote__outlet-name {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--font-size-sm);
    letter-spacing: -0.02em;
    color: #003366;
  }
  .pr-pullquote__date {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
  }
  .pr-pullquote__text {
    font-size: var(--font-size-md);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    line-height: 1.4;
    letter-spacing: -0.01em;
    font-style: italic;
    margin: 0;
  }
  .pr-pullquote__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    color: #003366;
    margin-block-start: var(--space-1);
  }
  .pr-pullquote:hover .pr-pullquote__cta { text-decoration: underline; text-underline-offset: 3px; }

  .pr-pullquote__stats {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    flex-shrink: 0;
  }
  /* Hide stats on small screens to prevent horizontal overflow */
  @media (max-width: 580px) {
    .pr-pullquote__stats { display: none; }
    .pr-pullquote__left { min-width: 0; }
  }
  .pr-pullquote__stat {
    display: grid;
    gap: 0.15rem;
    text-align: center;
  }
  .pr-pullquote__stat-val {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.04em;
    color: #003366;
    line-height: 1;
  }
  .pr-pullquote__stat-label {
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
  }
  .pr-pullquote__divider {
    width: 1px;
    height: 2.5rem;
    background: #c5d4e8;
    flex-shrink: 0;
  }

  .pr-list__grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .pr-card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    transition: transform var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard),
                box-shadow var(--dur-fast) var(--ease-standard);
    overflow: hidden;
  }
  .pr-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--color-neutral-300);
    transition: height var(--dur-normal) var(--ease-out-expo);
  }
  .pr-card--la-nacion::before { background: linear-gradient(90deg, #003366, #0066aa); }
  .pr-card--iprofesional::before { background: linear-gradient(90deg, #d63031, #c0392b); }
  .pr-card--tn::before { background: linear-gradient(90deg, #ffd600, #ffaa00); }
  .pr-card--clarin::before { background: linear-gradient(90deg, #ce0000, #a30000); }
  .pr-card--infobae::before { background: linear-gradient(90deg, #1e88e5, #1565c0); }

  .pr-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-brand-300);
    box-shadow: var(--shadow-md);
  }
  .pr-card:hover::before { height: 4px; }

  .pr-card--featured {
    background: linear-gradient(180deg, var(--color-brand-tint) 0%, var(--color-bg-elevated) 100%);
  }

  .pr-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .pr-card__outlet {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pr-card__outlet-mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .pr-card--la-nacion .pr-card__outlet-mark { background: #003366; }
  .pr-card--iprofesional .pr-card__outlet-mark { background: #d63031; }
  .pr-card--tn .pr-card__outlet-mark { background: #ffd600; }
  .pr-card--clarin .pr-card__outlet-mark { background: #ce0000; }
  .pr-card--infobae .pr-card__outlet-mark { background: #1e88e5; }

  .pr-card__outlet-name {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--font-size-sm);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }
  .pr-card__date {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
  }

  .pr-card__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: max-content;
    padding: 0.2rem 0.55rem;
    background: var(--color-brand-50);
    color: var(--color-brand-700);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
  }
  .pr-card--featured .pr-card__tag {
    background: oklch(from var(--color-accent-500) l c h / 0.14);
    color: var(--color-accent-700);
  }
  .pr-card__tag-star { color: var(--color-accent-700); }

  .pr-card__title {
    font-size: var(--font-size-md);
    font-weight: var(--weight-bold);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .pr-card__excerpt {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pr-card__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-block-start: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
  }
  .pr-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--font-size-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-brand);
  }
  .pr-card:hover .pr-card__cta { text-decoration: underline; text-underline-offset: 3px; }
  .pr-card__domain {
    font-size: var(--font-size-2xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
  }
</style>
