---
const puntosClave = [
  { titulo: 'Abastecimiento B2B', desc: 'Insumos congelados confiables para operaciones de alta rotación.', icon: 'b2b' },
  { titulo: 'Logística de congelados', desc: 'Última milla especializada con foco en AMBA y Provincia de Buenos Aires.', icon: 'truck' },
  { titulo: 'Red comercial', desc: 'B2B, retail, franquicias y corners coordinados en una sola estructura.', icon: 'network' },
  { titulo: 'App y catálogo digital', desc: 'Compra online y categorías centralizadas en un único canal.', icon: 'app' },
  { titulo: 'Corners y franquicias', desc: 'Formatos replicables para escalar puntos de venta.', icon: 'expand' },
];
---

<section id="quem-central" class="que-es section-y" aria-labelledby="que-es-title">
  <div class="container-content que-es__inner">
    <!-- Columna sticky con title + copy -->
    <div class="que-es__sticky">
      <div class="que-es__sticky-content">
        <p class="eyebrow" data-reveal style="--reveal-y: 16px;">01 · Qué es QUEM Central</p>
        <h2 id="que-es-title" class="que-es__title" data-reveal style="--reveal-delay: 100ms;">
          Una compañía gastronómica y tecnológica <em>integrada para escalar</em>
        </h2>
        <div class="que-es__copy" data-reveal style="--reveal-delay: 200ms;">
          <p>
            <strong>QUEM Central</strong> es una compañía enfocada en el abastecimiento, distribución
            y desarrollo comercial de alimentos congelados.
          </p>
          <p>
            A través de su red B2B, sus tiendas, franquicias, corners, logística especializada y
            plataforma digital, conecta productos congelados con distintos canales de consumo y
            comercialización.
          </p>
          <p>
            El modelo combina <em>operación gastronómica, capilaridad comercial y tecnología</em>
            para facilitar compras, ordenar el abastecimiento y escalar nuevas unidades de negocio.
          </p>
        </div>

        <!-- Indicador visual de avance lectura -->
        <div class="que-es__indicator" aria-hidden="true">
          <span class="que-es__indicator-line"></span>
          <span class="que-es__indicator-count">5 capacidades clave</span>
        </div>
      </div>
    </div>

    <!-- Columna de puntos clave con reveal cascade -->
    <ol class="que-es__points" data-reveal-stagger>
      {puntosClave.map((p, i) => (
        <li class="que-es__point" data-reveal>
          <div class="que-es__point-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
          <div class="que-es__point-icon" aria-hidden="true">
            {p.icon === 'b2b' && (
              <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h18M8 13h3M8 16h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            )}
            {p.icon === 'truck' && (
              <svg viewBox="0 0 24 24" fill="none"><path d="M2 17V6h12v11M14 11h4l3 3v3h-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="18" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
            {p.icon === 'network' && (
              <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="4" cy="5" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="20" cy="5" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="4" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="20" cy="19" r="2" stroke="currentColor" stroke-width="1.6"/><path d="m6 6 4 4M18 6l-4 4M6 18l4-4M18 18l-4-4" stroke="currentColor" stroke-width="1.4"/></svg>
            )}
            {p.icon === 'app' && (
              <svg viewBox="0 0 24 24" fill="none"><rect x="7" y="2" width="10" height="20" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M10 5h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="18" r="0.8" fill="currentColor"/></svg>
            )}
            {p.icon === 'expand' && (
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 19V8l8-4 8 4v11" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 19v-6h6v6" stroke="currentColor" stroke-width="1.6"/></svg>
            )}
          </div>
          <div class="que-es__point-body">
            <h3>{p.titulo}</h3>
            <p>{p.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .que-es {
    position: relative;
    background: var(--color-bg);
  }

  .que-es__inner {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }
  @media (min-width: 960px) {
    .que-es__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
    }
  }

  /* ===== Sticky column ============================================ */
  .que-es__sticky {
    position: relative;
  }
  @media (min-width: 960px) {
    .que-es__sticky {
      position: sticky;
      top: calc(var(--header-height) + 2rem);
      align-self: start;
    }
  }
  .que-es__sticky-content {
    display: grid;
    gap: var(--space-4);
    max-width: 44ch;
  }

  .que-es__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.04;
    margin-block-start: var(--space-3);
  }
  .que-es__title em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .que-es__copy {
    display: grid;
    gap: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--leading-relaxed);
  }
  .que-es__copy strong { color: var(--color-text-primary); font-weight: var(--weight-semibold); }
  .que-es__copy em {
    font-style: normal;
    color: var(--color-text-primary);
    font-weight: var(--weight-semibold);
    background: linear-gradient(180deg, transparent 70%, oklch(from var(--color-accent-500) l c h / 0.2) 70%);
    padding-inline: 0.15em;
  }

  .que-es__indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-semibold);
  }
  .que-es__indicator-line {
    width: 2.5rem;
    height: 2px;
    background: var(--gradient-mixed);
    border-radius: 1px;
    transform-origin: left;
    animation: que-es-line 1.4s var(--ease-out-expo) backwards;
    animation-delay: 600ms;
  }
  @keyframes que-es-line {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .que-es__indicator-line { animation: none; }
  }

  /* ===== Points list =============================================== */
  .que-es__points {
    display: grid;
    gap: var(--space-2);
  }
  .que-es__point {
    position: relative;
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    transition: transform var(--dur-fast), border-color var(--dur-fast), box-shadow var(--dur-fast);
    align-items: center;
  }
  .que-es__point::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -8px;
    width: 8px;
    height: 0;
    background: var(--gradient-mixed);
    border-radius: 4px 0 0 4px;
    transform: translateY(-50%);
    transition: height var(--dur-normal) var(--ease-out-expo);
  }
  .que-es__point:hover {
    border-color: var(--color-brand-300);
    transform: translateX(6px);
    box-shadow: var(--shadow-card);
  }
  .que-es__point:hover::before { height: 60%; }

  .que-es__point-num {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: var(--weight-extrabold);
    color: oklch(from var(--color-brand-500) l c h / 0.12);
    letter-spacing: -0.04em;
    line-height: 1;
    width: 2.5ch;
    text-align: center;
  }

  .que-es__point-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.6rem;
    background: linear-gradient(135deg, var(--color-brand-50), var(--color-bg));
    color: var(--color-brand-600);
    display: grid;
    place-items: center;
    border: 1px solid var(--color-brand-100);
    flex-shrink: 0;
  }
  .que-es__point-icon svg { width: 1.25rem; height: 1.25rem; }

  .que-es__point-body h3 {
    font-size: var(--font-size-base);
    font-weight: var(--weight-semibold);
    margin-block-end: 0.2rem;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }
  .que-es__point-body p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--leading-relaxed);
  }

  /* Animar el num al hover */
  .que-es__point:hover .que-es__point-num { color: var(--color-brand-500); }
</style>
