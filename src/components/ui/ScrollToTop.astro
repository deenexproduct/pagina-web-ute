---
/**
 * Scroll-to-top button — aparece después de ~2500px de scroll.
 * Puro CSS + mínimo JS. No necesita React island.
 */
---

<button class="scroll-top" id="scroll-top-btn" type="button" aria-label="Volver al inicio" hidden>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <path
      d="M9 14V4M4 9l5-5 5 5"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const btn = document.getElementById('scroll-top-btn');
  if (btn) {
    const THRESHOLD = 2500;
    let ticking = false;

    const update = (): void => {
      btn.hidden = window.scrollY < THRESHOLD;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );

    btn.addEventListener('click', () => {
      const lenis = (window as unknown as { __lenis?: { scrollTo: (t: number) => void } }).__lenis;
      if (lenis) {
        lenis.scrollTo(0);
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }
</script>

<style>
  .scroll-top {
    position: fixed;
    bottom: clamp(1.25rem, 3vw, 2rem);
    right: clamp(1.25rem, 3vw, 2rem);
    z-index: calc(var(--z-sticky) + 10);
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background: var(--color-brand-500);
    color: var(--color-text-on-brand);
    display: grid;
    place-items: center;
    border: none;
    cursor: pointer;
    box-shadow:
      0 4px 14px oklch(from var(--color-brand-500) l c h / 0.35),
      0 1px 3px oklch(from var(--color-brand-500) l c h / 0.18);
    transition:
      transform var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-fast) var(--ease-standard),
      opacity var(--dur-normal) var(--ease-standard);
    opacity: 0;
    transform: translateY(8px) scale(0.92);
  }
  /* Cuando no está hidden, mostrar con animación */
  .scroll-top:not([hidden]) {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .scroll-top:hover {
    transform: translateY(-3px) scale(1.06);
    box-shadow:
      0 8px 22px oklch(from var(--color-brand-500) l c h / 0.45),
      0 2px 6px oklch(from var(--color-brand-500) l c h / 0.22);
  }
  .scroll-top:active {
    transform: translateY(0) scale(0.97);
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-top {
      transition: opacity var(--dur-normal);
    }
    .scroll-top:not([hidden]) {
      transform: none;
    }
    .scroll-top:hover {
      transform: none;
    }
  }
</style>
