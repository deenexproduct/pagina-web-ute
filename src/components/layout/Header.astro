---
import { NAV_PRIMARY, APP_BASE_URL, link } from '../../config/site';
---

<header class="site-header" data-header>
  <div class="site-header__inner container-content">
    <a class="site-header__brand" href={link('/')} aria-label="QUEM Central · inicio">
      <span class="brand-mark" aria-hidden="true">Q</span>
      <span class="brand-name">QUEM <em>Central</em></span>
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      <ul>
        {NAV_PRIMARY.filter((i) => i.href !== '/').map((item) => (
          <li>
            <a
              href={link(item.href)}
              class="nav-link"
              data-section={item.sectionId}
              data-nav-link
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn-primary site-header__cta" href={APP_BASE_URL} target="_blank" rel="noopener">
        Comprar online
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <button class="site-header__menu-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" data-menu-toggle>
        <span class="sr-only">Abrir menú</span>
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden data-mobile-nav>
    <nav aria-label="Navegación mobile">
      <ul>
        {NAV_PRIMARY.map((item) => (
          <li>
            <a
              href={link(item.href)}
              class="mobile-nav__link"
              data-menu-link
              data-section={item.sectionId}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a class="btn btn-primary mobile-nav__cta" href={APP_BASE_URL} target="_blank" rel="noopener">
            Comprar online
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  /* ─────────────────────────────────────────────────────────────────────
   * Header behavior — sticky scroll-class + mobile menu + scroll-spy
   * activo del nav según la sección visible en viewport.
   * ───────────────────────────────────────────────────────────────────── */
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobile-nav]') as HTMLElement | null;
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link], [data-menu-link]');

  /* mobile toggle */
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
      document.body.classList.toggle('has-mobile-nav-open', !open);
    });
    menuLinks.forEach((l) =>
      l.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
        document.body.classList.remove('has-mobile-nav-open');
      }),
    );
  }

  /* sticky scroll class */
  if (header) {
    const setScrolled = (): void => {
      header.classList.toggle('site-header--scrolled', window.scrollY > 8);
    };
    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });
  }

  /* scroll-spy: ilumina el nav según la sección visible */
  const sectionIds = Array.from(navLinks)
    .map((l) => l.dataset.section)
    .filter((s): s is string => Boolean(s) && s !== 'top');

  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((s): s is HTMLElement => Boolean(s));

  if (sections.length > 0 && 'IntersectionObserver' in window) {
    const setActive = (sectionId: string): void => {
      navLinks.forEach((l) => {
        const match = l.dataset.section === sectionId;
        l.classList.toggle('nav-link--active', match);
        l.classList.toggle('mobile-nav__link--active', match);
        if (match) {
          l.setAttribute('aria-current', 'true');
        } else {
          l.removeAttribute('aria-current');
        }
      });
    };

    /* Observamos cada sección. Cuando una entra al "carril" central del
     * viewport (rootMargin -25% top, -55% bottom = ~20% del viewport), la
     * marcamos como activa. Esto evita saltos al cambiar de sección. */
    const observer = new IntersectionObserver(
      (entries) => {
        /* Quedamos con la entrada más cercana al top del carril visible. */
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible && visible.target.id) {
          setActive(visible.target.id);
        }
      },
      { rootMargin: '-25% 0px -55% 0px', threshold: 0 },
    );

    sections.forEach((s) => observer.observe(s));

    /* Si estamos al tope, ningún item activo (limpio). */
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY < 120) {
          navLinks.forEach((l) => {
            l.classList.remove('nav-link--active', 'mobile-nav__link--active');
            l.removeAttribute('aria-current');
          });
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: oklch(from var(--color-bg) l c h / 0.78);
    backdrop-filter: blur(var(--header-blur));
    -webkit-backdrop-filter: blur(var(--header-blur));
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard),
                box-shadow var(--dur-fast) var(--ease-standard);
  }
  .site-header--scrolled {
    background-color: oklch(from var(--color-bg) l c h / 0.92);
    border-bottom-color: var(--color-border-subtle);
    box-shadow: var(--shadow-xs);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-height);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
  }
  .brand-name {
    font-size: var(--font-size-md);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .brand-name em {
    font-style: normal;
    color: var(--color-text-brand);
    font-weight: var(--weight-medium);
  }
  .brand-mark {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-700) 100%);
    color: var(--color-text-on-brand);
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 1.05rem;
    letter-spacing: -0.06em;
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.18),
      0 4px 12px oklch(42% 0.19 252 / 0.32);
  }
  .brand-mark::after {
    content: '';
    position: absolute;
    inset: 4px 4px auto auto;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent-500);
    box-shadow: 0 0 0 2px var(--color-bg);
  }

  .site-header__nav {
    flex: 1;
    display: none;
  }
  @media (min-width: 1024px) {
    .site-header__nav { display: block; }
  }
  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    justify-content: center;
  }
  .nav-link {
    position: relative;
    display: inline-block;
    font-size: var(--font-size-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    padding: 0.5rem 0;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-brand-500);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .nav-link:hover { color: var(--color-text-primary); }
  .nav-link:hover::after { transform: scaleX(1); }
  .nav-link--active {
    color: var(--color-text-primary);
    font-weight: var(--weight-semibold);
  }
  .nav-link--active::after { transform: scaleX(1); }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }
  .site-header__cta {
    padding: 0.7rem 1.1rem;
    font-size: var(--font-size-sm);
    box-shadow: 0 4px 12px oklch(62% 0.150 155 / 0.32);
  }
  .site-header__cta:hover {
    box-shadow: 0 6px 18px oklch(62% 0.150 155 / 0.40);
  }
  .site-header__menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
  }
  .site-header__menu-toggle:hover { background-color: var(--color-surface-subtle); }
  @media (min-width: 1024px) {
    .site-header__menu-toggle { display: none; }
  }

  .mobile-nav {
    border-top: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-elevated);
    padding-block: var(--space-4);
  }
  .mobile-nav ul {
    display: grid;
    gap: var(--space-1);
    padding-inline: var(--space-gutter);
  }
  .mobile-nav__link {
    display: block;
    padding: 0.85rem 0.5rem;
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-md);
  }
  .mobile-nav__link:hover { background-color: var(--color-surface-subtle); }
  .mobile-nav__link--active {
    background-color: var(--color-surface-subtle);
    color: var(--color-text-brand);
    box-shadow: inset 3px 0 0 var(--color-brand-500);
    font-weight: var(--weight-semibold);
  }
  .mobile-nav__cta {
    margin-block-start: var(--space-3);
    width: 100%;
  }

  :global(body.has-mobile-nav-open) { overflow: hidden; }
</style>
