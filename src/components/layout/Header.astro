---
import Logo from '../ui/Logo.astro';
import { NAV_PRIMARY, contactLink } from '../../config/site';
import type { NavKey } from '../../config/site';
import {
  ALL_LANGS,
  alternatePath,
  getLangFromUrl,
  localizedPath,
  useTranslations,
} from '../../i18n/utils';
import { LANGS } from '../../i18n/ui';
import type { Lang, UIKey } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const COPY = {
  es: { navMobile: 'Navegación principal, versión móvil' },
  en: { navMobile: 'Main navigation, mobile' },
} as const;
const c = COPY[lang];

/*
 * Contrato entre `NavKey` (site.ts) y las claves `nav.*` (ui.ts). Está
 * escrito a mano a propósito: si una de las dos listas cambia sin la
 * otra, esto deja de compilar en vez de renderizar una clave muerta.
 */
const NAV_LABEL: Record<NavKey, UIKey> = {
  nosotros: 'nav.nosotros',
  unidades: 'nav.unidades',
  ubicaciones: 'nav.ubicaciones',
  prensa: 'nav.prensa',
  contacto: 'nav.contacto',
};

const LANG_LABEL: Record<Lang, UIKey> = {
  es: 'lang.es',
  en: 'lang.en',
};

/* Los `sectionId` viajan al DOM como `data-section`: son la entrada del
   scroll-spy, que los matchea contra el `id` de cada <section>. */
const navItems = NAV_PRIMARY.map((item) => ({
  href: localizedPath(item.href, lang),
  label: t(NAV_LABEL[item.key]),
  sectionId: item.sectionId,
}));

const contactHref = contactLink(undefined, lang);

const homeHref = localizedPath('/', lang);

/* Selector de idioma — se renderiza dos veces (desktop + menú mobile),
   pero los datos se calculan una sola vez. */
const langItems = ALL_LANGS.map((l) => ({
  code: l,
  short: LANGS[l],
  href: alternatePath(Astro.url, l),
  name: t(LANG_LABEL[l]),
  active: l === lang,
}));
---

<header class="site-header" data-header>
  <div class="site-header__inner container-content">
    <a class="site-header__brand" href={homeHref} aria-label={t('nav.inicio')}>
      <Logo variant="header" />
    </a>

    <nav class="site-header__nav" aria-label={t('nav.aria')}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link" data-section={item.sectionId} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <div class="lang-switch site-header__lang" role="group" aria-label={t('lang.aria')}>
        {
          langItems.map((l) => (
            <a
              class="lang-switch__item"
              href={l.href}
              hreflang={l.code}
              lang={l.code}
              aria-current={l.active ? 'true' : undefined}
            >
              <span class="sr-only">{l.name}</span>
              <span aria-hidden="true">{l.short}</span>
            </a>
          ))
        }
      </div>

      <a class="btn btn-primary site-header__cta" href={contactHref}>
        {t('cta.contacto')}
      </a>

      <button
        class="site-header__menu-toggle"
        type="button"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-menu-toggle
        data-label-open={t('nav.abrir')}
        data-label-close={t('nav.cerrar')}
      >
        <span class="sr-only" data-menu-label>{t('nav.abrir')}</span>
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path
            d="M3 6h16M3 11h16M3 16h16"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden data-mobile-nav>
    <nav aria-label={c.navMobile}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="mobile-nav__link"
                data-menu-link
                data-section={item.sectionId}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="btn btn-primary mobile-nav__cta" href={contactHref} data-menu-link>
            {t('cta.contacto')}
          </a>
        </li>
      </ul>
    </nav>

    <div class="mobile-nav__lang">
      <div class="lang-switch" role="group" aria-label={t('lang.aria')}>
        {
          langItems.map((l) => (
            <a
              class="lang-switch__item"
              href={l.href}
              hreflang={l.code}
              lang={l.code}
              aria-current={l.active ? 'true' : undefined}
            >
              <span class="sr-only">{l.name}</span>
              <span aria-hidden="true">{l.short}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  /* ─────────────────────────────────────────────────────────────────────
   * Header behavior — sticky scroll-class + mobile menu + scroll-spy
   * activo del nav según la sección visible en viewport.
   * ───────────────────────────────────────────────────────────────────── */
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobile-nav]') as HTMLElement | null;
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(
    '[data-nav-link], [data-menu-link]',
  );

  /* Label del toggle: "Abrir menú" / "Cerrar menú", ya traducido y
     servido en data-attributes desde el frontmatter. */
  const menuLabel = toggle?.querySelector<HTMLElement>('[data-menu-label]') ?? null;
  const syncLabel = (open: boolean): void => {
    if (!toggle || !menuLabel) return;
    menuLabel.textContent = open
      ? (toggle.dataset.labelClose ?? '')
      : (toggle.dataset.labelOpen ?? '');
  };

  /* mobile toggle */
  const closeMenu = (): void => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'false');
    menu.hidden = true;
    document.body.classList.remove('has-mobile-nav-open');
    syncLabel(false);
  };

  if (toggle && menu) {
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
      document.body.classList.toggle('has-mobile-nav-open', !open);
      syncLabel(!open);
    });
    menuLinks.forEach((l) => l.addEventListener('click', closeMenu));

    /* Cerrar al click fuera del menu o del toggle */
    document.addEventListener('click', (e) => {
      if (menu.hidden) return;
      const target = e.target as Node;
      if (!menu.contains(target) && !toggle.contains(target)) {
        closeMenu();
      }
    });

    /* Cerrar con Escape */
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        closeMenu();
        toggle.focus();
      }
    });

    /* Si el viewport cruza al breakpoint desktop con el menú abierto, el
       toggle desaparece y el body queda con scroll bloqueado. Cerramos.
       (El 1024px espeja el media query del nav desktop de más abajo.) */
    const desktopQuery = window.matchMedia('(min-width: 1024px)');
    desktopQuery.addEventListener('change', (e) => {
      if (e.matches && !menu.hidden) closeMenu();
    });
  }

  /* Helper: scroll suave que respeta Lenis si está activo */
  const smoothScrollToTop = (): void => {
    const lenis = (window as unknown as { __lenis?: { scrollTo: (t: number) => void } }).__lenis;
    if (lenis) {
      lenis.scrollTo(0);
    } else {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  };

  /* Click en el logo: si ya estamos en la home, scroll suave al tope
     en lugar de un reload completo. Si estamos en otra ruta, dejamos
     que el navegador navegue normalmente. */
  const brandLink = document.querySelector<HTMLAnchorElement>('.site-header__brand');
  if (brandLink) {
    brandLink.addEventListener('click', (e) => {
      const homeHref = brandLink.getAttribute('href') ?? '/';
      const cleanPath = window.location.pathname.replace(/\/$/, '');
      const cleanHref = homeHref.replace(/\/$/, '');
      if (cleanPath === cleanHref) {
        e.preventDefault();
        smoothScrollToTop();
        /* También limpia el hash para evitar que un siguiente click recargue */
        if (window.location.hash) {
          history.replaceState(null, '', window.location.pathname);
        }
      }
    });
  }

  /* sticky scroll class */
  if (header) {
    const setScrolled = (): void => {
      header.classList.toggle('site-header--scrolled', window.scrollY > 8);
    };
    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });
  }

  /* scroll-spy: ilumina el nav según la sección visible */
  const sectionIds = Array.from(navLinks)
    .map((l) => l.dataset.section)
    .filter((s): s is string => Boolean(s) && s !== 'top');

  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((s): s is HTMLElement => Boolean(s));

  if (sections.length > 0 && 'IntersectionObserver' in window) {
    const setActive = (sectionId: string): void => {
      navLinks.forEach((l) => {
        const match = l.dataset.section === sectionId;
        l.classList.toggle('nav-link--active', match);
        l.classList.toggle('mobile-nav__link--active', match);
        if (match) {
          l.setAttribute('aria-current', 'true');
        } else {
          l.removeAttribute('aria-current');
        }
      });
    };

    /* Observamos cada sección. Cuando una entra al "carril" central del
     * viewport, la marcamos como activa. Esto evita saltos al cambiar
     * de sección. */
    const observer = new IntersectionObserver(
      (entries) => {
        /* Quedamos con la entrada más cercana al top del carril visible. */
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible && visible.target.id) {
          setActive(visible.target.id);
        }
      },
      /* Carril central más amplio para que el "scroll-to-section" via anchor
         click coincida con el indicator. Antes: -25% top + -55% bottom
         (carril de 20%) → el item activo a veces marcaba la sección de abajo.
         Ahora: -18% top + -40% bottom (carril de 42%) → más permisivo. */
      { rootMargin: '-18% 0px -40% 0px', threshold: 0 },
    );

    sections.forEach((s) => observer.observe(s));

    /* Si estamos al tope, ningún item activo (limpio). */
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY < 120) {
          navLinks.forEach((l) => {
            l.classList.remove('nav-link--active', 'mobile-nav__link--active');
            l.removeAttribute('aria-current');
          });
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: oklch(from var(--color-bg) l c h / 0.78);
    backdrop-filter: blur(var(--header-blur));
    -webkit-backdrop-filter: blur(var(--header-blur));
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-fast) var(--ease-standard);
  }
  .site-header--scrolled {
    background-color: oklch(from var(--color-bg) l c h / 0.92);
    border-bottom-color: var(--color-border-subtle);
    box-shadow: var(--shadow-xs);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    /* Gap dinámico — angosto en mobile, donde brand + CTA + toggle
       compiten por píxeles; más generoso en pantallas grandes. */
    gap: clamp(0.75rem, 1.4vw, var(--space-5));
    height: var(--header-height);
  }

  /* Wrapper del lockup: sólo layout. El dibujo del logo vive en Logo.astro. */
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-header__nav {
    flex: 1;
    display: none;
    /* Permite que el nav se comprima si el viewport es chico, en vez de
       expandir el container y empujar el CTA fuera del header. */
    min-width: 0;
  }
  /* Fase 1 dejó el nav en 5 items (antes eran 8), así que entra cómodo
     desde 1024px. Antes colapsaba recién en 1200 y dejaba un hueco raro
     en tablet. Debajo, el hamburger (que tiene los mismos items). */
  @media (min-width: 1024px) {
    .site-header__nav {
      display: block;
    }
  }
  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 0.6vw, 1rem);
    justify-content: center;
    flex-wrap: nowrap;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    font-size: clamp(0.83rem, 0.78rem + 0.18vw, 0.95rem);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    padding: 0.5rem 0.25rem;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-standard);
    /* Tipográfica fija — evita layout shift al cambiar weight en hover/active */
    text-rendering: geometricPrecision;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 22px;
    height: 2px;
    background: var(--color-brand-500);
    border-radius: 2px;
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .nav-link:hover {
    color: var(--color-text-primary);
  }
  .nav-link:hover::after {
    transform: translateX(-50%) scaleX(0.8);
  }
  .nav-link--active {
    color: var(--color-text-primary);
  }
  .nav-link--active::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* Focus-visible más limpio en nav — no outline cuadrado del global */
  .nav-link:focus-visible {
    outline: none;
    color: var(--color-text-brand);
  }
  .nav-link:focus-visible::after {
    transform: translateX(-50%) scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
    flex-shrink: 0;
  }

  /* ===== Selector de idioma ==============================================
   * Sobrio: dos letras separadas por una hairline. Sin banderas (una
   * bandera nunca representa bien un idioma) y sin dropdown (con dos
   * idiomas un dropdown es un click de más).
   * ===================================================================== */
  .lang-switch {
    display: inline-flex;
    align-items: center;
  }
  .lang-switch__item {
    display: inline-grid;
    place-items: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    padding-inline: var(--space-1);
    font-size: var(--font-size-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-muted);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .lang-switch__item + .lang-switch__item {
    border-inline-start: 1px solid var(--color-border-subtle);
  }
  .lang-switch__item:hover {
    color: var(--color-text-primary);
  }
  .lang-switch__item[aria-current] {
    color: var(--color-text-primary);
    font-weight: var(--weight-bold);
  }

  /* En el header sólo desde desktop: abajo vive dentro del menú mobile,
     así el CTA de conversión se queda con el ancho que necesita. */
  .site-header__lang {
    display: none;
  }
  @media (min-width: 1024px) {
    .site-header__lang {
      display: inline-flex;
    }
  }

  /* ===== CTA ============================================================
   * Sin `display:none` en mobile: el contacto ES el mecanismo de
   * conversión de la Fase 1, no puede desaparecer justo donde entra la
   * mayoría del tráfico.
   * ===================================================================== */
  .site-header__cta {
    padding: 0.6rem clamp(0.8rem, 0.6rem + 0.4vw, 1.1rem);
    font-size: clamp(0.83rem, 0.78rem + 0.18vw, 0.95rem);
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
  }
  .site-header__cta:hover {
    box-shadow: var(--shadow-md);
  }

  .site-header__menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
  }
  .site-header__menu-toggle:hover {
    background-color: var(--color-surface-subtle);
  }
  /* Coincide con el breakpoint del nav: el hamburger se esconde sólo
     cuando aparece el nav full. */
  @media (min-width: 1024px) {
    .site-header__menu-toggle {
      display: none;
    }
  }

  /* ===== Menú mobile ===================================================== */
  .mobile-nav {
    border-top: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-elevated);
    padding-block: var(--space-4);
  }
  /* Red de seguridad: en desktop no existe, aunque haya quedado abierto. */
  @media (min-width: 1024px) {
    .mobile-nav {
      display: none;
    }
  }
  .mobile-nav ul {
    display: grid;
    gap: var(--space-1);
    padding-inline: var(--space-gutter);
  }
  .mobile-nav__link {
    display: block;
    padding: 0.85rem 0.5rem;
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-md);
  }
  .mobile-nav__link:hover {
    background-color: var(--color-surface-subtle);
  }
  .mobile-nav__link--active {
    background-color: var(--color-surface-subtle);
    color: var(--color-text-brand);
    font-weight: var(--weight-semibold);
  }
  .mobile-nav__cta {
    margin-block-start: var(--space-3);
    width: 100%;
  }

  .mobile-nav__lang {
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-4);
    padding-inline: var(--space-gutter);
    border-block-start: 1px solid var(--color-border-subtle);
  }
  .mobile-nav__lang .lang-switch__item {
    min-inline-size: 56px;
    font-size: var(--font-size-sm);
  }

  :global(body.has-mobile-nav-open) {
    overflow: hidden;
  }
</style>
