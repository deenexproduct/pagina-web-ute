---
import { NAV_PRIMARY, APP_BASE_URL } from '../../config/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string): boolean => {
  if (href === '/') return pathname === '/';
  if (href.startsWith('/#')) return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
};
---

<header class="site-header" data-header>
  <div class="site-header__inner container-content">
    <a class="site-header__brand" href="/" aria-label="QUEM Central · inicio">
      <span class="brand-mark" aria-hidden="true">Q</span>
      <span class="brand-name">QUEM <em>Central</em></span>
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      <ul>
        {NAV_PRIMARY.filter((i) => i.href !== '/').map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', isActive(item.href) && 'nav-link--active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn-primary site-header__cta" href={APP_BASE_URL} target="_blank" rel="noopener">
        Comprar online
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <button class="site-header__menu-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" data-menu-toggle>
        <span class="sr-only">Abrir menú</span>
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden data-mobile-nav>
    <nav aria-label="Navegación mobile">
      <ul>
        {NAV_PRIMARY.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav__link" data-menu-link>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a class="btn btn-primary mobile-nav__cta" href={APP_BASE_URL} target="_blank" rel="noopener">
            Comprar online
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobile-nav]') as HTMLElement | null;
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
      document.body.classList.toggle('has-mobile-nav-open', !open);
    });
    links.forEach((l) =>
      l.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
        document.body.classList.remove('has-mobile-nav-open');
      }),
    );
  }

  if (header) {
    const setScrolled = (): void => {
      header.classList.toggle('site-header--scrolled', window.scrollY > 8);
    };
    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: oklch(from var(--color-bg) l c h / 0.78);
    backdrop-filter: blur(var(--header-blur));
    -webkit-backdrop-filter: blur(var(--header-blur));
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard),
                box-shadow var(--dur-fast) var(--ease-standard);
  }
  .site-header--scrolled {
    background-color: oklch(from var(--color-bg) l c h / 0.92);
    border-bottom-color: var(--color-border-subtle);
    box-shadow: var(--shadow-xs);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-height);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
  }
  .brand-name { font-size: var(--font-size-md); }
  .brand-name em {
    font-style: normal;
    color: var(--color-text-brand);
    font-weight: var(--weight-medium);
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-md);
    background: var(--color-brand-500);
    color: var(--color-text-on-brand);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .site-header__nav {
    flex: 1;
    display: none;
  }
  @media (min-width: 1024px) {
    .site-header__nav { display: block; }
  }
  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    justify-content: center;
  }
  .nav-link {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    padding: 0.5rem 0.25rem;
    border-radius: var(--radius-sm);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .nav-link:hover,
  .nav-link--active {
    color: var(--color-text-primary);
  }
  .nav-link--active {
    box-shadow: inset 0 -2px 0 var(--color-brand-500);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }
  .site-header__cta {
    padding: 0.7rem 1.1rem;
    font-size: var(--font-size-sm);
  }
  .site-header__menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
  }
  .site-header__menu-toggle:hover { background-color: var(--color-surface-subtle); }
  @media (min-width: 1024px) {
    .site-header__menu-toggle { display: none; }
  }

  .mobile-nav {
    border-top: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-elevated);
    padding-block: var(--space-4);
  }
  .mobile-nav ul {
    display: grid;
    gap: var(--space-1);
    padding-inline: var(--space-gutter);
  }
  .mobile-nav__link {
    display: block;
    padding: 0.85rem 0.5rem;
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-md);
  }
  .mobile-nav__link:hover { background-color: var(--color-surface-subtle); }
  .mobile-nav__cta {
    margin-block-start: var(--space-3);
    width: 100%;
  }

  :global(body.has-mobile-nav-open) { overflow: hidden; }
</style>
