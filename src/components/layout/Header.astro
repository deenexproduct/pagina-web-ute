---
import { NAV_PRIMARY, APP_IS_LIVE, buyOnlineLink, link } from '../../config/site';

const buyHref = buyOnlineLink();
/* Si la app NO está live, el CTA cae al form interno → no target=_blank */
const buyTargetProps = APP_IS_LIVE
  ? { target: '_blank', rel: 'noopener' }
  : {};
---

<header class="site-header" data-header>
  <div class="site-header__inner container-content">
    <a class="site-header__brand" href={link('/')} aria-label="Qüem Central · inicio">
      <span class="brand-mark" aria-hidden="true">Q</span>
      <span class="brand-name">Qüem <em>Central</em></span>
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      <ul>
        {NAV_PRIMARY.filter((i) => i.href !== '/').map((item) => (
          <li>
            <a
              href={link(item.href)}
              class="nav-link"
              data-section={item.sectionId}
              data-nav-link
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn-primary site-header__cta" href={buyHref} {...buyTargetProps}>
        Comprar online
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3.5 10.5 10.5 3.5M10.5 3.5H5M10.5 3.5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <button class="site-header__menu-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" data-menu-toggle>
        <span class="sr-only">Abrir menú</span>
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden data-mobile-nav>
    <nav aria-label="Navegación mobile">
      <ul>
        {NAV_PRIMARY.map((item) => (
          <li>
            <a
              href={link(item.href)}
              class="mobile-nav__link"
              data-menu-link
              data-section={item.sectionId}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a class="btn btn-primary mobile-nav__cta" href={buyHref} {...buyTargetProps}>
            Comprar online
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  /* ─────────────────────────────────────────────────────────────────────
   * Header behavior — sticky scroll-class + mobile menu + scroll-spy
   * activo del nav según la sección visible en viewport.
   * ───────────────────────────────────────────────────────────────────── */
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobile-nav]') as HTMLElement | null;
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link], [data-menu-link]');

  /* mobile toggle */
  const closeMenu = (): void => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'false');
    menu.hidden = true;
    document.body.classList.remove('has-mobile-nav-open');
  };

  if (toggle && menu) {
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
      document.body.classList.toggle('has-mobile-nav-open', !open);
    });
    menuLinks.forEach((l) => l.addEventListener('click', closeMenu));

    /* Cerrar al click fuera del menu o del toggle */
    document.addEventListener('click', (e) => {
      if (menu.hidden) return;
      const target = e.target as Node;
      if (!menu.contains(target) && !toggle.contains(target)) {
        closeMenu();
      }
    });

    /* Cerrar con Escape */
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        closeMenu();
        toggle.focus();
      }
    });
  }

  /* Helper: scroll suave que respeta Lenis si está activo */
  const smoothScrollToTop = (): void => {
    const lenis = (window as unknown as { __lenis?: { scrollTo: (t: number) => void } }).__lenis;
    if (lenis) {
      lenis.scrollTo(0);
    } else {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  };

  /* Click en el logo: si ya estamos en la home, scroll suave al tope
     en lugar de un reload completo. Si estamos en /corner-quem u otra
     ruta, dejamos que el navegador navegue normalmente. */
  const brandLink = document.querySelector<HTMLAnchorElement>('.site-header__brand');
  if (brandLink) {
    brandLink.addEventListener('click', (e) => {
      const homeHref = brandLink.getAttribute('href') ?? '/';
      const cleanPath = window.location.pathname.replace(/\/$/, '');
      const cleanHref = homeHref.replace(/\/$/, '');
      if (cleanPath === cleanHref) {
        e.preventDefault();
        smoothScrollToTop();
        /* También limpia el hash para evitar que un siguiente click recargue */
        if (window.location.hash) {
          history.replaceState(null, '', window.location.pathname);
        }
      }
    });
  }

  /* sticky scroll class */
  if (header) {
    const setScrolled = (): void => {
      header.classList.toggle('site-header--scrolled', window.scrollY > 8);
    };
    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });
  }

  /* scroll-spy: ilumina el nav según la sección visible */
  const sectionIds = Array.from(navLinks)
    .map((l) => l.dataset.section)
    .filter((s): s is string => Boolean(s) && s !== 'top');

  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((s): s is HTMLElement => Boolean(s));

  if (sections.length > 0 && 'IntersectionObserver' in window) {
    const setActive = (sectionId: string): void => {
      navLinks.forEach((l) => {
        const match = l.dataset.section === sectionId;
        l.classList.toggle('nav-link--active', match);
        l.classList.toggle('mobile-nav__link--active', match);
        if (match) {
          l.setAttribute('aria-current', 'true');
        } else {
          l.removeAttribute('aria-current');
        }
      });
    };

    /* Observamos cada sección. Cuando una entra al "carril" central del
     * viewport (rootMargin -25% top, -55% bottom = ~20% del viewport), la
     * marcamos como activa. Esto evita saltos al cambiar de sección. */
    const observer = new IntersectionObserver(
      (entries) => {
        /* Quedamos con la entrada más cercana al top del carril visible. */
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible && visible.target.id) {
          setActive(visible.target.id);
        }
      },
      /* Carril central más amplio para que el "scroll-to-section" via anchor
         click coincida con el indicator. Antes: -25% top + -55% bottom
         (carril de 20%) → el item activo a veces marcaba la sección de abajo.
         Ahora: -18% top + -40% bottom (carril de 42%) → más permisivo. */
      { rootMargin: '-18% 0px -40% 0px', threshold: 0 },
    );

    sections.forEach((s) => observer.observe(s));

    /* Si estamos al tope, ningún item activo (limpio). */
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY < 120) {
          navLinks.forEach((l) => {
            l.classList.remove('nav-link--active', 'mobile-nav__link--active');
            l.removeAttribute('aria-current');
          });
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: oklch(from var(--color-bg) l c h / 0.78);
    backdrop-filter: blur(var(--header-blur));
    -webkit-backdrop-filter: blur(var(--header-blur));
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard),
                box-shadow var(--dur-fast) var(--ease-standard);
  }
  .site-header--scrolled {
    background-color: oklch(from var(--color-bg) l c h / 0.92);
    border-bottom-color: var(--color-border-subtle);
    box-shadow: var(--shadow-xs);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    /* Gap dinámico — angosto en laptops chicas (1100-1280px) donde el nav
       compite por píxeles con brand + CTA, más generoso en pantallas grandes. */
    gap: clamp(0.75rem, 1.4vw, var(--space-5));
    height: var(--header-height);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
  }
  .brand-name {
    font-size: var(--font-size-md);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .brand-name em {
    font-style: normal;
    color: var(--color-text-brand);
    font-weight: var(--weight-medium);
  }
  .brand-mark {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    background: linear-gradient(135deg, var(--color-brand-500) 0%, var(--color-brand-700) 100%);
    color: var(--color-text-on-brand);
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 1.05rem;
    letter-spacing: -0.06em;
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.18),
      0 4px 12px oklch(from var(--color-brand-500) l c h / 0.32);
  }
  .brand-mark::after {
    content: '';
    position: absolute;
    inset: 4px 4px auto auto;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent-500);
    box-shadow: 0 0 0 2px var(--color-bg);
  }

  .site-header__nav {
    flex: 1;
    display: none;
    /* Permite que el nav se comprima si el viewport es chico, en vez de
       expandir el container y empujar el CTA fuera del header. */
    min-width: 0;
  }
  /* Subimos el breakpoint a 1200px — con 8 items + brand + CTA en 1024-1199
     todo quedaba demasiado apretado y los labels se superponían con el brand.
     Por debajo seguimos con el hamburger menu (que ya tiene todos los items). */
  @media (min-width: 1200px) {
    .site-header__nav { display: block; }
  }
  .site-header__nav ul {
    display: flex;
    align-items: center;
    /* Gap entre items: angosto en 1100-1280, más holgado en >1440. */
    gap: clamp(0.5rem, 0.6vw, 1rem);
    justify-content: center;
    flex-wrap: nowrap;
  }
  .nav-link {
    position: relative;
    display: inline-block;
    /* Tipografía un punto más chica en el nav desktop — los items son muchos
       y van a tener que convivir con el resto del header. El font-size-sm
       de fluid type sigue siendo legible. */
    font-size: clamp(0.83rem, 0.78rem + 0.18vw, 0.95rem);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    padding: 0.5rem 0.25rem;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-standard);
    /* Tipográfica fija — evita layout shift al cambiar weight en hover/active */
    text-rendering: geometricPrecision;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 22px;
    height: 2px;
    background: var(--color-brand-500);
    border-radius: 2px;
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-normal) var(--ease-out-expo);
  }
  .nav-link:hover { color: var(--color-text-primary); }
  .nav-link:hover::after { transform: translateX(-50%) scaleX(0.8); }
  .nav-link--active { color: var(--color-text-primary); }
  .nav-link--active::after { transform: translateX(-50%) scaleX(1); }

  /* Focus-visible más limpio en nav — no outline cuadrado del global */
  .nav-link:focus-visible {
    outline: none;
    color: var(--color-text-brand);
  }
  .nav-link:focus-visible::after {
    transform: translateX(-50%) scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
    flex-shrink: 0;
  }
  /* Hide CTA from header on small screens — the mobile nav dropdown already has it */
  @media (max-width: 639px) {
    .site-header__cta { display: none; }
  }
  .site-header__cta {
    /* Padding más compacto en desktop para liberar espacio al nav. En pantallas
       grandes (>1440px) recuperamos el padding original via clamp. */
    padding: 0.6rem clamp(0.8rem, 0.6rem + 0.4vw, 1.1rem);
    font-size: clamp(0.83rem, 0.78rem + 0.18vw, 0.95rem);
    box-shadow: 0 4px 12px oklch(from var(--color-brand-500) l c h / 0.28);
    white-space: nowrap;
  }
  .site-header__cta:hover {
    box-shadow: 0 6px 18px oklch(from var(--color-brand-500) l c h / 0.38);
  }
  .site-header__menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
  }
  .site-header__menu-toggle:hover { background-color: var(--color-surface-subtle); }
  /* Coincide con el breakpoint del nav: hamburger se esconde sólo cuando aparece el nav full. */
  @media (min-width: 1200px) {
    .site-header__menu-toggle { display: none; }
  }

  .mobile-nav {
    border-top: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-elevated);
    padding-block: var(--space-4);
  }
  .mobile-nav ul {
    display: grid;
    gap: var(--space-1);
    padding-inline: var(--space-gutter);
  }
  .mobile-nav__link {
    display: block;
    padding: 0.85rem 0.5rem;
    color: var(--color-text-primary);
    font-size: var(--font-size-md);
    font-weight: var(--weight-medium);
    border-radius: var(--radius-md);
  }
  .mobile-nav__link:hover { background-color: var(--color-surface-subtle); }
  .mobile-nav__link--active {
    background-color: var(--color-surface-subtle);
    color: var(--color-text-brand);
    font-weight: var(--weight-semibold);
  }
  .mobile-nav__cta {
    margin-block-start: var(--space-3);
    width: 100%;
  }

  :global(body.has-mobile-nav-open) { overflow: hidden; }
</style>
