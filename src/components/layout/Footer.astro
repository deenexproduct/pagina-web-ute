---
import { link } from '../../config/site';

/**
 * Footer minimalista v4 — solo brand centrado + credit centrado.
 *
 * Diseño:
 *   1) Top row: brand logo + name, centrado
 *   2) Bottom bar: credit "Creado por Deenex" centrado
 *
 * Nav, CTA, copyright legal, email y socials eliminados — el header sticky
 * con "Comprar online" siempre visible cubre la conversión.
 */
---

<footer class="site-footer">
  <div class="container-content site-footer__inner">
    <a href={link('/')} class="site-footer__brand" aria-label="Qüem Central · inicio">
      <span class="brand-mark" aria-hidden="true">Q</span>
      <span class="site-footer__brand-name">Qüem <em>Central</em></span>
    </a>
  </div>

  <div class="container-content site-footer__bar">
    <span class="site-footer__credit">
      Creado por <a href="https://deenex.com" target="_blank" rel="noopener">Deenex</a> — Software para cadenas gastronómicas
    </span>
  </div>
</footer>

<style>
  /* ===== Shell — fondo claro, separador sutil del contenido ============== */
  .site-footer {
    background-color: var(--color-surface-subtle);
    color: var(--color-text-secondary);
    border-top: 1px solid var(--color-border-subtle);
    margin-top: var(--space-9);
  }

  /* ===== Top row — brand centrado ========================================= */
  .site-footer__inner {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: var(--space-7) var(--space-6);
  }

  /* Brand */
  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-block-size: 44px;
    font-family: var(--font-display);
    color: var(--color-text-primary);
    width: max-content;
  }
  .site-footer__brand .brand-mark {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    background: var(--gradient-brand);
    color: var(--color-text-on-brand);
    display: inline-grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: 1.05rem;
    letter-spacing: -0.06em;
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.18),
      0 4px 12px oklch(60% 0.030 100 / 0.20);
  }
  .site-footer__brand .brand-mark::after {
    content: '';
    position: absolute;
    inset: 4px 4px auto auto;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--color-accent-500);
    box-shadow: 0 0 0 2px var(--color-surface-subtle);
  }
  .site-footer__brand-name {
    font-size: var(--font-size-md);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    white-space: nowrap;
  }
  .site-footer__brand-name em {
    font-style: normal;
    color: var(--color-text-brand);
    font-weight: var(--weight-medium);
  }

  /* ===== Bottom bar — credit centrado ===================================== */
  .site-footer__bar {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-block: var(--space-4) var(--space-5);
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-align: center;
  }
  .site-footer__credit {
    color: var(--color-text-secondary);
  }
  .site-footer__credit a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--dur-fast), color var(--dur-fast);
  }
  .site-footer__credit a:hover {
    color: var(--color-text-primary);
    text-decoration-color: var(--color-brand-500);
  }
</style>
</content>
</invoke>
