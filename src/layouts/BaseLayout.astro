---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SmoothScrollLenis from '../components/SmoothScrollLenis.astro';
// @ts-ignore — woff2 importado como URL hashed por Vite para preload dinámico
import interFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import ScrollToTop from '../components/ui/ScrollToTop.astro';
import { SEO, SITE_URL, ADDRESS, ANALYTICS, link } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonicalPath?: string;
}

const {
  title,
  description = SEO.defaultDescription,
  image = SEO.defaultOgImage,
  noindex = false,
  canonicalPath,
} = Astro.props;

const fullTitle = title
  ? SEO.titleTemplate.replace('%s', title)
  : SEO.defaultTitle;

/*
 * Canonical y OG image son absolutos. Si Astro está configurado con `base`
 * (caso GH Pages preview = /quem-central-preview/), hay que componer la URL
 * RELATIVA al base path, no a la raíz del dominio. `link()` se encarga.
 */
const canonical = new URL(link(canonicalPath ?? Astro.url.pathname), Astro.site ?? SITE_URL).toString();
const ogImage = image.startsWith('http')
  ? image
  : new URL(link(image), Astro.site ?? SITE_URL).toString();

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SEO.siteName,
  url: SITE_URL,
  logo: new URL('/favicon.svg', SITE_URL).toString(),
  description: SEO.defaultDescription,
  ...(ADDRESS.country
    ? {
        address: {
          '@type': 'PostalAddress',
          ...(ADDRESS.streetAddress ? { streetAddress: ADDRESS.streetAddress } : {}),
          ...(ADDRESS.city ? { addressLocality: ADDRESS.city } : {}),
          ...(ADDRESS.region ? { addressRegion: ADDRESS.region } : {}),
          ...(ADDRESS.postalCode ? { postalCode: ADDRESS.postalCode } : {}),
          addressCountry: ADDRESS.country,
        },
      }
    : {}),
};

const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SEO.siteName,
  url: SITE_URL,
  image: ogImage,
  description: SEO.defaultDescription,
  priceRange: '$$',
  ...(ADDRESS.country
    ? {
        address: {
          '@type': 'PostalAddress',
          ...(ADDRESS.streetAddress ? { streetAddress: ADDRESS.streetAddress } : {}),
          ...(ADDRESS.city ? { addressLocality: ADDRESS.city } : {}),
          ...(ADDRESS.region ? { addressRegion: ADDRESS.region } : {}),
          ...(ADDRESS.postalCode ? { postalCode: ADDRESS.postalCode } : {}),
          addressCountry: ADDRESS.country,
        },
      }
    : {}),
};
---

<!doctype html>
<html lang="es-AR" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SEO.keywords.join(', ')} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta name="theme-color" content="#f8f9fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e15" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SEO.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={SEO.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {SEO.twitterHandle && <meta name="twitter:site" content={SEO.twitterHandle} />}

    <!-- Favicons (placeholders — reemplazar cuando llegue logo final) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- PWA manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!--
      Preload Inter Variable latin para que arranque a descargar antes de que
      el CSS procese el @font-face. Elimina el FOIT en above-the-fold.
    -->
    <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />

    {/* Analytics — solo si ANALYTICS.plausibleDomain está seteado en site.ts.
        Plausible: sin cookies, GDPR-friendly, ~1KB script, no requiere banner. */}
    {ANALYTICS.plausibleDomain && (
      <script
        is:inline
        defer
        data-domain={ANALYTICS.plausibleDomain}
        src={`${ANALYTICS.plausibleHost}/js/script.outbound-links.js`}
      ></script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <!-- Scroll progress bar (top of viewport) -->
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>

    <SmoothScrollLenis />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />

    <script>
      /* ===============================================================
       * Global motion behaviors
       *  1. [data-reveal] → IntersectionObserver activa entrada
       *  2. [data-counter] → cuenta de 0 a target cuando entra al viewport
       *  3. Scroll progress bar arriba del viewport
       *  4. Parallax sutil para [data-parallax]
       * Todo respeta prefers-reduced-motion.
       * =============================================================== */
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* 1) Reveal on scroll — progressive enhancement
       *
       * El CSS por default muestra todo visible. Solo cuando agregamos
       * data-reveal-ready al html, el CSS activa los estados ocultos.
       * Esto garantiza que el contenido NUNCA queda invisible si JS falla.
       *
       * Flow:
       *  1. Marca html como reveal-ready → el CSS oculta elementos data-reveal
       *  2. IntersectionObserver con rootMargin generoso (200px preload)
       *  3. Safety net en scroll + hashchange + setTimeout 1.5s flushPassed
       */
      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (revealEls.length > 0 && !reduceMotion && 'IntersectionObserver' in window) {
        /* Activar modo reveal (esconder elementos para animarlos al entrar) */
        document.documentElement.setAttribute('data-reveal-ready', '');

        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).dataset.revealed = '';
                obs.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px 200px 0px', threshold: 0 },
        );
        revealEls.forEach((el) => obs.observe(el));

        /* Safety net: si el usuario teletransporta vía anchor o scrollea
         * muy rápido, fuerza reveal de cualquier elemento ya pasado. */
        const flushPassed = (): void => {
          revealEls.forEach((el) => {
            if (el.dataset.revealed === undefined) {
              const r = el.getBoundingClientRect();
              if (r.bottom < 0 || r.top < window.innerHeight) {
                if (r.bottom < 0) {
                  /* Ya pasó por encima — reveal instantáneo, sin transición
                   * (evita el blank de 800-1200ms en navegación por anchor). */
                  (el as HTMLElement).style.transition = 'none';
                  el.dataset.revealed = '';
                  requestAnimationFrame(() => { (el as HTMLElement).style.transition = ''; });
                } else {
                  el.dataset.revealed = '';
                }
                obs.unobserve(el);
              }
            }
          });
        };
        window.addEventListener('scroll', flushPassed, { passive: true });
        window.addEventListener('hashchange', () => setTimeout(flushPassed, 100));
        setTimeout(flushPassed, 1500);
      }
      /* Si no hay IntersectionObserver o reduce-motion, no activamos data-reveal-ready
       * → el CSS deja todo visible por default. Done. */

      /* 2) Number counter */
      const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
      if (counters.length > 0 && !reduceMotion && 'IntersectionObserver' in window) {
        const fmt = (n: number, suffix = ''): string => {
          if (n >= 1_000_000) return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M' + suffix;
          if (n >= 1_000) return (n / 1_000).toFixed(1).replace(/\.0$/, '') + 'K' + suffix;
          return Math.round(n).toString() + suffix;
        };
        const animate = (el: HTMLElement): void => {
          const target = Number(el.dataset.counter ?? '0');
          const suffix = el.dataset.counterSuffix ?? '';
          const duration = Number(el.dataset.counterDuration ?? '1400');
          const start = performance.now();
          const tick = (now: number): void => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3); // ease-out-cubic
            el.textContent = fmt(target * eased, suffix);
            if (t < 1) requestAnimationFrame(tick);
            else el.textContent = fmt(target, suffix);
          };
          requestAnimationFrame(tick);
        };
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                animate(e.target as HTMLElement);
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.3 },
        );
        counters.forEach((el) => obs.observe(el));
      } else {
        counters.forEach((el) => { el.textContent = el.dataset.counter ?? ''; });
      }

      /* 3) Scroll progress bar */
      const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');
      if (progressBar && !reduceMotion) {
        const update = (): void => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const pct = max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0;
          progressBar.style.setProperty('--progress', String(pct));
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update, { passive: true });
      }

      /* 4) Parallax sutil — elementos con data-parallax="0.3" */
      const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');
      if (parallaxEls.length > 0 && !reduceMotion && window.matchMedia('(min-width: 768px)').matches) {
        const apply = (): void => {
          const y = window.scrollY;
          parallaxEls.forEach((el) => {
            const speed = Number(el.dataset.parallax ?? '0.3');
            el.style.setProperty('--parallax-y', `${y * speed}px`);
          });
        };
        apply();
        window.addEventListener('scroll', apply, { passive: true });
      }
    </script>

    <style>
      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        z-index: 500;
        pointer-events: none;
        background: transparent;
      }
      .scroll-progress::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, var(--color-brand-500), var(--color-accent-500));
        transform-origin: left center;
        transform: scaleX(calc(var(--progress, 0) / 100));
        transition: transform 80ms linear;
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-progress { display: none; }
      }
    </style>
  </body>
</html>
