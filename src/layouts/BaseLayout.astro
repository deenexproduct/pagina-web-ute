---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SmoothScrollLenis from '../components/SmoothScrollLenis.astro';
import interFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import ScrollToTop from '../components/ui/ScrollToTop.astro';
import SocialDock from '../components/ui/SocialDock.astro';
import {
  SEO,
  SITE_URL,
  SITE_DOMAIN,
  BRAND,
  ADDRESS,
  EMAILS,
  WHATSAPP,
  ANALYTICS,
  activeSocials,
  hasAddress,
  hasWhatsapp,
  whatsappLink,
  link,
} from '../config/site';
import { LOCALE } from '../i18n/ui';
import {
  getLangFromUrl,
  useTranslations,
  alternatePath,
  ALL_LANGS,
  DEFAULT_LANG,
} from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonicalPath?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = t('seo.description'),
  image = SEO.defaultOgImage,
  noindex = false,
  canonicalPath,
} = Astro.props;

/* Copy propio del layout (no lo comparte ninguna sección). */
const COPY = {
  es: { ogImageAlt: 'QUEM — grupo de alimentos congelados' },
  en: { ogImageAlt: 'QUEM — frozen food group' },
} as const;
const c = COPY[lang];

/**
 * Plantilla de título para páginas con `title` propio.
 * La home no la usa: manda `t('seo.title')` entero.
 */
const pageTitle = (name: string): string => `${name} | ${SEO.siteName}`;
const fullTitle = title ? pageTitle(title) : t('seo.title');

/* -------------------------------------------------------------------------- */
/*  URLs ABSOLUTAS — canonical, hreflang, OG                                  */
/* -------------------------------------------------------------------------- */

const site = Astro.site ?? new URL(SITE_URL);

/**
 * ¿Este build es el preview o el dominio real?
 *
 * `Astro.site` sale de `PUBLIC_SITE`, así que en el deploy de GitHub Pages
 * vale `deenexproduct.github.io` y en el dominio final vale `SITE_DOMAIN`.
 * El preview NO puede salir indexable: sería una segunda copia del sitio
 * compitiendo con el dominio institucional por las mismas queries.
 *
 * Se deriva del host en vez de un flag manual para que se corrija solo el
 * día que se conecte el dominio: ahí el build vuelve a ser indexable sin
 * que nadie tenga que acordarse de dar vuelta nada.
 */
const esPreview = site.host !== SITE_DOMAIN;

/**
 * `astro.config.mjs` declara `trailingSlash: 'never'`, y el sitemap emite
 * las URLs sin barra final. El canonical tiene que decir lo mismo o Google
 * ve dos variantes de cada página. La raíz conserva su única barra porque
 * un origen sin path no existe.
 */
const stripTrailingSlash = (path: string): string =>
  path.length > 1 ? path.replace(/\/+$/, '') || '/' : path;

const absolute = (path: string): string => new URL(stripTrailingSlash(path), site).toString();

/**
 * Canonical:
 *   - `canonicalPath` (prop) es RELATIVO al site root (ej: '/corner-quem'),
 *     así que pasa por link() para prefijar el base path.
 *   - Sin prop, `Astro.url.pathname` YA incluye el base path: usarlo tal
 *     cual, sin link() (sino se duplicaría el base). Se toma el pathname y
 *     no la URL entera para que el querystring no genere canonicals duplicados
 *     (ej: `/?interes=corner`).
 */
const canonical = absolute(canonicalPath ? link(canonicalPath) : Astro.url.pathname);

/** Raíz del sitio ya resuelta (respeta base path). Ancla los @id del JSON-LD. */
const siteRoot = absolute(link('/'));

/* La OG image siempre es relativa al site root → pasa por link(). */
const ogImage = image.startsWith('http') ? image : absolute(link(image));
/* La OG por default es un raster de 1200×630 (medida fija del asset). Si una
   página pasa la suya, no podemos afirmar sus dimensiones. */
const OG_DEFAULT_SIZE = { width: 1200, height: 630 } as const;
const usingDefaultOg = image === SEO.defaultOgImage;
const defaultOgUrl = absolute(link(SEO.defaultOgImage));

/**
 * hreflang: una entrada por idioma + x-default.
 *
 * Se declara el idioma base (`es` / `en`) y no el locale completo: el sitio
 * opera en AR pero el contenido en español sirve a cualquier hispanohablante,
 * y `es-AR` lo restringiría a Argentina. `<html lang>` sí lleva el locale
 * completo, que es donde importa para lectores de pantalla.
 *
 * Las páginas noindex no publican alternates: no hay nada que agrupar.
 */
const alternates: ReadonlyArray<{ hreflang: string; href: string }> = noindex
  ? []
  : ALL_LANGS.map((l) => ({ hreflang: l, href: absolute(alternatePath(Astro.url, l)) }));
const xDefaultHref = noindex ? '' : absolute(alternatePath(Astro.url, DEFAULT_LANG));

/* -------------------------------------------------------------------------- */
/*  SCHEMA.ORG                                                                */
/* -------------------------------------------------------------------------- */

/**
 * Un solo `@graph` con nodos referenciables por `@id`, en vez de dos bloques
 * sueltos que se contradecían.
 *
 * Se ELIMINÓ el nodo `LocalBusiness`: se declaraba sin dirección (señal
 * negativa para Google) y, aunque la tuviéramos, la casa central es una
 * oficina, no un local con horarios ni rango de precios. Los locales reales
 * son las tiendas del mapa (spec punto 7) y les corresponde emitir sus
 * propios `Place`/`Store` desde esa sección, no desde el layout.
 * La dirección, cuando el cliente la confirme, cuelga de `Organization`.
 */
type JsonLdNode = Record<string, unknown>;

const ORG_ID = `${siteRoot}#organization`;
const SITE_ID = `${siteRoot}#website`;

const socialUrls = activeSocials().map((s) => s.url);

/* Solo canales que existen de verdad: un contactPoint vacío no ayuda a nadie. */
const contactPoints: JsonLdNode[] = [
  ...(hasWhatsapp()
    ? [
        {
          '@type': 'ContactPoint',
          contactType: 'customer service',
          telephone: `+${WHATSAPP}`,
          url: whatsappLink(),
          availableLanguage: ALL_LANGS,
        },
      ]
    : []),
  ...(EMAILS.comercial
    ? [
        {
          '@type': 'ContactPoint',
          contactType: 'sales',
          email: EMAILS.comercial,
          availableLanguage: ALL_LANGS,
        },
      ]
    : []),
];

const organizationNode: JsonLdNode = {
  '@type': 'Organization',
  '@id': ORG_ID,
  /* QUEM es la marca madre; "Qüem Central" es una de sus 4 unidades. */
  name: BRAND.group,
  legalName: BRAND.legal,
  url: siteRoot,
  /* Descripción de la EMPRESA, no de la página: si una subpágina pasa su
     propia `description`, el nodo Organization no debe heredarla. */
  description: t('seo.orgDescription'),
  /* Con el logo definitivo cargado se publica ése. Mientras no esté,
     `favicon.svg` son 404 bytes y no llega al mínimo de 112px que Google pide
     para `logo`, así que se usa la OG, que es raster y declara medidas.
     Las medidas fijas SOLO aplican a la OG: un SVG no las tiene. */
  logo: BRAND.logoSvg
    ? absolute(link(BRAND.logoSvg))
    : {
        '@type': 'ImageObject',
        url: defaultOgUrl,
        width: OG_DEFAULT_SIZE.width,
        height: OG_DEFAULT_SIZE.height,
      },
  image: defaultOgUrl,
  ...(socialUrls.length > 0 ? { sameAs: socialUrls } : {}),
  ...(contactPoints.length > 0 ? { contactPoint: contactPoints } : {}),
  ...(ADDRESS.countryName
    ? {
        areaServed: {
          '@type': 'Country',
          name: ADDRESS.countryName,
          identifier: ADDRESS.country,
        },
      }
    : {}),
  ...(hasAddress()
    ? {
        address: {
          '@type': 'PostalAddress',
          streetAddress: ADDRESS.streetAddress,
          ...(ADDRESS.city ? { addressLocality: ADDRESS.city } : {}),
          ...(ADDRESS.region ? { addressRegion: ADDRESS.region } : {}),
          ...(ADDRESS.postalCode ? { postalCode: ADDRESS.postalCode } : {}),
          ...(ADDRESS.country ? { addressCountry: ADDRESS.country } : {}),
        },
      }
    : {}),
};

const websiteNode: JsonLdNode = {
  '@type': 'WebSite',
  '@id': SITE_ID,
  url: siteRoot,
  name: BRAND.group,
  inLanguage: ALL_LANGS,
  publisher: { '@id': ORG_ID },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organizationNode, websiteNode],
};

/* -------------------------------------------------------------------------- */
/*  TEMA                                                                      */
/* -------------------------------------------------------------------------- */

/*
 * `data-theme="light"` NO rompe el dark mode de tokens.css: ahí el dark es
 * explícitamente opt-in (`[data-theme='dark']`), sin media query de
 * `prefers-color-scheme` ni toggle en la UI. El sitio es light-only por
 * diseño y fijarlo acá solo lo hace explícito.
 *
 * Lo que SÍ estaba roto era el par de `theme-color` (light + dark)
 * prometiendo un chrome oscuro que la página nunca pinta, y la ausencia de
 * `color-scheme`: con el SO en dark mode el UA renderizaba los inputs, el
 * select y las scrollbars en oscuro sobre fondo claro. Justo el formulario
 * de contacto, que es el mecanismo de conversión de Fase 1.
 * Fix: un solo theme-color + `<meta name="color-scheme" content="light">`.
 */
---

<!doctype html>
<html lang={LOCALE[lang].html} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* hreflang — un link por idioma + x-default (spec: bilingüe ES/EN). */}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

    {
      /* `esPreview` cubre el deploy de GitHub Pages: mientras el sitio no viva
         en su dominio, no se indexa nada. `noindex` sigue siendo la marca por
         página (/corner-quem está despublicada). */
      noindex || esPreview ? (
        <meta name="robots" content="noindex,nofollow" />
      ) : (
        <meta
          name="robots"
          content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
        />
      )
    }

    {
      /* El sitio es light-only (ver comentario del <html>). Declararlo evita
        que el UA pinte inputs, selects y scrollbars en modo oscuro.
        El valor de theme-color espeja --color-bg de tokens.css. */
    }
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f8f9fb" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SEO.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={c.ogImageAlt} />
    {usingDefaultOg && <meta property="og:image:width" content={String(OG_DEFAULT_SIZE.width)} />}
    {usingDefaultOg && <meta property="og:image:height" content={String(OG_DEFAULT_SIZE.height)} />}
    <meta property="og:locale" content={LOCALE[lang].og} />
    {
      ALL_LANGS.filter((l) => l !== lang).map((l) => (
        <meta property="og:locale:alternate" content={LOCALE[l].og} />
      ))
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={c.ogImageAlt} />
    {SEO.twitterHandle && <meta name="twitter:site" content={SEO.twitterHandle} />}

    <!-- Favicons (placeholders — reemplazar cuando llegue logo final).
         Pasan por link() para respetar el base path en preview (GH Pages). -->
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />

    <!-- PWA manifest -->
    <link rel="manifest" href={link('/manifest.webmanifest')} />

    <!--
      Preload Inter Variable latin para que arranque a descargar antes de que
      el CSS procese el @font-face. Elimina el FOIT en above-the-fold.
      Las fuentes son self-hosted (fontsource): no hay preconnect a Google.
    -->
    <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      /* Analytics — solo si ANALYTICS.plausibleDomain está seteado en site.ts.
        Plausible: sin cookies, GDPR-friendly, ~1KB script, no requiere banner. */
    }
    {
      ANALYTICS.plausibleDomain && (
        <script
          is:inline
          defer
          data-domain={ANALYTICS.plausibleDomain}
          src={`${ANALYTICS.plausibleHost}/js/script.outbound-links.js`}
        />
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">{t('a11y.skip')}</a>

    <!-- Scroll progress bar (top of viewport) -->
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>

    <SmoothScrollLenis />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SocialDock />
    <ScrollToTop />

    <script>
      /* ===============================================================
       * Global motion behaviors
       *  1. [data-reveal] → IntersectionObserver activa entrada
       *  2. [data-counter] → cuenta de 0 a target cuando entra al viewport
       *  3. Scroll progress bar arriba del viewport
       *  4. Parallax sutil para [data-parallax]
       * Todo respeta prefers-reduced-motion.
       * =============================================================== */
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* 1) Reveal on scroll — progressive enhancement
       *
       * El CSS por default muestra todo visible. Solo cuando agregamos
       * data-reveal-ready al html, el CSS activa los estados ocultos.
       * Esto garantiza que el contenido NUNCA queda invisible si JS falla.
       *
       * Flow:
       *  1. Marca html como reveal-ready → el CSS oculta elementos data-reveal
       *  2. IntersectionObserver con rootMargin generoso (200px preload)
       *  3. Safety net en scroll + hashchange + setTimeout 1.5s flushPassed
       */
      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (revealEls.length > 0 && !reduceMotion && 'IntersectionObserver' in window) {
        /* Activar modo reveal (esconder elementos para animarlos al entrar) */
        document.documentElement.setAttribute('data-reveal-ready', '');

        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).dataset.revealed = '';
                obs.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px 200px 0px', threshold: 0 },
        );
        revealEls.forEach((el) => obs.observe(el));

        /* Safety net: si el usuario teletransporta vía anchor o scrollea
         * muy rápido, fuerza reveal de cualquier elemento ya pasado. */
        const flushPassed = (): void => {
          revealEls.forEach((el) => {
            if (el.dataset.revealed === undefined) {
              const r = el.getBoundingClientRect();
              if (r.bottom < 0 || r.top < window.innerHeight) {
                if (r.bottom < 0) {
                  /* Ya pasó por encima — reveal instantáneo, sin transición
                   * (evita el blank de 800-1200ms en navegación por anchor). */
                  (el as HTMLElement).style.transition = 'none';
                  el.dataset.revealed = '';
                  requestAnimationFrame(() => {
                    (el as HTMLElement).style.transition = '';
                  });
                } else {
                  el.dataset.revealed = '';
                }
                obs.unobserve(el);
              }
            }
          });
        };
        window.addEventListener('scroll', flushPassed, { passive: true });
        window.addEventListener('hashchange', () => setTimeout(flushPassed, 100));
        setTimeout(flushPassed, 1500);
      }
      /* Si no hay IntersectionObserver o reduce-motion, no activamos data-reveal-ready
       * → el CSS deja todo visible por default. Done. */

      /* 2) Number counter */
      const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
      if (counters.length > 0 && !reduceMotion && 'IntersectionObserver' in window) {
        const fmt = (n: number, suffix = ''): string => {
          if (n >= 1_000_000) return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M' + suffix;
          if (n >= 1_000) return (n / 1_000).toFixed(1).replace(/\.0$/, '') + 'K' + suffix;
          return Math.round(n).toString() + suffix;
        };
        const animate = (el: HTMLElement): void => {
          const target = Number(el.dataset.counter ?? '0');
          const suffix = el.dataset.counterSuffix ?? '';
          const duration = Number(el.dataset.counterDuration ?? '1400');
          const start = performance.now();
          const tick = (now: number): void => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3); // ease-out-cubic
            el.textContent = fmt(target * eased, suffix);
            if (t < 1) requestAnimationFrame(tick);
            else el.textContent = fmt(target, suffix);
          };
          requestAnimationFrame(tick);
        };
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                animate(e.target as HTMLElement);
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.3 },
        );
        counters.forEach((el) => obs.observe(el));
      } else {
        counters.forEach((el) => {
          el.textContent = el.dataset.counter ?? '';
        });
      }

      /* 3) Scroll progress bar */
      const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');
      if (progressBar && !reduceMotion) {
        const update = (): void => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const pct = max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0;
          progressBar.style.setProperty('--progress', String(pct));
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update, { passive: true });
      }

      /* 4) Parallax sutil — elementos con data-parallax="0.3" */
      const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');
      if (
        parallaxEls.length > 0 &&
        !reduceMotion &&
        window.matchMedia('(min-width: 768px)').matches
      ) {
        const apply = (): void => {
          const y = window.scrollY;
          parallaxEls.forEach((el) => {
            const speed = Number(el.dataset.parallax ?? '0.3');
            el.style.setProperty('--parallax-y', `${y * speed}px`);
          });
        };
        apply();
        window.addEventListener('scroll', apply, { passive: true });
      }
    </script>

    <style>
      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        /* Por encima de todo el chrome (header sticky, dock de redes, skip-link). */
        z-index: calc(var(--z-toast) + 100);
        pointer-events: none;
        background: transparent;
      }
      .scroll-progress::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, var(--color-brand-500), var(--color-accent-500));
        transform-origin: left center;
        transform: scaleX(calc(var(--progress, 0) / 100));
        transition: transform 80ms linear;
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-progress {
          display: none;
        }
      }
    </style>
  </body>
</html>
