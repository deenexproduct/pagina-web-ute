---
/**
 * "Confían en nosotros" — placeholder de logos de clientes B2B.
 *
 * Reemplaza la sección anterior "Por qué Qüem" (capabilities cards)
 * que era redundante con Hero + ProofStrip + Garantías.
 *
 * Estado: placeholders vacíos. El cliente debe proveer 6-10 logos
 * de cadenas/comercios que compran a Qüem Central. Los logos
 * pueden ir en src/assets/logos-clientes/ y referenciarse desde acá.
 *
 * GATE: pedir al cliente 6-10 logos en SVG o PNG transparente.
 *   - Si solo hay 1-2 testimonios reales, mejor cambiar este componente
 *     por Testimonials.astro (quote + nombre + comercio).
 *   - Si no hay nada, ocultar la sección hasta tener assets.
 */

interface ClientLogo {
  name: string;
  /** Path al logo (SVG/PNG transparente) — vacío = placeholder visual */
  logo?: string;
  /** Categoría del cliente, opcional, para tooltip */
  segment?: string;
}

/* TODO confirmar con cliente — completar con clientes reales */
const clients: ReadonlyArray<ClientLogo> = [
  { name: '', segment: 'Cadena gastronómica' },
  { name: '', segment: 'Cafeterías' },
  { name: '', segment: 'Hotelería' },
  { name: '', segment: 'Catering / eventos' },
  { name: '', segment: 'Supermercado' },
  { name: '', segment: 'Kioscos premium' },
  { name: '', segment: 'Gimnasios' },
  { name: '', segment: 'Universidades' },
];

const isPlaceholder = clients.every((c) => !c.logo);
/* GATE: si NO hay ningún logo real cargado, NO renderizamos la sección.
   Esto evita mostrar 8 cuadrados con líneas punteadas (sensación de
   "sitio en construcción"). Cuando el cliente provea logos y se setee
   alguno en `clients[].logo`, la sección reaparece automáticamente. */
const hideSection = isPlaceholder;
---

{
  !hideSection && (
    <section class="trust section-y" aria-labelledby="trust-title">
      <div class="container-content trust__inner">
        <header class="trust__head" data-reveal>
          <p class="eyebrow" data-reveal style="--reveal-y: 12px;">
            Confianza
          </p>
          <h2 id="trust-title" class="trust__title" data-reveal style="--reveal-delay: 100ms;">
            Compran en Qüem.
          </h2>
          <p class="trust__lede" data-reveal style="--reveal-delay: 200ms;">
            Cadenas gastronómicas, hoteles, cafeterías y comercios que abastecen su operación con
            nuestro catálogo.
          </p>
        </header>

        <ul class="trust__grid" role="list" data-reveal-stagger>
          {clients.map((c, idx) => (
            <li
              class:list={['trust-logo', isPlaceholder && 'trust-logo--placeholder']}
              data-reveal
              style={`--reveal-delay: ${100 + idx * 60}ms;`}
              title={c.segment}
            >
              {c.logo ? (
                <img
                  src={c.logo}
                  alt={c.name}
                  loading="lazy"
                  decoding="async"
                  width="160"
                  height="60"
                />
              ) : (
                <span class="trust-logo__placeholder" aria-hidden="true">
                  <svg viewBox="0 0 60 24" fill="none" aria-hidden="true">
                    <rect
                      x="2"
                      y="2"
                      width="56"
                      height="20"
                      rx="3"
                      stroke="currentColor"
                      stroke-width="1"
                      stroke-dasharray="3 3"
                      opacity="0.4"
                    />
                    <circle cx="10" cy="12" r="2" fill="currentColor" opacity="0.25" />
                    <rect
                      x="18"
                      y="9"
                      width="16"
                      height="2"
                      rx="1"
                      fill="currentColor"
                      opacity="0.25"
                    />
                    <rect
                      x="18"
                      y="13"
                      width="10"
                      height="2"
                      rx="1"
                      fill="currentColor"
                      opacity="0.25"
                    />
                  </svg>
                  <span class="trust-logo__segment">{c.segment}</span>
                </span>
              )}
            </li>
          ))}
        </ul>

        {isPlaceholder && (
          <p class="trust__fineprint" data-reveal style="--reveal-delay: 600ms;">
            <span aria-hidden="true">ⓘ</span>
            Logos de clientes en alta resolución se incorporan con cada autorización comercial.
            Lista completa al alta como cliente.
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  .trust {
    position: relative;
    background:
      radial-gradient(
        70% 70% at 50% 0%,
        oklch(from var(--color-brand-500) l c h / 0.04) 0%,
        transparent 60%
      ),
      var(--color-bg);
    overflow: hidden;
    isolation: isolate;
  }

  .trust__inner {
    display: grid;
    gap: var(--space-6);
  }
  .trust__head {
    display: grid;
    gap: var(--space-3);
    max-width: 56ch;
  }
  .trust__title {
    font-size: var(--font-size-3xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
    line-height: 1.02;
    color: var(--color-text-primary);
    max-width: 18ch;
  }
  .trust__lede {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
  }

  /* ----- Grid de logos ----- */
  .trust__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-block-start: var(--space-3);
  }
  @media (min-width: 540px) {
    .trust__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 880px) {
    .trust__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trust-logo {
    aspect-ratio: 5 / 2;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    display: grid;
    place-items: center;
    padding: var(--space-3);
    transition:
      border-color var(--dur-fast),
      background var(--dur-fast);
  }
  .trust-logo:hover {
    border-color: var(--color-brand-300);
    background: var(--color-brand-50);
  }
  .trust-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.85;
    transition:
      filter var(--dur-fast),
      opacity var(--dur-fast);
  }
  .trust-logo:hover img {
    filter: grayscale(0);
    opacity: 1;
  }

  /* ----- Placeholder mode (sin logos reales todavía) ----- */
  .trust-logo--placeholder {
    background: var(--color-surface-subtle);
  }
  .trust-logo--placeholder:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-elevated);
  }
  .trust-logo__placeholder {
    display: grid;
    place-items: center;
    gap: 0.4rem;
    color: var(--color-text-muted);
  }
  .trust-logo__placeholder svg {
    width: 60%;
    max-width: 60px;
    height: auto;
  }
  .trust-logo__segment {
    font-size: var(--font-size-2xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.2;
  }

  /* ----- Fineprint ----- */
  .trust__fineprint {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    line-height: var(--leading-snug);
    max-width: 60ch;
    margin-block-start: var(--space-3);
  }
  .trust__fineprint span {
    color: var(--color-text-brand);
    flex-shrink: 0;
    margin-block-start: 0.05rem;
  }
</style>
