---
/**
 * Qué es QUEM Central — v2
 *
 * Decisión comercial:
 * El brief original define el objetivo de esta sección como explicar
 * el cambio conceptual "no es un proveedor, es un ecosistema". Esta
 * v2 lleva ese contraste al title — pero suavizado para tono B2B
 * institucional ("Más que un proveedor" en vez de "No vendemos…").
 *
 * Estructura limpia:
 *  - Eyebrow chico
 *  - Title declarativo en 2 líneas con contraste positivo
 *  - 1 subtitle de una sola oración
 *  - 4 pilares visuales con icon + título + frase corta
 *  - Footer mini-stat sin inventar números (5 canales = los listados
 *    en el brief: B2B, retail, franquicias, corners, tecnología/app)
 *
 * Reduce de ~120 palabras a ~55. Elimina 3 párrafos densos + 5
 * puntos verbosos que decían la misma idea distinta vez.
 */

const pilares = [
  {
    icon: 'product',
    title: 'Producto',
    desc: '11 categorías curadas. Stock disponible, sin sobrestock ni faltantes.',
    accent: false,
  },
  {
    icon: 'logistics',
    title: 'Logística',
    desc: 'Cadena de frío ininterrumpida. Del depósito a tu puerta, sin intermediarios.',
    accent: true,
  },
  {
    icon: 'network',
    title: 'Cobertura',
    desc: 'AMBA y PBA con flota propia. Sin tercerizar la última milla.',
    accent: false,
  },
  {
    icon: 'tech',
    title: 'Tecnología',
    desc: 'Pedido confirmado en minutos. Sin llamadas, sin papeles, sin Excel.',
    accent: false,
  },
] as const;
---

<section id="quem-central" class="qe section-y" aria-labelledby="qe-title">
  <div class="qe__bg" aria-hidden="true"></div>

  <div class="container-content qe__inner">
    <!-- Header centrado -->
    <header class="qe__head">
      <p class="qe__eyebrow" data-reveal style="--reveal-y: 12px;">
        <span class="qe__eyebrow-mark" aria-hidden="true"></span>
        Qué hacemos
      </p>

      <h2 id="qe-title" class="qe__title">
        <span
          class="qe__title-line qe__title-line--soft"
          data-reveal
          style="--reveal-delay: 100ms;"
        >
          Más que un proveedor.
        </span>
        <span
          class="qe__title-line qe__title-line--strong"
          data-reveal
          style="--reveal-delay: 250ms;"
        >
          Un ecosistema <em>integrado</em>.
        </span>
      </h2>

      <p class="qe__subtitle" data-reveal style="--reveal-delay: 400ms;">
        Operamos abastecimiento, distribución y desarrollo comercial de alimentos congelados.
      </p>
    </header>

    <!-- 4 pilares -->
    <ul class="qe__pillars" data-reveal-stagger role="list">
      {
        pilares.map((p) => (
          <li class:list={['qe-pillar', p.accent && 'qe-pillar--accent']} data-reveal>
            <div class="qe-pillar__icon" aria-hidden="true">
              {p.icon === 'product' && (
                <svg viewBox="0 0 32 32" fill="none">
                  <path
                    d="M16 4 4 10v12l12 6 12-6V10L16 4Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                  <path
                    d="m4 10 12 6 12-6M16 16v12M10 7l12 6"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
              {p.icon === 'logistics' && (
                <svg viewBox="0 0 32 32" fill="none">
                  <path
                    d="M3 22V8h18v14M21 12h5l4 5v5h-9"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                  <circle cx="9" cy="24" r="2.6" stroke="currentColor" stroke-width="1.6" />
                  <circle cx="24" cy="24" r="2.6" stroke="currentColor" stroke-width="1.6" />
                </svg>
              )}
              {p.icon === 'network' && (
                <svg viewBox="0 0 32 32" fill="none">
                  <circle cx="16" cy="16" r="3.5" stroke="currentColor" stroke-width="1.6" />
                  <circle cx="5" cy="6" r="2.5" stroke="currentColor" stroke-width="1.6" />
                  <circle cx="27" cy="6" r="2.5" stroke="currentColor" stroke-width="1.6" />
                  <circle cx="5" cy="26" r="2.5" stroke="currentColor" stroke-width="1.6" />
                  <circle cx="27" cy="26" r="2.5" stroke="currentColor" stroke-width="1.6" />
                  <path
                    d="m7.5 8 5 5M24.5 8l-5 5M7.5 24l5-5M24.5 24l-5-5"
                    stroke="currentColor"
                    stroke-width="1.4"
                  />
                </svg>
              )}
              {p.icon === 'tech' && (
                <svg viewBox="0 0 32 32" fill="none">
                  <rect
                    x="10"
                    y="3"
                    width="12"
                    height="22"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="1.6"
                  />
                  <path
                    d="M14 7h4"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />
                  <circle cx="16" cy="21" r="1" fill="currentColor" />
                  <path
                    d="M22 12h4M22 16h6M22 20h4"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    opacity="0.4"
                  />
                </svg>
              )}
            </div>

            <h3 class="qe-pillar__title">{p.title}</h3>
            <p class="qe-pillar__desc">{p.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ===== Shell =================================================== */
  .qe {
    position: relative;
    background: var(--color-bg);
    overflow: hidden;
    isolation: isolate;
  }
  .qe__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .qe__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, oklch(42% 0.19 252 / 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 80%);
  }
  .qe__bg::after {
    content: '';
    position: absolute;
    top: -30%;
    right: -10%;
    width: 50%;
    height: 80%;
    background: radial-gradient(circle, oklch(58% 0.155 254 / 0.1) 0%, transparent 60%);
    filter: blur(60px);
  }

  .qe__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }

  /* ===== Header centrado ========================================= */
  .qe__head {
    display: grid;
    gap: var(--space-3);
    text-align: center;
    justify-items: center;
    max-width: 56ch;
    margin-inline: auto;
  }

  .qe__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.85rem 0.4rem 0.65rem;
    background: oklch(from var(--color-brand-500) l c h / 0.07);
    color: var(--color-text-brand);
    border: 1px solid oklch(from var(--color-brand-500) l c h / 0.15);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-bold);
  }
  .qe__eyebrow-mark {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-500);
  }

  .qe__title {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: var(--weight-extrabold);
    margin-block-start: var(--space-3);
  }
  .qe__title-line {
    display: block;
  }
  .qe__title-line--soft {
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
    font-size: 0.7em;
    letter-spacing: -0.025em;
    margin-block-end: 0.25rem;
  }
  .qe__title-line--strong {
    color: var(--color-text-primary);
  }
  .qe__title-line--strong em {
    font-style: normal;
    background: var(--gradient-text-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .qe__subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--leading-snug);
    max-width: 44ch;
    margin-block-start: var(--space-2);
  }

  /* ===== Pilares ================================================= */
  .qe__pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }
  @media (max-width: 639px) {
    .qe__pillars {
      margin-block-start: 0;
    }
  }
  @media (min-width: 640px) {
    .qe__pillars {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .qe__pillars {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-3);
    }
  }

  .qe-pillar {
    position: relative;
    padding: var(--space-5) var(--space-5) var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    display: grid;
    gap: var(--space-3);
    align-content: start;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-normal) var(--ease-out-expo);
  }
  .qe-pillar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      80% 60% at 50% 0%,
      oklch(from var(--color-brand-500) l c h / 0.06) 0%,
      transparent 60%
    );
    opacity: 0;
    transition: opacity var(--dur-normal);
  }
  .qe-pillar:hover {
    transform: translateY(-4px);
    border-color: var(--color-brand-300);
    box-shadow: var(--shadow-card-hover);
  }
  .qe-pillar:hover::before {
    opacity: 1;
  }

  /* Pillar accent (Logística) — light theme con tint brand sutil + border destacado */
  .qe-pillar--accent {
    background:
      radial-gradient(
        60% 80% at 100% 0%,
        oklch(from var(--color-brand-500) l c h / 0.08) 0%,
        transparent 60%
      ),
      linear-gradient(180deg, var(--color-brand-50) 0%, var(--color-bg-elevated) 70%);
    border-color: oklch(from var(--color-brand-500) l c h / 0.3);
  }
  .qe-pillar--accent::before {
    background: radial-gradient(
      80% 60% at 50% 0%,
      oklch(from var(--color-brand-500) l c h / 0.1) 0%,
      transparent 60%
    );
    opacity: 0.6;
  }
  .qe-pillar--accent:hover {
    border-color: var(--color-brand-400);
    box-shadow: var(--shadow-card-hover);
  }

  .qe-pillar__icon {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.7rem;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--color-brand-50), var(--color-bg));
    color: var(--color-brand-600);
    border: 1px solid var(--color-brand-100);
    transition: transform var(--dur-fast) var(--ease-standard);
  }
  .qe-pillar:hover .qe-pillar__icon {
    transform: scale(1.08) rotate(-2deg);
  }
  .qe-pillar__icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .qe-pillar--accent .qe-pillar__icon {
    background: linear-gradient(135deg, var(--color-brand-100), var(--color-brand-50));
    color: var(--color-brand-700);
    border-color: oklch(from var(--color-brand-500) l c h / 0.25);
  }

  .qe-pillar__title {
    font-size: var(--font-size-lg);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }
  .qe-pillar--accent .qe-pillar__title {
    color: var(--color-text-primary);
  }

  .qe-pillar__desc {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--leading-relaxed);
    max-width: 28ch;
  }
  .qe-pillar--accent .qe-pillar__desc {
    color: var(--color-text-secondary);
  }
</style>
